---
import BaseLayout from "../../../../../layouts/BaseLayout.astro";
import WikiLayout from "../../../../../layouts/WikiLayout.astro";
import RoleGuide from "../../../../../components/RoleGuide.astro";
const base = import.meta.env.BASE_URL;

const salaries = [
  { name: "InGameJob", url: "https://ingamejob.com/en/salaries" },
  { name: "Glassdoor", url: "https://www.glassdoor.com/Salaries/rigging-artist-salary-SRCH_KO0,14.htm" },
  { name: "Salary.com", url: "https://www.salary.com/research/salary/hiring/rigging-artist-salary" },
  { name: "ZipRecruiter", url: "https://www.ziprecruiter.com/Jobs/Rigging-Animator" }
];

const responsibilities = [
  "Build skeletal rigs for characters and objects.",
  "Skin and weight meshes for smooth deformations.",
  "Implement advanced deformation systems (muscle, cloth, hair).",
  "Design intuitive control systems for animators.",
  "Optimize rigs for efficient performance in software/engines.",
  "Collaborate with animators and designers on character movement goals.",
  "Contribute to character development and animation pipeline.",
  "Ensure rigs support desired animation styles and expressions."
];

const resources = [
  { name: "CGDive's YouTube Channel (free Blender rigging tutorials, including rigging for game engines)", url: "https://www.youtube.com/@CGDive" },
  { name: "Chris Zurbrigg's Python for Maya and Rigging Tutorials", url: "https://zurbrigg.com/" },
  { name: "Control Rig in Unreal Engine (official docs)", url: "https://dev.epicgames.com/documentation/en-us/unreal-engine/control-rig-in-unreal-engine" },
  { name: "Introduction to Rigging by The Animation Course", url: "https://www.theanimcourse.com/store/p/recorded-seminars-rigging" },
  { name: "Rigging Dojo: Teaching the Art and Science of Character Rigging", url: "https://www.riggingdojo.com/" }
];

const books = [
  { name: "Constructive Anatomy by George B. Bridgman", url: "https://www.amazon.com/Constructive-Anatomy-Dover-Artists/dp/0486211045/ref=sr_1_1" },
  { name: "Anatomy for the Artist by Sarah Simblet", url: "https://www.amazon.com/Anatomy-Artist-Sarah-Simblet/dp/1465494227/ref=sr_1_8" },
  { name: "A Complete Guide to Character Rigging for Games Using Blender by Armin Halac", url: "https://www.amazon.com/Complete-Guide-Character-Rigging-Blender/dp/1032203005/ref=sr_1_7" },
  { name: "The Art of Rigging by Kiaran Ritchie, Jake Callery and Karim Biri", url: "https://www.amazon.com/Rigging-Definitive-Character-Technical-Direction/dp/0976800306/ref=sr_1_1" },
  { name: "3D Character Development Workshop: Rigging Fundamentals for Artists and Animators by Erik Van Horn", url: "https://www.amazon.com/Character-Development-Workshop-Fundamentals-Animators-ebook/dp/B07CSGYSRP/ref=sr_1_4" }
];

const tools = [
  "Game Engines",
  "Maya",
  "Blender",
  "Rigify",
  "Python",
  "Unreal Engine Control Rig",
  "Advanced Skeleton",
  "mGear",
  "MotionBuilder"
];

const sidebarRoles = [
  { name: "Character Animator", slug: "character-animator", current: false },
  { name: "Cinematic Animator", slug: "cinematic-animator", current: false },
  { name: "Motion Capture Artist", slug: "motion-capture-artist", current: false },
  { name: "Technical Animator", slug: "technical-animator", current: false },
  { name: "UX/UI Animator", slug: "ux-ui-animator", current: false },
  { name: "VFX Animator", slug: "vfx-animator", current: false },
  { name: "Rigging Artist", slug: "rigging-artist", current: true }
];
---

<BaseLayout title="How to Become a Rigging Artist: Skills, Portfolio & Tools" description="How to become a Rigging Artist in the game industry: step-by-step path, key skills, portfolio tips, salary resources, the tools to learn, and FAQs." activeNav="career-guide">
  <WikiLayout title="Rigging Artist" activeNav="career-guide" activeSidebar="roles">
    <div class="career-layout">
      <aside class="career-sidebar">
        <h3>Animation Roles</h3>
        {sidebarRoles.map((r) => (
          r.current ? (
            <div class="card" style="padding: 0.75rem; margin-bottom: 0.5rem; border-left: 3px solid var(--color-pink);">
              <strong style="font-size: 0.9rem; color: var(--color-pink);">{r.name}</strong>
            </div>
          ) : (
            <a href={`${base}career-guide/roles/animation/${r.slug}/`} class="card" style="padding: 0.75rem; margin-bottom: 0.5rem; text-decoration: none; display: block;">
              <strong style="font-size: 0.9rem;">{r.name}</strong>
            </a>
          )
        ))}
        <div style="margin-top: 1rem;">
          <a href={`${base}career-guide/roles/animation/`} class="btn btn-gold" style="font-size: 0.8rem; padding: 0.4rem 0.8rem;">&larr; Animation</a>
        </div>
      </aside>

      <div class="career-main">
        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>About this Role</h2>
          <p>Rigging artists are the puppeteers of the digital world, crafting the internal structures that grant characters fluid, believable movement. They weave intricate webs of bones, joints, and constraints, mimicking the human skeleton and enabling animators to breathe life into these digital creations. They're artists who understand anatomy, physics, and animation principles, ensuring rigs are efficient and performant. Collaborating with animators and designers, they ensure characters move with grace and expressiveness, playing a crucial role in bringing stories to life through animation.</p>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Salary Resources</h2>
          <div style="display: flex; flex-wrap: wrap; gap: 0.75rem;">
            {salaries.map((s) => (
              <a href={s.url} target="_blank" rel="noopener noreferrer" class="btn btn-blue" style="font-size: 0.85rem;">
                {s.name} &rarr;
              </a>
            ))}
          </div>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Key Responsibilities</h2>
          <ul>
            {responsibilities.map((r) => (
              <li>{r}</li>
            ))}
          </ul>
        </div>

        <RoleGuide slug="rigging-artist" part="guide" />

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Learning Resources</h2>
          <ul>
            {resources.map((r) => (
              <li><a href={r.url} target="_blank" rel="noopener noreferrer">{r.name}</a></li>
            ))}
          </ul>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Recommended Books</h2>
          <ul>
            {books.map((b) => (
              <li><a href={b.url} target="_blank" rel="noopener noreferrer">{b.name}</a></li>
            ))}
          </ul>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Tools to Learn</h2>
          <div class="callout callout-info">
            <p>You don&#39;t need to learn all of these — they are some of the more common tools for this role.</p>
          </div>
          <div style="display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.75rem;">
            {tools.map((t) => (
              <span style="background: var(--color-bg); border: 1px solid var(--color-dark); border-radius: 4px; padding: 0.3rem 0.6rem; font-size: 0.85rem;">{t}</span>
            ))}
          </div>
        </div>

        <RoleGuide slug="rigging-artist" part="faq" />
      </div>

      <aside class="career-sidebar">
        <h3>Quick Links</h3>
        <div class="card" style="padding: 1rem; margin-bottom: 0.75rem;">
          <strong>📋 Job Boards</strong>
          <p style="font-size: 0.85rem; margin-top: 0.35rem;">
            <a href={`${base}career-guide/job-boards/`}>Browse job boards &rarr;</a>
          </p>
        </div>
        <div class="card" style="padding: 1rem; margin-bottom: 0.75rem;">
          <strong>📚 Resources</strong>
          <p style="font-size: 0.85rem; margin-top: 0.35rem;">
            <a href={`${base}career-guide/resources/`}>Career resources &rarr;</a>
          </p>
        </div>
        <div class="card" style="padding: 1rem;">
          <strong>🎯 All Roles</strong>
          <p style="font-size: 0.85rem; margin-top: 0.35rem;">
            <a href={`${base}career-guide/roles/`}>View all disciplines &rarr;</a>
          </p>
        </div>
      </aside>
    </div>
  </WikiLayout>
</BaseLayout>