---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import WikiLayout from "../../../../layouts/WikiLayout.astro";
const base = import.meta.env.BASE_URL;

const roles = [
  { name: "Character Animator", description: "Creates movement and personality for game characters through keyframe or motion-capture animation." },
  { name: "Technical Animator", description: "Bridges art and engineering — builds rigs, animation systems, and tools for the animation pipeline." },
  { name: "Cinematic Animator", description: "Produces in-game cutscenes and scripted sequences with dramatic camera work and character performances." },
  { name: "Rigging Artist", description: "Builds the skeletal and control systems that allow 3D models to be animated." },
];
---

<BaseLayout title="Animation Roles" activeNav="career-guide">
  <WikiLayout title="Animation Roles" activeNav="career-guide" activeSidebar="roles">
    <p>
      Animation brings game worlds and characters to life. From subtle idle
      loops to dramatic cinematic sequences, animators are essential to the
      player experience.
    </p>

    <div class="career-layout">
      <aside class="career-sidebar">
        <h3>Animation Roles</h3>
        {roles.map((r) => (
          <div class="card" style="padding: 0.75rem; margin-bottom: 0.5rem;">
            <strong style="font-size: 0.9rem;">{r.name}</strong>
          </div>
        ))}
        <div style="margin-top: 1rem;">
          <a href={`${base}career-guide/roles/`} class="btn btn-gold" style="font-size: 0.8rem; padding: 0.4rem 0.8rem;">← All Roles</a>
        </div>
      </aside>

      <div class="career-main">
        {roles.map((role) => (
          <div class="card" style="margin-bottom: 1rem;">
            <h3>{role.name}</h3>
            <p>{role.description}</p>
          </div>
        ))}
      </div>

      <aside class="career-sidebar">
        <h3>Related</h3>
        <div class="card" style="padding: 1rem; margin-bottom: 0.75rem;">
          <p style="font-size: 0.85rem;">
            <a href={`${base}career-guide/roles/art/`}>Art Roles →</a>
          </p>
        </div>
        <div class="card" style="padding: 1rem;">
          <p style="font-size: 0.85rem;">
            <a href={`${base}career-guide/job-boards/`}>Job Boards →</a>
          </p>
        </div>
      </aside>
    </div>
  </WikiLayout>
</BaseLayout>
