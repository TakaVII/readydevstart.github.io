---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import WikiLayout from "../../../../layouts/WikiLayout.astro";
const base = import.meta.env.BASE_URL;

const roles = [
  { name: "Character Animator", slug: "character-animator", description: "Character animators are artists who create realistic and expressive movements for characters in video games." },
  { name: "Cinematic Animator", slug: "cinematic-animator", description: "Cinematic animators are specialized animators who create high-fidelity, narrative-driven animation sequences for video games." },
  { name: "Motion Capture Artist", slug: "motion-capture-artist", description: "Motion Capture Artists are the technical wizards behind the scenes, capturing the nuances of human movement and translating them into the digital world." },
  { name: "Technical Animator", slug: "technical-animator", description: "Technical animators ensure that characters move realistically and the game runs smoothly, bridging the gap between artistic vision and technological limitations." },
  { name: "UX/UI Animator", slug: "ux-ui-animator", description: "UX/UI animators are the architects of interactivity in games." },
  { name: "VFX Animator", slug: "vfx-animator", description: "VFX animators create the real-time effects in games, such as spell impacts, explosions, fire, and weather." },
  { name: "Rigging Artist", slug: "rigging-artist", description: "Rigging artists are the puppeteers of the digital world, crafting the internal structures that grant characters fluid, believable movement." }
];

const skills = [
  "2D Art",
  "3D Modeling",
  "Animation",
  "Art Composition",
  "Art Simulations",
  "Color Theory",
  "Concept Art",
  "Content Creation",
  "Creative Process Development",
  "Creativity",
  "Cross-team Communication",
  "Design Principles",
  "Game Engine Integration",
  "Graphic Design",
  "Graphic Illustrations",
  "Hand-drawn Animation",
  "Hand-drawn Art",
  "Illustration",
  "Lighting",
  "Offline Rendering",
  "Performance Capture",
  "Pixel Animation",
  "Pixel Art",
  "Prototyping",
  "Rigging",
  "Storyboarding",
  "Texturing",
  "Vector Animation"
];

const courses = [
  { name: "12 Principles of Animation (free video series) by Alan Becker", url: "https://www.youtube.com/watch?v=uDqjIdI4bF4" },
  { name: "The 11 Second Club (free monthly animation contest and critique community)", url: "https://www.11secondclub.com/" },
  { name: "Game Anim: Jonathan Cooper's Game Animation Site and Book", url: "https://www.gameanim.com/book/" },
  { name: "Real Time VFX Forum (free community for game effects artists)", url: "https://realtimevfx.com/" },
  { name: "ScreenSkills’ slides “What jobs are needed to make an animation”", url: "https://www.screenskills.com/media/3359/animation-slides-240120.pdf" },
  { name: "Fundamentals of Animation Course by Aaron Blaise", url: "https://creatureartteacher.com/product/fundamentals-of-animation/" },
  { name: "Creature of Art’s Animation Tutorials", url: "https://creatureartteacher.com/product-category/tutorials-lessons/animation-tutorials/" },
  { name: "3D Animation & VFX Course by Vancouver Film School", url: "https://vfs.edu/programs/3D-animation-vfx" },
  { name: "CGSpectrum Courses", url: "https://www.cgspectrum.com/" },
  { name: "Animation/VFX Game Industry Job Postings by Chris Mayne", url: "https://docs.google.com/spreadsheets/d/1eR2oAXOuflr8CZeGoz3JTrsgNj3KuefbdXJOmNtjEVM/edit#gid=0" },
  { name: "Into Games’ Junior Animator Database", url: "https://entrylevel.games/database/junior-animator" }
];
---

<BaseLayout title="Game Animation Jobs: Animator Roles & Career Paths" description="Explore game animation careers, including character, cinematic, technical, VFX, and UX/UI animators, rigging and mocap artists, plus skills and resources." activeNav="career-guide">
  <WikiLayout title="Animation Roles" activeNav="career-guide" activeSidebar="roles">
    <p>An Animator in the gaming industry specializes in creating lifelike movements, expressions, and actions for characters, objects, and environments in games. They use various software and tools to bring game characters to life, ensuring believable performances, realistic physics, and captivating storytelling. Animators work closely with other game development professionals, such as concept artists and programmers, to create visually stunning and immersive experiences for players.</p>

    <div class="career-layout">
      <aside class="career-sidebar">
        <h3>Animation Roles</h3>
        {roles.map((r) => (
          <a href={`${base}career-guide/roles/animation/${r.slug}/`} class="card" style="padding: 0.75rem; margin-bottom: 0.5rem; text-decoration: none; display: block;">
            <strong style="font-size: 0.9rem;">{r.name}</strong>
          </a>
        ))}
        <div style="margin-top: 1rem;">
          <a href={`${base}career-guide/roles/`} class="btn btn-gold" style="font-size: 0.8rem; padding: 0.4rem 0.8rem;">&larr; All Roles</a>
        </div>
      </aside>

      <div class="career-main">
        <div class="card-grid" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
          {roles.map((role) => (
            <a href={`${base}career-guide/roles/animation/${role.slug}/`} class="card" style="text-decoration:none;">
              <h3>{role.name}</h3>
              <p>{role.description}</p>
              <span class="btn btn-pink" style="font-size: 0.8rem; padding: 0.3rem 0.6rem; margin-top: 0.5rem; display: inline-block;">View Role &rarr;</span>
            </a>
          ))}
        </div>

        <div class="card" style="margin-top: 1.5rem;">
          <h3>Skills Involved</h3>
          <div style="display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.75rem;">
            {skills.map((s) => (
              <span style="background: var(--color-bg); border: 1px solid var(--color-dark); border-radius: 4px; padding: 0.3rem 0.6rem; font-size: 0.85rem;">{s}</span>
            ))}
          </div>
        </div>

        <div class="card" style="margin-top: 1.5rem;">
          <h3>Courses &amp; Resources</h3>
          <ul>
            {courses.map((c) => (
              <li><a href={c.url} target="_blank" rel="noopener noreferrer">{c.name}</a></li>
            ))}
          </ul>
        </div>
      </div>

      <aside class="career-sidebar">
        <h3>Related</h3>
        <div class="card" style="padding: 1rem; margin-bottom: 0.75rem;">
          <p style="font-size: 0.85rem;">
            <a href={`${base}career-guide/roles/qa/`}>🔍 Quality Assurance Roles &rarr;</a>
          </p>
        </div>
        <div class="card" style="padding: 1rem; margin-bottom: 0.75rem;">
          <p style="font-size: 0.85rem;">
            <a href={`${base}career-guide/roles/art/`}>🎨 Art Roles &rarr;</a>
          </p>
        </div>
        <div class="card" style="padding: 1rem;">
          <p style="font-size: 0.85rem;">
            <a href={`${base}career-guide/job-boards/`}>Job Boards &rarr;</a>
          </p>
        </div>
      </aside>
    </div>
  </WikiLayout>
</BaseLayout>