---
import BaseLayout from "../../../../../layouts/BaseLayout.astro";
import WikiLayout from "../../../../../layouts/WikiLayout.astro";
const base = import.meta.env.BASE_URL;

const salaries = [
  { name: "InGameJob", url: "https://ingamejob.com/en/salaries" },
  { name: "Glassdoor", url: "https://www.glassdoor.com/Salaries/cinematic-animator-salary-SRCH_KO0,18.htm" },
  { name: "Salary.com", url: "https://www.salary.com/research/salary/hiring/cinematic-animator-salary" },
  { name: "ZipRecruiter", url: "https://www.ziprecruiter.com/Salaries/Cinematic-Animator-Salary" }
];

const responsibilities = [
  "Interpreting game scripts and storyboards.",
  "Creating high-fidelity character animations.",
  "Collaborating with directors and voice actors.",
  "Utilizing cinematic techniques like framing, pacing, and editing to enhance storytelling and evoke emotional responses.",
  "Balancing visual fidelity with performance constraints to ensure cinematics run smoothly within the game.",
  "Creating lip-syncing animations.",
  "Understanding character bone structure and weight distribution to achieve believable movement.",
  "Fine-tuning details and ensuring seamless transitions between shots."
];

const resources = [
  { name: "Science of Character Animation course by Markus Magnusson (Motionmarkus)", url: "https://motiondesign.school/courses/science-of-character-animation-by-markus-magnusson/" },
  { name: "Creative Cloud Character Animator Tutorials", url: "https://creativecloud.adobe.com/en-AU/learn/app/adobe-character-animator" },
  { name: "An Introduction to 3D Character Animation Blog Post by Devoted CG", url: "https://devotedcg.com/an-introduction-to-3d-character-animation" },
  { name: "Character Animation Bootcamp by School of Motion", url: "https://www.schoolofmotion.com/courses/character-animation-bootcamp" },
  { name: "Character Animation Courses in Udemy", url: "https://www.udemy.com/topic/character-animation/" },
  { name: "Character Animation Courses in Domestika", url: "https://www.domestika.org/en/courses/area/80-character-animation" },
  { name: "Character Animation Courses in SkillShare", url: "https://www.skillshare.com/en/browse/character-animation" },
  { name: "Animation Mentor Courses", url: "https://www.animationmentor.com/" }
];

const books = [
  { name: "Film Directing Shot by Shot by Steven D. Katz", url: "https://www.amazon.com/Film-Directing-Anniversary-Visualizing-Concept/dp/1615932976/ref=sr_1_1" },
  { name: "Illusion of Life: Disney Animation by Frank Thomas and Ollie Johnston", url: "https://www.amazon.com/Illusion-Life-Disney-Animation/dp/0786860707/ref=sr_1_1" },
  { name: "Story: Substance, Structure, Style, and the Principles of Screenwriting by Robert McKee", url: "https://www.amazon.com/Story-Robert-McKee-audiobook/dp/B000E6TVNW/ref=sr_1_1" },
  { name: "Resonate: Present Visual Stories that Transform Audiences by Nancy Duarte", url: "https://www.amazon.com/-/es/Nancy-Duarte/dp/B071RJVLS7" },
  { name: "Creating Characters with Personality by Tom Bancroft", url: "https://www.amazon.com/Creating-Characters-Personality-Animation-Graphic/dp/0823023494/ref=sr_1_1" },
  { name: "Story Structure and Development: A Guide for Animators, VFX Artists, Game Designers, and Virtual Reality by Craig Caldwell", url: "https://www.routledge.com/Story-Structure-and-Development-A-Guide-for-Animators-VFX-Artists-Game/Caldwell/p/book/9781498781732" }
];

const tools = [
  "Game Engines",
  "Maya",
  "Blender",
  "Adobe After Effects",
  "Marmoset Toolbag",
  "Houdini",
  "MotionBuilder",
  "Adobe Animate",
  "Faceware"
];

const sidebarRoles = [
  { name: "Character Animator", slug: "character-animator", current: false },
  { name: "Cinematic Animator", slug: "cinematic-animator", current: true },
  { name: "Motion Capture Artist", slug: "motion-capture-artist", current: false },
  { name: "Technical Animator", slug: "technical-animator", current: false },
  { name: "UX/UI Animator", slug: "ux-ui-animator", current: false },
  { name: "VFX Animator", slug: "vfx-animator", current: false },
  { name: "Rigging Artist", slug: "rigging-artist", current: false }
];
---

<BaseLayout title="Cinematic Animator" activeNav="career-guide">
  <WikiLayout title="Cinematic Animator" activeNav="career-guide" activeSidebar="roles">
    <div class="career-layout">
      <aside class="career-sidebar">
        <h3>Animation Roles</h3>
        {sidebarRoles.map((r) => (
          r.current ? (
            <div class="card" style="padding: 0.75rem; margin-bottom: 0.5rem; border-left: 3px solid var(--clr-pink);">
              <strong style="font-size: 0.9rem; color: var(--clr-pink);">{r.name}</strong>
            </div>
          ) : (
            <a href={`${base}career-guide/roles/animation/${r.slug}/`} class="card" style="padding: 0.75rem; margin-bottom: 0.5rem; text-decoration: none; display: block;">
              <strong style="font-size: 0.9rem;">{r.name}</strong>
            </a>
          )
        ))}
        <div style="margin-top: 1rem;">
          <a href={`${base}career-guide/roles/animation/`} class="btn btn-gold" style="font-size: 0.8rem; padding: 0.4rem 0.8rem;">&larr; Animation</a>
        </div>
      </aside>

      <div class="career-main">
        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>About this Role</h2>
          <p>Cinematic animators are specialized technical artists who create high-fidelity, narrative-driven animation sequences for video games. Their work goes beyond movement, crafting cinematics that immerse players in the game's story, enhance gameplay, and evoke powerful emotions. Unlike character animators who focus on game-specific movements, cinematic animators prioritize artistic expression and narrative impact. They collaborate closely with voice actors, directors, and other game developers to bring characters to life and convey complex emotions through subtle gestures and facial expressions, dynamic camera work and integration of cinematic elements</p>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Salary Resources</h2>
          <div style="display: flex; flex-wrap: wrap; gap: 0.75rem;">
            {salaries.map((s) => (
              <a href={s.url} target="_blank" rel="noopener noreferrer" class="btn btn-blue" style="font-size: 0.85rem;">
                {s.name} &rarr;
              </a>
            ))}
          </div>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Key Responsibilities</h2>
          <ul>
            {responsibilities.map((r) => (
              <li>{r}</li>
            ))}
          </ul>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Learning Resources</h2>
          <ul>
            {resources.map((r) => (
              <li><a href={r.url} target="_blank" rel="noopener noreferrer">{r.name}</a></li>
            ))}
          </ul>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Recommended Books</h2>
          <ul>
            {books.map((b) => (
              <li><a href={b.url} target="_blank" rel="noopener noreferrer">{b.name}</a></li>
            ))}
          </ul>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Tools to Learn</h2>
          <div class="callout callout-info">
            <p>You don&#39;t need to learn all of these — they are some of the more common tools for this role.</p>
          </div>
          <div style="display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.75rem;">
            {tools.map((t) => (
              <span style="background: var(--clr-bg); border: 1px solid var(--clr-dark); border-radius: 4px; padding: 0.3rem 0.6rem; font-size: 0.85rem;">{t}</span>
            ))}
          </div>
        </div>
      </div>

      <aside class="career-sidebar">
        <h3>Quick Links</h3>
        <div class="card" style="padding: 1rem; margin-bottom: 0.75rem;">
          <strong>📋 Job Boards</strong>
          <p style="font-size: 0.85rem; margin-top: 0.35rem;">
            <a href={`${base}career-guide/job-boards/`}>Browse job boards &rarr;</a>
          </p>
        </div>
        <div class="card" style="padding: 1rem; margin-bottom: 0.75rem;">
          <strong>📚 Resources</strong>
          <p style="font-size: 0.85rem; margin-top: 0.35rem;">
            <a href={`${base}career-guide/resources/`}>Career resources &rarr;</a>
          </p>
        </div>
        <div class="card" style="padding: 1rem;">
          <strong>🎯 All Roles</strong>
          <p style="font-size: 0.85rem; margin-top: 0.35rem;">
            <a href={`${base}career-guide/roles/`}>View all disciplines &rarr;</a>
          </p>
        </div>
      </aside>
    </div>
  </WikiLayout>
</BaseLayout>