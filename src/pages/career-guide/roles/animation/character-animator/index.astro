---
import BaseLayout from "../../../../../layouts/BaseLayout.astro";
import WikiLayout from "../../../../../layouts/WikiLayout.astro";
const base = import.meta.env.BASE_URL;

const salaries = [
  { name: "InGameJob", url: "https://ingamejob.com/en/salaries" },
  { name: "Glassdoor", url: "https://www.glassdoor.com/Salaries/character-animator-salary-SRCH_KO0,18.htm" },
  { name: "Salary.com", url: "https://www.salary.com/research/salary/alternate/character-animator-salary" },
  { name: "ZipRecruiter", url: "https://www.ziprecruiter.com/Salaries/Character-Animator-Salary" }
];

const responsibilities = [
  "Developing character rigs.",
  "Creating hand-keyed animation.",
  "Utilizing motion capture data to accurately translate real-world movements into the game environment.",
  "Implementing procedural animation techniques for repetitive actions or crowd simulations.",
  "Collaborating with other game developers, such as designers, programmers, and artists, to ensure character animation seamlessly integrates with the game's overall aesthetic and gameplay.",
  "Analyzing animation scripts and character designs to understand their role and movement requirements.",
  "Creating and editing keyframes for animation sequences, ensuring natural and fluid motion."
];

const resources = [
  { name: "Science of Character Animation course by Markus Magnusson (Motionmarkus)", url: "https://motiondesign.school/courses/science-of-character-animation-by-markus-magnusson/" },
  { name: "Creative Cloud Character Animator Tutorials", url: "https://creativecloud.adobe.com/en-AU/learn/app/adobe-character-animator" },
  { name: "An Introduction to 3D Character Animation Blog Post by Devoted CG", url: "https://devotedcg.com/an-introduction-to-3d-character-animation" },
  { name: "Character Animation Bootcamp by School of Motion", url: "https://www.schoolofmotion.com/courses/character-animation-bootcamp" },
  { name: "Character Animation Courses in Udemy", url: "https://www.udemy.com/topic/character-animation/" },
  { name: "Character Animation Courses in Domestika", url: "https://www.domestika.org/en/courses/area/80-character-animation" },
  { name: "Character Animation Courses in SkillShare", url: "https://www.skillshare.com/en/browse/character-animation" },
  { name: "Animation Mentor Courses", url: "https://www.animationmentor.com/" }
];

const books = [
  { name: "The Animator's Survival Kit by Richard Williams", url: "https://www.amazon.com/Richard-Williams/dp/086547897X/ref=sr_1_1" },
  { name: "Character Animation Crash Course! by Eric Goldberg", url: "https://www.amazon.com/Character-Animation-Crash-Course-included/dp/1879505975/ref=sr_1_1" },
  { name: "Illusion of Life: Disney Animation by Frank Thomas and Ollie Johnston", url: "https://www.amazon.com/Illusion-Life-Disney-Animation/dp/0786860707/ref=sr_1_1" },
  { name: "Acting for Animators by Ed Hooks", url: "https://www.amazon.com/Acting-Animators-4th-Ed-Hooks/dp/1138669121/ref=sr_1_1" },
  { name: "The Art of Animal Drawing by Ken Hultgren", url: "https://www.amazon.com/Art-Animal-Drawing-Construction-Caricature/dp/1621389820/ref=sr_1_1" },
  { name: "Creating Characters with Personality by Tom Bancroft", url: "https://www.amazon.com/Creating-Characters-Personality-Animation-Graphic/dp/0823023494/ref=sr_1_1" },
  { name: "Force: Dynamic Life Drawing for Animators by Michael Mattesi", url: "https://www.amazon.com/FORCE-Dynamic-Drawing-Anniversary-Force/dp/1138919578/ref=sr_1_2" },
  { name: "Morpho: Simplified Forms: Anatomy for Artists by Michael Lauricella", url: "https://www.amazon.com/Morpho-Simplified-Forms-Anatomy-Artists/dp/1681984482/ref=sr_1_4" },
  { name: "3D Character Development Workshop: Rigging Fundamentals for Artists and Animators by Erik Van Horn", url: "https://www.amazon.com/Character-Development-Workshop-Fundamentals-Animators-ebook/dp/B07CSGYSRP/ref=sr_1_3?crid=2KAWNA9HSKXAI&keywords=Character+Rigging+for+3D+Animation+by+Gary+Robson&qid=1702055825&sprefix=character+rigging+for+3d+animation+by+gary+robson%2Caps%2C194&sr=8-3" },
  { name: "Story Structure and Development: A Guide for Animators, VFX Artists, Game Designers, and Virtual Reality by Craig Caldwell", url: "https://www.routledge.com/Story-Structure-and-Development-A-Guide-for-Animators-VFX-Artists-Game/Caldwell/p/book/9781498781732" }
];

const tools = [
  "Game Engines",
  "Maya",
  "Blender",
  "Spine",
  "ZBrush",
  "Houdini",
  "Aseprite",
  "Photoshop",
  "AutoDesk MotionBuilder",
  "Adobe Animate",
  "Toon Boon Harmony",
  "Adobe After Effect",
  "Mixamo",
  "Metahuman Creator",
  "Substance Painter",
  "Live2D Cubism"
];

const sidebarRoles = [
  { name: "Character Animator", slug: "character-animator", current: true },
  { name: "Cinematic Animator", slug: "cinematic-animator", current: false },
  { name: "Motion Capture Artist", slug: "motion-capture-artist", current: false },
  { name: "Technical Animator", slug: "technical-animator", current: false },
  { name: "UX/UI Animator", slug: "ux-ui-animator", current: false },
  { name: "VFX Animator", slug: "vfx-animator", current: false },
  { name: "Rigging Artist", slug: "rigging-artist", current: false }
];
---

<BaseLayout title="Character Animator" activeNav="career-guide">
  <WikiLayout title="Character Animator" activeNav="career-guide" activeSidebar="roles">
    <div class="career-layout">
      <aside class="career-sidebar">
        <h3>Animation Roles</h3>
        {sidebarRoles.map((r) => (
          r.current ? (
            <div class="card" style="padding: 0.75rem; margin-bottom: 0.5rem; border-left: 3px solid var(--clr-pink);">
              <strong style="font-size: 0.9rem; color: var(--clr-pink);">{r.name}</strong>
            </div>
          ) : (
            <a href={`${base}career-guide/roles/animation/${r.slug}/`} class="card" style="padding: 0.75rem; margin-bottom: 0.5rem; text-decoration: none; display: block;">
              <strong style="font-size: 0.9rem;">{r.name}</strong>
            </a>
          )
        ))}
        <div style="margin-top: 1rem;">
          <a href={`${base}career-guide/roles/animation/`} class="btn btn-gold" style="font-size: 0.8rem; padding: 0.4rem 0.8rem;">&larr; Animation</a>
        </div>
      </aside>

      <div class="career-main">
        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>About this Role</h2>
          <p>Character animators are technical artists specializing in creating realistic and expressive movements for characters in video games. They work with 3D models or 2D sprites and utilize various animation techniques to bring them to life. They use various techniques, including hand-keyed animation, motion capture, and procedural animation, to create believable and expressive movements for characters. Character animators must have a strong understanding of animation principles and a deep knowledge of character design.</p>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Salary Resources</h2>
          <div style="display: flex; flex-wrap: wrap; gap: 0.75rem;">
            {salaries.map((s) => (
              <a href={s.url} target="_blank" rel="noopener noreferrer" class="btn btn-blue" style="font-size: 0.85rem;">
                {s.name} &rarr;
              </a>
            ))}
          </div>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Key Responsibilities</h2>
          <ul>
            {responsibilities.map((r) => (
              <li>{r}</li>
            ))}
          </ul>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Learning Resources</h2>
          <ul>
            {resources.map((r) => (
              <li><a href={r.url} target="_blank" rel="noopener noreferrer">{r.name}</a></li>
            ))}
          </ul>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Recommended Books</h2>
          <ul>
            {books.map((b) => (
              <li><a href={b.url} target="_blank" rel="noopener noreferrer">{b.name}</a></li>
            ))}
          </ul>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Tools to Learn</h2>
          <div class="callout callout-info">
            <p>You don&#39;t need to learn all of these — they are some of the more common tools for this role.</p>
          </div>
          <div style="display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.75rem;">
            {tools.map((t) => (
              <span style="background: var(--clr-bg); border: 1px solid var(--clr-dark); border-radius: 4px; padding: 0.3rem 0.6rem; font-size: 0.85rem;">{t}</span>
            ))}
          </div>
        </div>
      </div>

      <aside class="career-sidebar">
        <h3>Quick Links</h3>
        <div class="card" style="padding: 1rem; margin-bottom: 0.75rem;">
          <strong>📋 Job Boards</strong>
          <p style="font-size: 0.85rem; margin-top: 0.35rem;">
            <a href={`${base}career-guide/job-boards/`}>Browse job boards &rarr;</a>
          </p>
        </div>
        <div class="card" style="padding: 1rem; margin-bottom: 0.75rem;">
          <strong>📚 Resources</strong>
          <p style="font-size: 0.85rem; margin-top: 0.35rem;">
            <a href={`${base}career-guide/resources/`}>Career resources &rarr;</a>
          </p>
        </div>
        <div class="card" style="padding: 1rem;">
          <strong>🎯 All Roles</strong>
          <p style="font-size: 0.85rem; margin-top: 0.35rem;">
            <a href={`${base}career-guide/roles/`}>View all disciplines &rarr;</a>
          </p>
        </div>
      </aside>
    </div>
  </WikiLayout>
</BaseLayout>