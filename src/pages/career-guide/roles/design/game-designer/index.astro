---
import BaseLayout from "../../../../../layouts/BaseLayout.astro";
import WikiLayout from "../../../../../layouts/WikiLayout.astro";
const base = import.meta.env.BASE_URL;

const salaries = [
  { name: "InGameJob", url: "https://ingamejob.com/en/salaries" },
  { name: "Glassdoor", url: "https://www.glassdoor.com/Salaries/game-designer-salary-SRCH_KO0,13.htm" },
  { name: "Salary.com", url: "https://www.salary.com/research/salary/recruiting/game-designer-salary" },
  { name: "ZipRecruiter", url: "https://www.ziprecruiter.com/Salaries/GAME-Designer-Salary#Yearly" }
];

const responsibilities = [
  "Design core gameplay loops, mechanics, rules, and progression systems that ensure fun and engaging play.",
  "Optimize difficulty curves, pacing, and resource management to create a satisfying progression for players of all skill levels.",
  "Analyze player feedback, data, and gameplay observations to continually refine and improve the game's core systems and experience.",
  "Research and analyze player preferences, trends, and demographics to inform design decisions and ensure the game resonates with its intended audience.",
  "Champion the player's experience throughout development, ensuring the game feels polished, intuitive, and ultimately fun to play.",
  "Build economies, combat mechanics, and character progression that feel fair, intuitive, and addictive.",
  "Research industry trends, play competitor games, and experiment with new mechanics to keep the game fresh.",
  "Create and manage the documentation of game design files like the GDD and One-Pager documents."
];

const resources = [
  { name: "Into Games’ Junior Game Designer Database", url: "https://entrylevel.games/database/junior-game-designer" },
  { name: "Spreadsheet Tools in Game Design", url: "https://medium.com/@urpi/spreadsheet-tools-in-game-design-57511eac68c" },
  { name: "GDD Template", url: "https://docs.google.com/document/d/1KNqZez5ImjqAgjs--KJjScfjTH2igyASX83dHHEZQTw/edit?usp=sharing" },
  { name: "Game Design One Pager Template", url: "https://docs.google.com/document/d/1t9nAbA2GYaXENET1ZgcXuoFZDKRKbvBG5fba2_s0h2o/edit?usp=sharing" },
  { name: "Unity’s E-Book for Game Designers", url: "https://blog.unity.com/games/e-book-for-level-designers" },
  { name: "The Unity Game Designer Playbook", url: "https://unity.com/es/resources/game-designer-playbook" },
  { name: "Extra Credits’ YouTube Game Design Playlist", url: "https://www.youtube.com/playlist?list=PLhyKYa0YJ_5BkTruCmaBBZ8z6cP9KzPiX" },
  { name: "Game Design Resources by UNT", url: "https://guides.library.unt.edu/game-design/resources" },
  { name: "The Chemistry Of Game Design", url: "https://www.gamedeveloper.com/design/the-chemistry-of-game-design" },
  { name: "r/GameDesign", url: "https://www.reddit.com/r/gamedesign/" },
  { name: "The History of Creativity in Game Design | The Evolution of Genres, and Innovation in Video Games by The Game Overanalyser", url: "https://youtu.be/TKsk2RrVi4M" },
  { name: "Cultist Simulator: Designing an Experimental Game for Commercial Success - GDC Talk by Alexis Kennedy", url: "https://www.youtube.com/watch?v=0pBvMIUk1nQ&ab_channel=GDC" },
  { name: "Three Hundred Mechanics", url: "https://www.squidi.net/three/" },
  { name: "Resources and Game Design by Topdeck", url: "https://topdeck.gg/articles/resources-and-game-design" },
  { name: "The colors of game design", url: "https://uxdesign.cc/colors-of-game-design-9413d81e93a" },
  { name: "The 4 Keys to Fun by XEO Design", url: "https://www.xeodesign.com/research/" }
];

const books = [
  { name: "Story Structure and Development: A Guide for Animators, VFX Artists, Game Designers, and Virtual Reality by Craig Caldwell", url: "https://www.routledge.com/Story-Structure-and-Development-A-Guide-for-Animators-VFX-Artists-Game/Caldwell/p/book/9781498781732" },
  { name: "The Ultimate Guide to Video Game Writing and Design by Flint Dille and John Zuur Platten", url: "https://www.amazon.com/Ultimate-Guide-Video-Writing-Design/dp/158065066X/" },
  { name: "Level Up! The Guide to Great Video Game Design by Scott Rogers", url: "https://www.amazon.com/Level-Guide-Great-Video-Design/dp/1118877160/" },
  { name: "The Art of Game Design: A Book of Lenses by Jesse Schell", url: "https://www.amazon.com/Art-Game-Design-Lenses-Third/dp/1138632058" },
  { name: "Theory of Fun for Game Design by Raph Koster", url: "https://www.amazon.com/Theory-Game-Design-Raph-Koster/dp/1449363210/" },
  { name: "Game Design Workshop: A Playcentric Approach to Creating Innovative Games by Tracy Fullerton", url: "https://www.amazon.com/Game-Design-Workshop-Playcentric-Innovative/dp/1138098779" },
  { name: "Game Feel by Steve Swink", url: "https://www.amazon.com/Game-Feel-Designers-Sensation-Kaufmann/dp/0123743281/" },
  { name: "Game Usability by Noah Schaffer and Katherine Isbister", url: "https://www.amazon.com/gp/product/B0092J077G" },
  { name: "Hooked: How to Build Habit-Forming Products by Nir Eyal", url: "https://www.amazon.com/Hooked-How-Build-Habit-Forming-Products/dp/1591847788" },
  { name: "Game Balance by Ian Schreiber and Brenda Romero", url: "https://www.amazon.com/Game-Balance-Brenda-Romero/dp/1498799574" },
  { name: "Advanced Game Design: A Systems Approach by Michael Sellers", url: "https://www.amazon.com/Advanced-Game-Design-Systems-Approach/dp/0134667603/" },
  { name: "Games, Design and Play: A detailed approach to iterative game design by Colleen Macklin and John Sharp", url: "https://www.amazon.com/Games-Design-Play-detailed-iterative/dp/0134392078/" },
  { name: "Rules of Play: Game Design Fundamentals by Katie Salen Tekinbas and Eric Zimmerman", url: "https://www.amazon.com/Rules-Play-Design-Fundamentals-Press/dp/0262240459/" },
  { name: "Advanced Game Design: A Systems Approach by Michael Sellers", url: "https://www.amazon.com/Advanced-Game-Design-Systems-Approach/dp/0134667603/" },
  { name: "Fundamentals of Creature Design: How to Create Successful Concepts Using Functionality, Anatomy, Color, Shape & Scale by 3dtotal Publishing", url: "https://www.amazon.com/Fundamentals-Creature-Design-Successful-Functionality/dp/1912843129/" },
  { name: "Fundamentals of Game Design by Ernest Adams", url: "https://www.amazon.com/Fundamentals-Game-Design-Ernest-Adams/dp/0321929675/" },
  { name: "Kobold Guide to Game Design by Wolfgang Baur, Amber Scott, Colin McComb, Keith Baker, Michael A. Stackpole, Kelly Pawlik, Jeff Grubb and Ed Greenwood", url: "https://www.amazon.com/Kobold-Guide-Game-Design-2nd/dp/1936781034/" },
  { name: "Designing Games: A Guide to Engineering Experiences by Tynan Sylvester", url: "https://www.amazon.com/Designing-Games-Guide-Engineering-Experiences/dp/1449337937" }
];

const tools = [
  "Game Engines",
  "Perforce",
  "Jira",
  "Confluence",
  "Cloud Storage Software",
  "Excel",
  "Twine",
  "InVision",
  "Figma",
  "Miro",
  "Git",
  "Python",
  "C#",
  "C++",
  "Excel"
];

const sidebarRoles = [
  { name: "Game Designer", slug: "game-designer", current: true },
  { name: "Level Designer", slug: "level-designer", current: false },
  { name: "Narrative Designer/Writer", slug: "narrative-designer-writer", current: false },
  { name: "Gameplay Designer", slug: "gameplay-designer", current: false },
  { name: "System Designer", slug: "system-designer", current: false },
  { name: "UX/UI Designer", slug: "ux-ui-designer", current: false },
  { name: "Technical Designer", slug: "technical-designer", current: false }
];
---

<BaseLayout title="Game Designer" activeNav="career-guide">
  <WikiLayout title="Game Designer" activeNav="career-guide" activeSidebar="roles">
    <div class="career-layout">
      <aside class="career-sidebar">
        <h3>Game Design Roles</h3>
        {sidebarRoles.map((r) => (
          r.current ? (
            <div class="card" style="padding: 0.75rem; margin-bottom: 0.5rem; border-left: 3px solid var(--color-pink);">
              <strong style="font-size: 0.9rem; color: var(--color-pink);">{r.name}</strong>
            </div>
          ) : (
            <a href={`${base}career-guide/roles/design/${r.slug}/`} class="card" style="padding: 0.75rem; margin-bottom: 0.5rem; text-decoration: none; display: block;">
              <strong style="font-size: 0.9rem;">{r.name}</strong>
            </a>
          )
        ))}
        <div style="margin-top: 1rem;">
          <a href={`${base}career-guide/roles/design/`} class="btn btn-gold" style="font-size: 0.8rem; padding: 0.4rem 0.8rem;">&larr; Game Design</a>
        </div>
      </aside>

      <div class="career-main">
        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>About this Role</h2>
          <p>A Game Designer is the creator of the core gameplay experience. Their tools are logic, systems, and mechanics, used to craft moments of thrill, frustration, and satisfaction that keep players immersed. From defining win conditions and crafting meaningful objectives to balancing difficulty and pacing the flow of content, game designers shape every aspect of the player's journey. They collaborate with artists, programmers, and writers, translating creative vision into concrete rules and interactions.</p>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Salary Resources</h2>
          <div style="display: flex; flex-wrap: wrap; gap: 0.75rem;">
            {salaries.map((s) => (
              <a href={s.url} target="_blank" rel="noopener noreferrer" class="btn btn-blue" style="font-size: 0.85rem;">
                {s.name} &rarr;
              </a>
            ))}
          </div>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Key Responsibilities</h2>
          <ul>
            {responsibilities.map((r) => (
              <li>{r}</li>
            ))}
          </ul>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Learning Resources</h2>
          <ul>
            {resources.map((r) => (
              <li><a href={r.url} target="_blank" rel="noopener noreferrer">{r.name}</a></li>
            ))}
          </ul>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Recommended Books</h2>
          <ul>
            {books.map((b) => (
              <li><a href={b.url} target="_blank" rel="noopener noreferrer">{b.name}</a></li>
            ))}
          </ul>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Tools to Learn</h2>
          <div class="callout callout-info">
            <p>You don&#39;t need to learn all of these — they are some of the more common tools for this role.</p>
          </div>
          <div style="display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.75rem;">
            {tools.map((t) => (
              <span style="background: var(--color-bg); border: 1px solid var(--color-dark); border-radius: 4px; padding: 0.3rem 0.6rem; font-size: 0.85rem;">{t}</span>
            ))}
          </div>
        </div>
      </div>

      <aside class="career-sidebar">
        <h3>Quick Links</h3>
        <div class="card" style="padding: 1rem; margin-bottom: 0.75rem;">
          <strong>📋 Job Boards</strong>
          <p style="font-size: 0.85rem; margin-top: 0.35rem;">
            <a href={`${base}career-guide/job-boards/`}>Browse job boards &rarr;</a>
          </p>
        </div>
        <div class="card" style="padding: 1rem; margin-bottom: 0.75rem;">
          <strong>📚 Resources</strong>
          <p style="font-size: 0.85rem; margin-top: 0.35rem;">
            <a href={`${base}career-guide/resources/`}>Career resources &rarr;</a>
          </p>
        </div>
        <div class="card" style="padding: 1rem;">
          <strong>🎯 All Roles</strong>
          <p style="font-size: 0.85rem; margin-top: 0.35rem;">
            <a href={`${base}career-guide/roles/`}>View all disciplines &rarr;</a>
          </p>
        </div>
      </aside>
    </div>
  </WikiLayout>
</BaseLayout>