---
import BaseLayout from "../../../../../layouts/BaseLayout.astro";
import WikiLayout from "../../../../../layouts/WikiLayout.astro";
const base = import.meta.env.BASE_URL;

const salaries = [
  { name: "InGameJob", url: "https://ingamejob.com/en/salaries" },
  { name: "Glassdoor", url: "https://www.glassdoor.com/Salaries/game-systems-designer-salary-SRCH_KO0,21.htm" },
  { name: "Salary.com", url: "https://www.salary.com/research/salary/hiring/system-designer-salary" },
  { name: "ZipRecruiter", url: "https://www.ziprecruiter.com/Salaries/Game-Systems-Designer-Salary" }
];

const responsibilities = [
  "Design and implement the underlying systems that power the game's mechanics, including economy, inventory, save/load, and data persistence.",
  "Create and optimize complex algorithms and scripts that handle everything from AI behavior to physics simulation.",
  "Analyze player data and in-game metrics to identify areas for improvement, balance issues, and potential monetization opportunities.",
  "Translate gameplay concepts and mechanics into functional systems that are efficient, scalable, and support the desired player experience.",
  "Ensure the game runs smoothly and efficiently across various platforms and hardware configurations.",
  "Break down complex systems into reusable components for ease of maintenance, iteration, and future game development."
];

const resources = [
  { name: "GameDesign Math: RPG Level-based Progression", url: "https://www.davideaversa.it/blog/gamedesign-math-rpg-level-based-progression/" },
  { name: "Gamedev Economy Design by Fundamentally Games", url: "https://www.youtube.com/watch?v=75R0ezHWX_4&ab_channel=FundamentallyGames" },
  { name: "Keys to Meaningful Skill Trees by GDKeys", url: "https://gdkeys.com/keys-to-meaningful-skill-trees/" },
  { name: "Keys to Economic Systems by GDKeys", url: "https://gdkeys.com/keys-to-economic-systems/" },
  { name: "A Systemic Approach to Systemic Design - Mike Sellers", url: "https://www.youtube.com/watch?v=HR8EmTyJz9A&ab_channel=SwedenGameArena" },
  { name: "A Peek Inside the System Designer's Toolkit by Squirrel Eiserloh", url: "https://www.youtube.com/watch?v=FW-T-wTQ2-w&ab_channel=UTDSGDA" },
  { name: "Game Design Case Studies - One Designer | One Game | One System", url: "https://www.youtube.com/watch?v=5UdVNmbIClM&ab_channel=GDC" },
  { name: "LCIEducation: Introduction to Game Design: Game Systems and Balance", url: "https://www.edx.org/es/learn/computer-science/lci-education-introduction-to-game-design-game-systems-and-balance" },
  { name: "Introduction to Game Systems Design by Dax Gazaway", url: "https://ptgmedia.pearsoncmg.com/images/9780137440849/samplepages/9780137440849_Sample.pdf" },
  { name: "What is game economy design by Machinations", url: "https://machinations.io/articles/what-is-game-economy-design" },
  { name: "The Fundamentals of Game Economy Design by Tom Hammond", url: "https://blog.userwise.io/blog/the-fundamentals-of-game-economy-design" }
];

const books = [
  { name: "Level Up! The Guide to Great Video Game Design by Scott Rogers", url: "https://www.amazon.com/Level-Guide-Great-Video-Design/dp/1118877160/" },
  { name: "The Art of Game Design: A Book of Lenses by Jesse Schell", url: "https://www.amazon.com/Art-Game-Design-Lenses-Third/dp/1138632058" },
  { name: "Theory of Fun for Game Design by Raph Koster", url: "https://www.amazon.com/Theory-Game-Design-Raph-Koster/dp/1449363210/" },
  { name: "Game Design Workshop: A Playcentric Approach to Creating Innovative Games by Tracy Fullerton", url: "https://www.amazon.com/Game-Design-Workshop-Playcentric-Innovative/dp/1138098779" },
  { name: "Game Feel by Steve Swink", url: "https://www.amazon.com/Game-Feel-Designers-Sensation-Kaufmann/dp/0123743281/" },
  { name: "Hooked: How to Build Habit-Forming Products by Nir Eyal", url: "https://www.amazon.com/Hooked-How-Build-Habit-Forming-Products/dp/1591847788" },
  { name: "Game Balance by Ian Schreiber and Brenda Romero", url: "https://www.amazon.com/Game-Balance-Brenda-Romero/dp/1498799574" },
  { name: "Advanced Game Design: A Systems Approach by Michael Sellers", url: "https://www.amazon.com/Advanced-Game-Design-Systems-Approach/dp/0134667603/" },
  { name: "Games, Design and Play: A detailed approach to iterative game design by Colleen Macklin and John Sharp", url: "https://www.amazon.com/Games-Design-Play-detailed-iterative/dp/0134392078/" },
  { name: "Kobold Guide to Game Design by Wolfgang Baur, Amber Scott, Colin McComb, Keith Baker, Michael A. Stackpole, Kelly Pawlik, Jeff Grubb and Ed Greenwood", url: "https://www.amazon.com/Kobold-Guide-Game-Design-2nd/dp/1936781034/" },
  { name: "Designing Games: A Guide to Engineering Experiences by Tynan Sylvester", url: "https://www.amazon.com/Designing-Games-Guide-Engineering-Experiences/dp/1449337937" }
];

const tools = [
  "Game Engines",
  "C#",
  "C++",
  "Python",
  "Git",
  "Visual Scripting Tools",
  "Jira",
  "Trello",
  "Tableau",
  "Power BI",
  "Rider",
  "Lucidchart",
  "Unreal Insights",
  "Unity Profiler",
  "Confluence",
  "Notion"
];

const sidebarRoles = [
  { name: "Game Designer", slug: "game-designer", current: false },
  { name: "Level Designer", slug: "level-designer", current: false },
  { name: "Narrative Designer/Writer", slug: "narrative-designer-writer", current: false },
  { name: "Gameplay Designer", slug: "gameplay-designer", current: false },
  { name: "System Designer", slug: "system-designer", current: true },
  { name: "UX/UI Designer", slug: "ux-ui-designer", current: false },
  { name: "Technical Designer", slug: "technical-designer", current: false }
];
---

<BaseLayout title="System Designer" activeNav="career-guide">
  <WikiLayout title="System Designer" activeNav="career-guide" activeSidebar="roles">
    <div class="career-layout">
      <aside class="career-sidebar">
        <h3>Game Design Roles</h3>
        {sidebarRoles.map((r) => (
          r.current ? (
            <div class="card" style="padding: 0.75rem; margin-bottom: 0.5rem; border-left: 3px solid var(--clr-pink);">
              <strong style="font-size: 0.9rem; color: var(--clr-pink);">{r.name}</strong>
            </div>
          ) : (
            <a href={`${base}career-guide/roles/design/${r.slug}/`} class="card" style="padding: 0.75rem; margin-bottom: 0.5rem; text-decoration: none; display: block;">
              <strong style="font-size: 0.9rem;">{r.name}</strong>
            </a>
          )
        ))}
        <div style="margin-top: 1rem;">
          <a href={`${base}career-guide/roles/design/`} class="btn btn-gold" style="font-size: 0.8rem; padding: 0.4rem 0.8rem;">&larr; Game Design</a>
        </div>
      </aside>

      <div class="career-main">
        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>About this Role</h2>
          <p>A Game System Designer is the unseen hand guiding the intricate mechanisms that breathe life into a game. They craft and balance the interconnected systems that underpin the player's experience, from combat and economy to progression and AI behavior, mixing logic, challenge, and reward to create a compelling gameplay loop. Every aspect of the game's interactivity, from the satisfying clink of a well-placed sword strike to the thrill of unlocking a new skill, is the result of their meticulous design. They ensure the gears of gameplay mesh seamlessly, driving players forward on a rewarding and engaging journey.</p>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Salary Resources</h2>
          <div style="display: flex; flex-wrap: wrap; gap: 0.75rem;">
            {salaries.map((s) => (
              <a href={s.url} target="_blank" rel="noopener noreferrer" class="btn btn-blue" style="font-size: 0.85rem;">
                {s.name} &rarr;
              </a>
            ))}
          </div>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Key Responsibilities</h2>
          <ul>
            {responsibilities.map((r) => (
              <li>{r}</li>
            ))}
          </ul>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Learning Resources</h2>
          <ul>
            {resources.map((r) => (
              <li><a href={r.url} target="_blank" rel="noopener noreferrer">{r.name}</a></li>
            ))}
          </ul>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Recommended Books</h2>
          <ul>
            {books.map((b) => (
              <li><a href={b.url} target="_blank" rel="noopener noreferrer">{b.name}</a></li>
            ))}
          </ul>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Tools to Learn</h2>
          <div class="callout callout-info">
            <p>You don&#39;t need to learn all of these — they are some of the more common tools for this role.</p>
          </div>
          <div style="display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.75rem;">
            {tools.map((t) => (
              <span style="background: var(--clr-bg); border: 1px solid var(--clr-dark); border-radius: 4px; padding: 0.3rem 0.6rem; font-size: 0.85rem;">{t}</span>
            ))}
          </div>
        </div>
      </div>

      <aside class="career-sidebar">
        <h3>Quick Links</h3>
        <div class="card" style="padding: 1rem; margin-bottom: 0.75rem;">
          <strong>📋 Job Boards</strong>
          <p style="font-size: 0.85rem; margin-top: 0.35rem;">
            <a href={`${base}career-guide/job-boards/`}>Browse job boards &rarr;</a>
          </p>
        </div>
        <div class="card" style="padding: 1rem; margin-bottom: 0.75rem;">
          <strong>📚 Resources</strong>
          <p style="font-size: 0.85rem; margin-top: 0.35rem;">
            <a href={`${base}career-guide/resources/`}>Career resources &rarr;</a>
          </p>
        </div>
        <div class="card" style="padding: 1rem;">
          <strong>🎯 All Roles</strong>
          <p style="font-size: 0.85rem; margin-top: 0.35rem;">
            <a href={`${base}career-guide/roles/`}>View all disciplines &rarr;</a>
          </p>
        </div>
      </aside>
    </div>
  </WikiLayout>
</BaseLayout>