  { name: "Kobold Guide to Plots & Campaigns by Margaret Weis, Wolfgang Baur, Jeff Grubb, Clinton J. Boomer, Robert J. Schwalb, Zeb Cook, James Jacobs, Kevin Kulp, Richard Pett, Amber E. Scott", url: "https://www.amazon.com/Kobold-Guide-Plots-Campaigns-Guides/dp/193678162X/" },
