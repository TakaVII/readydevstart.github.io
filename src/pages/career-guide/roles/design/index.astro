---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import WikiLayout from "../../../../layouts/WikiLayout.astro";
const base = import.meta.env.BASE_URL;

const roles = [
  { name: "Game Designer", description: "Defines core gameplay mechanics, loops, and player progression systems." },
  { name: "Level Designer", description: "Designs individual levels, maps, and environments that guide player flow and challenge." },
  { name: "Narrative Designer", description: "Crafts stories, dialogue, and lore that are woven into gameplay." },
  { name: "Systems Designer", description: "Designs interconnected game systems — economy, combat, crafting, AI behaviors." },
  { name: "UX Designer", description: "Ensures the game interface is intuitive and the player experience is smooth and accessible." },
];
---

<BaseLayout title="Design Roles" activeNav="career-guide">
  <WikiLayout title="Design Roles" activeNav="career-guide" activeSidebar="roles">
    <p>
      Design roles define how games feel to play. Designers craft the rules,
      systems, stories, and experiences that keep players engaged.
    </p>

    <div class="career-layout">
      <aside class="career-sidebar">
        <h3>Design Roles</h3>
        {roles.map((r) => (
          <div class="card" style="padding: 0.75rem; margin-bottom: 0.5rem;">
            <strong style="font-size: 0.9rem;">{r.name}</strong>
          </div>
        ))}
        <div style="margin-top: 1rem;">
          <a href={`${base}career-guide/roles/`} class="btn btn-gold" style="font-size: 0.8rem; padding: 0.4rem 0.8rem;">← All Roles</a>
        </div>
      </aside>

      <div class="career-main">
        {roles.map((role) => (
          <div class="card" style="margin-bottom: 1rem;">
            <h3>{role.name}</h3>
            <p>{role.description}</p>
          </div>
        ))}
      </div>

      <aside class="career-sidebar">
        <h3>Related</h3>
        <div class="card" style="padding: 1rem; margin-bottom: 0.75rem;">
          <p style="font-size: 0.85rem;">
            <a href={`${base}quest-logs/game-design-101/`}>Game Design 101 →</a>
          </p>
        </div>
        <div class="card" style="padding: 1rem;">
          <p style="font-size: 0.85rem;">
            <a href={`${base}career-guide/resources/`}>Resources →</a>
          </p>
        </div>
      </aside>
    </div>
  </WikiLayout>
</BaseLayout>
