---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import WikiLayout from "../../../../layouts/WikiLayout.astro";
const base = import.meta.env.BASE_URL;

const roles = [
  { name: "LiveOps Engineer", slug: "liveops-engineer", description: "LiveOps Engineers are constantly adapting and improving the world after launch." },
  { name: "Data Analyst", slug: "data-analyst", description: "The Data Analyst is a role made for mixing creativity with insight, translating the vast volumes of data generated by players into actionable intel for developers." },
  { name: "Customer Support Specialist", slug: "customer-support-specialist", description: "A Customer Support Specialist in the game industry is the lifeline between players and the developer." },
  { name: "Data Scientist", slug: "data-scientist", description: "Data scientists act as hidden detectives, wielding statistics and algorithms to unlock the secrets of player behavior." }
];

const skills = [
  "Systems Administration",
  "Network Management",
  "Cloud Computing",
  "DevOps",
  "Server Management",
  "Database Administration",
  "Incident Management",
  "Infrastructure Monitoring",
  "Capacity Planning",
  "Security Management",
  "Release Management",
  "Performance Optimization",
  "Backup and Recovery",
  "Disaster Recovery Planning",
  "Automation and Scripting",
  "Virtualization",
  "Change Management",
  "Troubleshooting",
  "Documentation and Knowledge Management"
];
---

<BaseLayout title="Infrastructure & Live Ops Roles" activeNav="career-guide">
  <WikiLayout title="Infrastructure & Live Ops Roles" activeNav="career-guide" activeSidebar="roles">
    <p>LiveOps in the gaming industry pertains to the dynamic management and operation of a live game following its initial launch. It encompasses the consistent provision of support, maintenance, and updates to ensure the game's enduring appeal and player engagement. LiveOps encompasses a diverse set of activities and strategies aimed at enriching the player experience, prolonging the game's lifespan, and driving revenue. Ultimately, the objective of LiveOps is to sustain the game's appeal, captivate players, and ensure long-term profitability.</p>

    <div class="career-layout">
      <aside class="career-sidebar">
        <h3>Infrastructure & Live Ops Roles</h3>
        {roles.map((r) => (
          <a href={`${base}career-guide/roles/infrastructure/${r.slug}/`} class="card" style="padding: 0.75rem; margin-bottom: 0.5rem; text-decoration: none; display: block;">
            <strong style="font-size: 0.9rem;">{r.name}</strong>
          </a>
        ))}
        <div style="margin-top: 1rem;">
          <a href={`${base}career-guide/roles/`} class="btn btn-gold" style="font-size: 0.8rem; padding: 0.4rem 0.8rem;">&larr; All Roles</a>
        </div>
      </aside>

      <div class="career-main">
        <div class="card-grid" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
          {roles.map((role) => (
            <a href={`${base}career-guide/roles/infrastructure/${role.slug}/`} class="card" style="text-decoration:none;">
              <h3>{role.name}</h3>
              <p>{role.description}</p>
              <span class="btn btn-pink" style="font-size: 0.8rem; padding: 0.3rem 0.6rem; margin-top: 0.5rem; display: inline-block;">View Role &rarr;</span>
            </a>
          ))}
        </div>

        <div class="card" style="margin-top: 1.5rem;">
          <h3>Skills Involved</h3>
          <div style="display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.75rem;">
            {skills.map((s) => (
              <span style="background: var(--color-bg); border: 1px solid var(--color-dark); border-radius: 4px; padding: 0.3rem 0.6rem; font-size: 0.85rem;">{s}</span>
            ))}
          </div>
        </div>
      </div>

      <aside class="career-sidebar">
        <h3>Related</h3>
        <div class="card" style="padding: 1rem; margin-bottom: 0.75rem;">
          <p style="font-size: 0.85rem;">
            <a href={`${base}career-guide/roles/design/`}>🧩 Game Design Roles &rarr;</a>
          </p>
        </div>
        <div class="card" style="padding: 1rem; margin-bottom: 0.75rem;">
          <p style="font-size: 0.85rem;">
            <a href={`${base}career-guide/roles/marketing/`}>📣 Marketing Roles &rarr;</a>
          </p>
        </div>
        <div class="card" style="padding: 1rem;">
          <p style="font-size: 0.85rem;">
            <a href={`${base}career-guide/job-boards/`}>Job Boards &rarr;</a>
          </p>
        </div>
      </aside>
    </div>
  </WikiLayout>
</BaseLayout>