---
import BaseLayout from "../../../../../layouts/BaseLayout.astro";
import WikiLayout from "../../../../../layouts/WikiLayout.astro";
import RoleGuide from "../../../../../components/RoleGuide.astro";
const base = import.meta.env.BASE_URL;

const salaries = [
  { name: "InGameJob", url: "https://ingamejob.com/en/salaries" },
  { name: "Glassdoor", url: "https://www.glassdoor.com/Salaries/data-scientist-salary-SRCH_KO0,14.htm" },
  { name: "Salary.com", url: "https://www.salary.com/research/salary/listing/data-scientist-salary" },
  { name: "ZipRecruiter", url: "https://www.ziprecruiter.com/Salaries/DATA-Scientist-Salary" }
];

const responsibilities = [
  "Develop and implement complex data models and machine learning algorithms to analyze player behavior, preferences, and churn, uncovering hidden insights to drive game development and live operations decisions.",
  "Design and execute A/B tests, controlled experiments, and other statistical analyses to measure the impact of new features, content, and monetization strategies.",
  "Build predictive models to anticipate player trends, churn risk, and optimize resource allocation based on data-driven insights.",
  "Collaborate with designers, developers, and marketers to translate complex data findings into actionable recommendations and compelling narratives for non-technical stakeholders.",
  "Develop and use automated data pipelines and machine learning workflows to streamline data analysis processes and optimize efficiency.",
  "Translate business objectives into data-driven strategies and collaborate with designers and artists to integrate insights into the game's creative vision."
];

const resources = [
  { name: "What Do Data Analyst/Scientist(s) Do in The Gaming Industry?", url: "https://datascope.co.uk/blog/what-do-data-analyst-scientists-do-in-the-gaming-industry/" },
  { name: "Top 8 Data Science Use Cases in Gaming", url: "https://activewizards.com/blog/top-8-data-science-use-cases-in-gaming/" },
  { name: "Kaggle Learn: Free Micro-Courses in Python, pandas, SQL, and Machine Learning", url: "https://www.kaggle.com/learn" },
  { name: "Kaggle Video Game Datasets (free data for portfolio projects)", url: "https://www.kaggle.com/datasets?search=video+games" },
  { name: "An Introduction to Statistical Learning (free book and videos)", url: "https://www.statlearning.com/" },
  { name: "StatQuest with Josh Starmer (free statistics and ML videos)", url: "https://www.youtube.com/@statquest" },
  { name: "Practical Deep Learning for Coders by fast.ai (free course)", url: "https://course.fast.ai/" },
  { name: "Data Science Resources by Data School", url: "https://www.dataschool.io/resources/" }
];

const books = [
  { name: "Game Data Science by Magy Seif El-Nasr, Truong-Huy D. Nguyen, Alessandro Canossa and Anders Drachen", url: "https://www.amazon.com/dp/019289787X/" },
  { name: "Game Analytics: Maximizing the Value of Player Data by Magy Seif El-Nasr, Anders Drachen and Alessandro Canossa", url: "https://www.amazon.com/dp/1447147685/" },
  { name: "Ace the Data Science Interview by Nick Singh and Kevin Huo", url: "https://www.amazon.com/Ace-Data-Science-Interview-Questions/dp/0578973839/" },
  { name: "Build a Career in Data Science by Emily Robinson and Jacqueline Nolis", url: "https://www.amazon.com/Build-Career-Science-Jacqueline-Nolis/dp/1617296244/" },
  { name: "The Data Science Handbook: Advice and Insights from 25 Amazing Data Scientists by Carl Shan, William Chen, Henry Wang and Max Song", url: "https://www.amazon.com/Data-Science-Handbook-Insights-Scientists/dp/0692434879/" },
  { name: "Think Like a Data Scientist: Tackle the data science process step-by-step by Brian Godsey", url: "https://www.amazon.com/Think-Like-Scientist-step-step/dp/1633430278/" },
  { name: "Storytelling with Data: A Data Visualization Guide for Business Professionals by Cole Nussbaumer Knaflic", url: "https://www.amazon.com/dp/1119002257/" },
  { name: "Data Science for Business: What You Need to Know About Data Mining and Data-Analytic Thinking by Foster Provost and Tom Fawcett", url: "https://www.amazon.com/dp/B08VL5K5ZX" },
  { name: "Becoming a Data Head: How to Think, Speak, and Understand Data Science, Statistics, and Machine Learning by Alex J. Gutman and Jordan Goldmeier", url: "https://www.amazon.com/Becoming-Data-Head-Understand-Statistics/dp/1119741742/" },
  { name: "Practical Statistics for Data Scientists: 50+ Essential Concepts Using R and Python (2nd Edition) by Peter Bruce, Andrew Bruce and Peter Gedeck", url: "https://www.amazon.com/dp/149207294X/" }
];

const tools = [
  "Python",
  "Pandas",
  "NumPy",
  "PySpark",
  "Scikit-learn",
  "TensorFlow",
  "PyTorch",
  "Jupyter Notebook",
  "Git",
  "SQL",
  "Tableau",
  "Power BI",
  "Databricks",
  "Cloud Computing Platforms (AWS, Azure, GCP)"
];

const sidebarRoles = [
  { name: "LiveOps Engineer", slug: "liveops-engineer", current: false },
  { name: "Data Analyst", slug: "data-analyst", current: false },
  { name: "Customer Support Specialist", slug: "customer-support-specialist", current: false },
  { name: "Data Scientist", slug: "data-scientist", current: true }
];
---

<BaseLayout title="How to Become a Data Scientist in Games: Career Path & Skills" description="How to become a Data Scientist in the game industry: step-by-step career path, key skills, what to show employers, salary resources, tools to learn, and FAQs." activeNav="career-guide">
  <WikiLayout title="Data Scientist" activeNav="career-guide" activeSidebar="roles">
    <div class="career-layout">
      <aside class="career-sidebar">
        <h3>Infrastructure & Live Ops Roles</h3>
        {sidebarRoles.map((r) => (
          r.current ? (
            <div class="card" style="padding: 0.75rem; margin-bottom: 0.5rem; border-left: 3px solid var(--color-pink);">
              <strong style="font-size: 0.9rem; color: var(--color-pink);">{r.name}</strong>
            </div>
          ) : (
            <a href={`${base}career-guide/roles/infrastructure/${r.slug}/`} class="card" style="padding: 0.75rem; margin-bottom: 0.5rem; text-decoration: none; display: block;">
              <strong style="font-size: 0.9rem;">{r.name}</strong>
            </a>
          )
        ))}
        <div style="margin-top: 1rem;">
          <a href={`${base}career-guide/roles/infrastructure/`} class="btn btn-gold" style="font-size: 0.8rem; padding: 0.4rem 0.8rem;">&larr; Infrastructure & Live Ops</a>
        </div>
      </aside>

      <div class="career-main">
        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>About this Role</h2>
          <p>Data scientists act as hidden detectives, wielding statistics and algorithms to unlock the secrets of player behavior. They delve into the vast ocean of in-game data, from clicks and purchases to level progression and engagement metrics, to uncover hidden patterns and insights. Armed with their analytical prowess, they craft predictive models to understand player motivations, optimize game mechanics, and personalize the experience for each individual.</p>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Salary Resources</h2>
          <div style="display: flex; flex-wrap: wrap; gap: 0.75rem;">
            {salaries.map((s) => (
              <a href={s.url} target="_blank" rel="noopener noreferrer" class="btn btn-blue" style="font-size: 0.85rem;">
                {s.name} &rarr;
              </a>
            ))}
          </div>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Key Responsibilities</h2>
          <ul>
            {responsibilities.map((r) => (
              <li>{r}</li>
            ))}
          </ul>
        </div>

        <RoleGuide slug="data-scientist" part="guide" />

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Learning Resources</h2>
          <ul>
            {resources.map((r) => (
              <li><a href={r.url} target="_blank" rel="noopener noreferrer">{r.name}</a></li>
            ))}
          </ul>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Recommended Books</h2>
          <ul>
            {books.map((b) => (
              <li><a href={b.url} target="_blank" rel="noopener noreferrer">{b.name}</a></li>
            ))}
          </ul>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Tools to Learn</h2>
          <div class="callout callout-info">
            <p>You don&#39;t need to learn all of these — they are some of the more common tools for this role.</p>
          </div>
          <div style="display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.75rem;">
            {tools.map((t) => (
              <span style="background: var(--color-bg); border: 1px solid var(--color-dark); border-radius: 4px; padding: 0.3rem 0.6rem; font-size: 0.85rem;">{t}</span>
            ))}
          </div>
        </div>

        <RoleGuide slug="data-scientist" part="faq" />
      </div>

      <aside class="career-sidebar">
        <h3>Quick Links</h3>
        <div class="card" style="padding: 1rem; margin-bottom: 0.75rem;">
          <strong>📋 Job Boards</strong>
          <p style="font-size: 0.85rem; margin-top: 0.35rem;">
            <a href={`${base}career-guide/job-boards/`}>Browse job boards &rarr;</a>
          </p>
        </div>
        <div class="card" style="padding: 1rem; margin-bottom: 0.75rem;">
          <strong>📚 Resources</strong>
          <p style="font-size: 0.85rem; margin-top: 0.35rem;">
            <a href={`${base}career-guide/resources/`}>Career resources &rarr;</a>
          </p>
        </div>
        <div class="card" style="padding: 1rem;">
          <strong>🎯 All Roles</strong>
          <p style="font-size: 0.85rem; margin-top: 0.35rem;">
            <a href={`${base}career-guide/roles/`}>View all disciplines &rarr;</a>
          </p>
        </div>
      </aside>
    </div>
  </WikiLayout>
</BaseLayout>