---
import BaseLayout from "../../../../../layouts/BaseLayout.astro";
import WikiLayout from "../../../../../layouts/WikiLayout.astro";
const base = import.meta.env.BASE_URL;

const salaries = [
  { name: "InGameJob", url: "https://ingamejob.com/en/salaries" },
  { name: "Glassdoor", url: "https://www.glassdoor.com/Salaries/live-ops-engineer-salary-SRCH_KO0,17.htm" },
  { name: "ZipRecruiter", url: "https://www.ziprecruiter.com/Salaries/Live-Ops-Engineer-Salary" }
];

const responsibilities = [
  "Ensure the game's online platform operates seamlessly, monitoring server health, performance metrics, and uptime.",
  "Implement game updates, patches, and new features efficiently, minimizing downtime and player disruption.",
  "Quickly diagnose and resolve technical issues, bugs, and crashes impacting players' experience.",
  "Collect and analyze player data to identify engagement trends, optimize systems, and inform future live operations decisions.",
  "Design and implement in-game events, challenges, and activities that retain players, drive engagement, and promote monetization.",
  "Continuously monitor and adjust game balance through data analysis and player feedback, ensuring a fair and rewarding experience.",
  "React quickly to evolving player needs and industry trends, adjusting live operations plans to maximize player satisfaction and engagement.",
  "Develop automation tools and scripts to streamline routine tasks and explore new technologies to improve live operations efficiency."
];

const resources = [
  { name: "Understanding Live Ops for Video Games", url: "https://machinations.io/articles/understanding-live-ops-for-video-games" },
  { name: "Here is Everything You Need to Know About Mobile Game LiveOps by Ratic", url: "https://www.linkedin.com/pulse/here-everything-you-need-know-mobile-game-liveops-ratic/" },
  { name: "What is Live Ops: An Introduction to the Basics of Live Game Operations", url: "https://azumo.com/insights/what-is-liveops-an-introduction-to-the-basics-of-live-game-operations" },
  { name: "LiveOps: The Strategic Artform of Successful Games", url: "https://www.blog.udonis.co/mobile-marketing/mobile-games/liveops" },
  { name: "The Ultimate LiveOps Guide For Game Developers by Pubscale", url: "https://medium.com/@pubscale/the-ultimate-liveops-guide-for-game-developers-1fc6781310f2" },
  { name: "A Full Guide to LiveOps in Games 2024", url: "https://splitmetrics.com/blog/a-full-guide-to-liveops-in-games-2024/" },
  { name: "The Definitive Guide to LiveOps in 2024 by Mike Moran", url: "https://blog.userwise.io/blog/maximizing-player-value-a-comprehensive-guide-to-mobile-game-liveops" },
  { name: "Liveops tools: The Best Guide for Game Developers by Sukanya VS", url: "https://pubscale.com/blog/liveops-games-guide" },
  { name: "LiveOps 101: A Survival Guide for Game Operations by Andrew Munden", url: "https://es.slideshare.net/jessicatams1/liveops-101-andrew-munden" }
];

const books = [
  { name: "The Phoenix Project: A Novel about IT, DevOps, and Helping Your Business Win by Gene Kim, Kevin Behr and George Spafford", url: "https://www.amazon.com/Phoenix-Project-DevOps-Helping-Business/dp/0988262592" },
  { name: "The DevOps Handbook: How to Create World-Class Agility, Reliability, & Security in Technology Organizations by Gene Kim, Jez Humble, Patrick Debois, John Willis and Nicole Forsgren", url: "https://www.amazon.com/DevOps-Handbook-World-Class-Reliability-Organizations/dp/1950508404/" },
  { name: "Site Reliability Engineering: How Google Runs Production Systems by Jennifer Petoff, Niall Murphy, Betsy Beyer and Chris Jones", url: "https://www.amazon.com/Site-Reliability-Engineering-Production-Systems/dp/149192912X/" },
  { name: "Game Engine Architecture by Jason Gregory", url: "https://www.amazon.com/Engine-Architecture-Third-Jason-Gregory/dp/1138035459" },
  { name: "Data Science for Business: What You Need to Know about Data Mining and Data-Analytic Thinking by Foster Provost and Tom Fawcett", url: "https://www.amazon.in/Data-Science-Business-Data-Analytic-Thinking-ebook/dp/B00E6EQ3X4" },
  { name: "This Is Service Design Doing: Applying Service Design Thinking in the Real World by Marc Stickdorn, Markus Hormess and Adam Lawrence", url: "https://www.amazon.com/This-Service-Design-Doing-Successful/dp/1491927186" },
  { name: "Hooked: How to Build Habit-Forming Products by Nir Eyal and Ryan Hoover", url: "https://www.amazon.com/Hooked-How-Build-Habit-Forming-Products/dp/1591847788" }
];

const tools = [
  "Game Engines",
  "Git",
  "Jenkins",
  "Datadog",
  "Splunk",
  "Grafana",
  "Tableau",
  "Power BI",
  "Python",
  "SQL",
  "Excel",
  "Google Analytics",
  "Firebase",
  "Unity Analytics",
  "PlayFab",
  "GameAnalytics"
];

const sidebarRoles = [
  { name: "LiveOps Engineer", slug: "liveops-engineer", current: true },
  { name: "Data Analyst", slug: "data-analyst", current: false },
  { name: "Customer Support Specialist", slug: "customer-support-specialist", current: false },
  { name: "Data Scientist", slug: "data-scientist", current: false }
];
---

<BaseLayout title="LiveOps Engineer" activeNav="career-guide">
  <WikiLayout title="LiveOps Engineer" activeNav="career-guide" activeSidebar="roles">
    <div class="career-layout">
      <aside class="career-sidebar">
        <h3>Infrastructure & Live Ops Roles</h3>
        {sidebarRoles.map((r) => (
          r.current ? (
            <div class="card" style="padding: 0.75rem; margin-bottom: 0.5rem; border-left: 3px solid var(--color-pink);">
              <strong style="font-size: 0.9rem; color: var(--color-pink);">{r.name}</strong>
            </div>
          ) : (
            <a href={`${base}career-guide/roles/infrastructure/${r.slug}/`} class="card" style="padding: 0.75rem; margin-bottom: 0.5rem; text-decoration: none; display: block;">
              <strong style="font-size: 0.9rem;">{r.name}</strong>
            </a>
          )
        ))}
        <div style="margin-top: 1rem;">
          <a href={`${base}career-guide/roles/infrastructure/`} class="btn btn-gold" style="font-size: 0.8rem; padding: 0.4rem 0.8rem;">&larr; Infrastructure & Live Ops</a>
        </div>
      </aside>

      <div class="career-main">
        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>About this Role</h2>
          <p>LiveOps Engineers are constantly adapting and improving the world after launch. They rely on transforming data into engaging experiences, analyzing player behavior, tweaking in-game systems, and rolling out fresh content, all to keep players hooked and the game thriving. Their days are filled with monitoring player behavior, analyzing performance metrics, and deploying updates that refine in-game systems, introduce new events and challenges, and balance gameplay elements. They work closely with developers, designers, and marketers, constantly iterating and evolving the game to keep players hooked and coming back for more.</p>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Salary Resources</h2>
          <div style="display: flex; flex-wrap: wrap; gap: 0.75rem;">
            {salaries.map((s) => (
              <a href={s.url} target="_blank" rel="noopener noreferrer" class="btn btn-blue" style="font-size: 0.85rem;">
                {s.name} &rarr;
              </a>
            ))}
          </div>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Key Responsibilities</h2>
          <ul>
            {responsibilities.map((r) => (
              <li>{r}</li>
            ))}
          </ul>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Learning Resources</h2>
          <ul>
            {resources.map((r) => (
              <li><a href={r.url} target="_blank" rel="noopener noreferrer">{r.name}</a></li>
            ))}
          </ul>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Recommended Books</h2>
          <ul>
            {books.map((b) => (
              <li><a href={b.url} target="_blank" rel="noopener noreferrer">{b.name}</a></li>
            ))}
          </ul>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Tools to Learn</h2>
          <div class="callout callout-info">
            <p>You don&#39;t need to learn all of these — they are some of the more common tools for this role.</p>
          </div>
          <div style="display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.75rem;">
            {tools.map((t) => (
              <span style="background: var(--color-bg); border: 1px solid var(--color-dark); border-radius: 4px; padding: 0.3rem 0.6rem; font-size: 0.85rem;">{t}</span>
            ))}
          </div>
        </div>
      </div>

      <aside class="career-sidebar">
        <h3>Quick Links</h3>
        <div class="card" style="padding: 1rem; margin-bottom: 0.75rem;">
          <strong>📋 Job Boards</strong>
          <p style="font-size: 0.85rem; margin-top: 0.35rem;">
            <a href={`${base}career-guide/job-boards/`}>Browse job boards &rarr;</a>
          </p>
        </div>
        <div class="card" style="padding: 1rem; margin-bottom: 0.75rem;">
          <strong>📚 Resources</strong>
          <p style="font-size: 0.85rem; margin-top: 0.35rem;">
            <a href={`${base}career-guide/resources/`}>Career resources &rarr;</a>
          </p>
        </div>
        <div class="card" style="padding: 1rem;">
          <strong>🎯 All Roles</strong>
          <p style="font-size: 0.85rem; margin-top: 0.35rem;">
            <a href={`${base}career-guide/roles/`}>View all disciplines &rarr;</a>
          </p>
        </div>
      </aside>
    </div>
  </WikiLayout>
</BaseLayout>