---
import BaseLayout from "../../../../../layouts/BaseLayout.astro";
import WikiLayout from "../../../../../layouts/WikiLayout.astro";
import RoleGuide from "../../../../../components/RoleGuide.astro";
const base = import.meta.env.BASE_URL;

const salaries = [
  { name: "InGameJob", url: "https://ingamejob.com/en/salaries" },
  { name: "Glassdoor", url: "https://www.glassdoor.com/Salaries/game-publishing-specialist-salary-SRCH_KO0,26.htm" },
  { name: "ZipRecruiter", url: "https://www.ziprecruiter.com/Salaries/Game-Publisher-Salary#Yearly" }
];

const responsibilities = [
  "Analyze market trends and data, identifying platforms, genres, and audiences with high potential for the studio's games.",
  "Scout and evaluate pitches, builds, and budgets from developers to decide which games are worth signing.",
  "Negotiate publishing deals, including funding, revenue share, recoupment, and IP terms, and manage contracts with developers and partners.",
  "Navigate distribution channels, choose platforms for release, and optimize pricing strategies to maximize game reach and profitability.",
  "Collaborate with marketing teams on launch campaigns, crafting effective messaging and strategies to build hype and drive player acquisition.",
  "Support developer partners through production, tracking milestones, budgets, and risks so the game ships on time.",
  "Analyze player data and feedback, translating insights into actionable plans for post-launch live operations and improvements.",
  "Coordinate QA, localization, ratings, and platform certification so the game is ready for each storefront.",
  "Research industry trends to guide which genres, platforms, and developers the publisher invests in next."
];

const resources = [
  { name: "ScreenSkills’ Games Publisher Profile", url: "https://screenskills.com/job-profiles/roles/games-publisher" },
  { name: "Trend watch: the rise of 'publisher as a service'?", url: "https://www.gamedeveloper.com/business/trend-watch-the-rise-of-publisher-as-a-service" },
  { name: "What Is Game Publishing? (Definition, Duties and Companies)", url: "https://www.indeed.com/career-advice/career-development/what-is-game-publishing" },
  { name: "The 6 Blogs Every Mobile Game Publisher Needs To Bookmark", url: "https://tenjin.com/blog/the-6-blogs-every-mobile-game-publisher-needs-to-bookmark/" },
  { name: "How To Market A Game by Chris Zukowski", url: "https://howtomarketagame.com/" },
  { name: "GameDiscoverCo Newsletter by Simon Carless (free tier)", url: "https://newsletter.gamediscover.co/" }
];

const books = [
  { name: "The Publishing Challenge for Independent Video Game Developers: A Practical Guide by Odile Limpach", url: "https://www.amazon.com/Publishing-Challenge-Independent-Video-Developers-ebook/dp/B084HMT546" },
  { name: "The Art of Game Design: A Book of Lenses (3rd Edition) by Jesse Schell", url: "https://www.amazon.com/dp/1138632058" },
  { name: "One Up: Creativity, Competition, and the Global Business of Video Games by Joost van Dreunen", url: "https://www.amazon.com/One-Up-Creativity-Competition-Business/dp/0231197527" }
];

const tools = [
  "Game Engines",
  "Jira",
  "Confluence",
  "Discord",
  "AppFollow",
  "Microsoft Excel",
  "Tableau",
  "Power BI",
  "SQL",
  "Steamworks",
  "Sensor Tower"
];

const sidebarRoles = [
  { name: "Game Producer", slug: "game-producer", current: false },
  { name: "Executive Producer", slug: "executive-producer", current: false },
  { name: "Publisher", slug: "publisher", current: true },
  { name: "Project Manager", slug: "project-manager", current: false },
  { name: "Operations Manager", slug: "operations-manager", current: false }
];
---

<BaseLayout title="How to Become a Publisher in Games: Career Path & Skills" description="How to become a Publisher in the game industry: step-by-step career path, key skills, what to show employers, salary resources, tools to learn, and FAQs." activeNav="career-guide">
  <WikiLayout title="Publisher" activeNav="career-guide" activeSidebar="roles">
    <div class="career-layout">
      <aside class="career-sidebar">
        <h3>Production Roles</h3>
        {sidebarRoles.map((r) => (
          r.current ? (
            <div class="card" style="padding: 0.75rem; margin-bottom: 0.5rem; border-left: 3px solid var(--color-pink);">
              <strong style="font-size: 0.9rem; color: var(--color-pink);">{r.name}</strong>
            </div>
          ) : (
            <a href={`${base}career-guide/roles/production/${r.slug}/`} class="card" style="padding: 0.75rem; margin-bottom: 0.5rem; text-decoration: none; display: block;">
              <strong style="font-size: 0.9rem;">{r.name}</strong>
            </a>
          )
        ))}
        <div style="margin-top: 1rem;">
          <a href={`${base}career-guide/roles/production/`} class="btn btn-gold" style="font-size: 0.8rem; padding: 0.4rem 0.8rem;">&larr; Production</a>
        </div>
      </aside>

      <div class="career-main">
        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>About this Role</h2>
          <p>In games, a publisher is the company that helps a developer get a game to players, and publishing roles are the people who do that work. Titles include publishing producer, publishing manager, and publishing executive. They scout and evaluate games, negotiate deals, and often fund development. They then coordinate marketing, QA, localization, platform submissions, and release timing with the developer. A good publishing team lets developers focus on making the game while the publisher handles much of the business of getting it noticed and sold.</p>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Salary Resources</h2>
          <div style="display: flex; flex-wrap: wrap; gap: 0.75rem;">
            {salaries.map((s) => (
              <a href={s.url} target="_blank" rel="noopener noreferrer" class="btn btn-blue" style="font-size: 0.85rem;">
                {s.name} &rarr;
              </a>
            ))}
          </div>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Key Responsibilities</h2>
          <ul>
            {responsibilities.map((r) => (
              <li>{r}</li>
            ))}
          </ul>
        </div>

        <RoleGuide slug="publisher" part="guide" />

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Learning Resources</h2>
          <ul>
            {resources.map((r) => (
              <li><a href={r.url} target="_blank" rel="noopener noreferrer">{r.name}</a></li>
            ))}
          </ul>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Recommended Books</h2>
          <ul>
            {books.map((b) => (
              <li><a href={b.url} target="_blank" rel="noopener noreferrer">{b.name}</a></li>
            ))}
          </ul>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Tools to Learn</h2>
          <div class="callout callout-info">
            <p>You don&#39;t need to learn all of these — they are some of the more common tools for this role.</p>
          </div>
          <div style="display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.75rem;">
            {tools.map((t) => (
              <span style="background: var(--color-bg); border: 1px solid var(--color-dark); border-radius: 4px; padding: 0.3rem 0.6rem; font-size: 0.85rem;">{t}</span>
            ))}
          </div>
        </div>

        <RoleGuide slug="publisher" part="faq" />
      </div>

      <aside class="career-sidebar">
        <h3>Quick Links</h3>
        <div class="card" style="padding: 1rem; margin-bottom: 0.75rem;">
          <strong>📋 Job Boards</strong>
          <p style="font-size: 0.85rem; margin-top: 0.35rem;">
            <a href={`${base}career-guide/job-boards/`}>Browse job boards &rarr;</a>
          </p>
        </div>
        <div class="card" style="padding: 1rem; margin-bottom: 0.75rem;">
          <strong>📚 Resources</strong>
          <p style="font-size: 0.85rem; margin-top: 0.35rem;">
            <a href={`${base}career-guide/resources/`}>Career resources &rarr;</a>
          </p>
        </div>
        <div class="card" style="padding: 1rem;">
          <strong>🎯 All Roles</strong>
          <p style="font-size: 0.85rem; margin-top: 0.35rem;">
            <a href={`${base}career-guide/roles/`}>View all disciplines &rarr;</a>
          </p>
        </div>
      </aside>
    </div>
  </WikiLayout>
</BaseLayout>