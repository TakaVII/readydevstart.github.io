---
import BaseLayout from "../../../../../layouts/BaseLayout.astro";
import WikiLayout from "../../../../../layouts/WikiLayout.astro";
import RoleGuide from "../../../../../components/RoleGuide.astro";
const base = import.meta.env.BASE_URL;

const salaries = [
  { name: "InGameJob", url: "https://ingamejob.com/en/salaries" },
  { name: "Glassdoor", url: "https://www.glassdoor.com/Salaries/executive-producer-salary-SRCH_KO0,18.htm" },
  { name: "Salary.com", url: "https://www.salary.com/research/salary/listing/executive-producer-salary" },
  { name: "ZipRecruiter", url: "https://www.ziprecruiter.com/Salaries/Executive-Producer-Salary#Yearly" }
];

const responsibilities = [
  "Guide the game's overall direction, setting high-level goals and ensuring it aligns with the studio's strategic vision.",
  "Evaluate game proposals, make final development decisions, and champion passion projects with potential.",
  "Allocate resources across multiple projects, prioritizing funding and talent to maximize studio output and success.",
  "Secure external investments, negotiate major deals, and oversee financial health of the studio and individual projects.",
  "Attract and retain top talent, fostering a creative and inspiring environment for developers to thrive.",
  "Identify and mitigate potential risks, making strategic decisions to ensure project viability and long-term success.",
  "Protect the studio's reputation and game brands, managing public perception and navigating industry challenges.",
  "Represent the studio at industry events, build relationships with partners, and influence the broader gaming landscape.",
  "Predict industry trends, identify new platforms and opportunities, and guide the studio's long-term vision for game development."
];

const resources = [
  { name: "5 Types of Game Production Meetings by Noble Steed Games", url: "https://www.linkedin.com/pulse/5-types-game-production-meetings-noble-steed-games/" },
  { name: "An introduction to video game production", url: "https://www.gamesindustry.biz/an-introduction-to-video-game-production" },
  { name: "What does a Senior Producer in games do? by Into Games", url: "https://intogames.org/news/how-do-you-become-a-senior-producer-for-videogames" },
  { name: "GameDiscoverCo Newsletter by Simon Carless (free tier)", url: "https://newsletter.gamediscover.co/" },
  { name: "Naavik: games business analysis, newsletter, and podcast", url: "https://naavik.co/" }
];

const books = [
  { name: "Hooked: How to Build Habit-Forming Products by Nir Eyal", url: "https://www.amazon.com/Hooked-How-Build-Habit-Forming-Products/dp/1591847788" },
  { name: "Game Thinking: Innovate smarter & drive deep engagement with design techniques from hit games by Amy Jo Kim", url: "https://www.amazon.com/Game-Thinking-Innovate-engagement-techniques/dp/099978854X" },
  { name: "The Lean Startup: How Today's Entrepreneurs Use Continuous Innovation to Create Radically Successful Businesses by Eric Ries", url: "https://www.amazon.com/Lean-Startup-Entrepreneurs-Continuous-Innovation/dp/0670921602" },
  { name: "Remote Not Distant: Design a Company Culture That Will Help You Thrive in a Hybrid Workplace by Gustavo Razzetti", url: "https://www.amazon.com/Remote-Not-Distant-Company-Workplace/dp/0999097393" },
  { name: "Start with Why Series by Simon Sinek, David Mead and Peter Docker", url: "https://www.amazon.com/dp/B07VVJF819" },
  { name: "The Game Production Toolbox by Heather Maxwell Chandler", url: "https://www.amazon.com/Production-Toolbox-Heather-Maxwell-Chandler-ebook/dp/B086XLC7RY" },
  { name: "One Up: Creativity, Competition, and the Global Business of Video Games by Joost van Dreunen", url: "https://www.amazon.com/One-Up-Creativity-Competition-Business/dp/0231197527" },
  { name: "Creativity, Inc.: Overcoming the Unseen Forces That Stand in the Way of True Inspiration by Ed Catmull and Amy Wallace", url: "https://www.amazon.com/dp/0812993012" },
  { name: "Blood, Sweat, and Pixels: The Triumphant, Turbulent Stories Behind How Video Games Are Made by Jason Schreier", url: "https://www.amazon.com/Blood-Sweat-Pixels-Triumphant-Turbulent-ebook/dp/B01NAKSWW1" }
];

const tools = [
  "Game Engines",
  "Jira",
  "Perforce",
  "Confluence",
  "Excel",
  "PowerPoint",
  "Gantt Chart Software",
  "Discord",
  "Trello",
  "Zoom",
  "Microsoft Teams",
  "LinkedIn Sales Navigator"
];

const sidebarRoles = [
  { name: "Game Producer", slug: "game-producer", current: false },
  { name: "Executive Producer", slug: "executive-producer", current: true },
  { name: "Publisher", slug: "publisher", current: false },
  { name: "Project Manager", slug: "project-manager", current: false },
  { name: "Operations Manager", slug: "operations-manager", current: false }
];
---

<BaseLayout title="How to Become an Executive Producer in Games: Career Path & Skills" description="How to become an Executive Producer in the game industry: step-by-step career path, key skills, what to show employers, salary resources, tools to learn, and FAQs." activeNav="career-guide">
  <WikiLayout title="Executive Producer" activeNav="career-guide" activeSidebar="roles">
    <div class="career-layout">
      <aside class="career-sidebar">
        <h3>Production Roles</h3>
        {sidebarRoles.map((r) => (
          r.current ? (
            <div class="card" style="padding: 0.75rem; margin-bottom: 0.5rem; border-left: 3px solid var(--color-pink);">
              <strong style="font-size: 0.9rem; color: var(--color-pink);">{r.name}</strong>
            </div>
          ) : (
            <a href={`${base}career-guide/roles/production/${r.slug}/`} class="card" style="padding: 0.75rem; margin-bottom: 0.5rem; text-decoration: none; display: block;">
              <strong style="font-size: 0.9rem;">{r.name}</strong>
            </a>
          )
        ))}
        <div style="margin-top: 1rem;">
          <a href={`${base}career-guide/roles/production/`} class="btn btn-gold" style="font-size: 0.8rem; padding: 0.4rem 0.8rem;">&larr; Production</a>
        </div>
      </aside>

      <div class="career-main">
        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>About this Role</h2>
          <p>The Executive Producer in the game industry sits at the apex of a game's development, a strategic leader rather than a day-to-day manager. They are the visionaries, guiding the overall direction and ensuring the game aligns with market trends and studio goals. Think of them as the grand architects, shaping the game's concept, securing funding, and making key decisions that impact its core identity. They oversee multiple projects, setting high-level goals and delegating tasks to Game Producers. Through their experience, they bridge the gap between creative ambitions and business realities.</p>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Salary Resources</h2>
          <div style="display: flex; flex-wrap: wrap; gap: 0.75rem;">
            {salaries.map((s) => (
              <a href={s.url} target="_blank" rel="noopener noreferrer" class="btn btn-blue" style="font-size: 0.85rem;">
                {s.name} &rarr;
              </a>
            ))}
          </div>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Key Responsibilities</h2>
          <ul>
            {responsibilities.map((r) => (
              <li>{r}</li>
            ))}
          </ul>
        </div>

        <RoleGuide slug="executive-producer" part="guide" />

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Learning Resources</h2>
          <ul>
            {resources.map((r) => (
              <li><a href={r.url} target="_blank" rel="noopener noreferrer">{r.name}</a></li>
            ))}
          </ul>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Recommended Books</h2>
          <ul>
            {books.map((b) => (
              <li><a href={b.url} target="_blank" rel="noopener noreferrer">{b.name}</a></li>
            ))}
          </ul>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Tools to Learn</h2>
          <div class="callout callout-info">
            <p>You don&#39;t need to learn all of these — they are some of the more common tools for this role.</p>
          </div>
          <div style="display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.75rem;">
            {tools.map((t) => (
              <span style="background: var(--color-bg); border: 1px solid var(--color-dark); border-radius: 4px; padding: 0.3rem 0.6rem; font-size: 0.85rem;">{t}</span>
            ))}
          </div>
        </div>

        <RoleGuide slug="executive-producer" part="faq" />
      </div>

      <aside class="career-sidebar">
        <h3>Quick Links</h3>
        <div class="card" style="padding: 1rem; margin-bottom: 0.75rem;">
          <strong>📋 Job Boards</strong>
          <p style="font-size: 0.85rem; margin-top: 0.35rem;">
            <a href={`${base}career-guide/job-boards/`}>Browse job boards &rarr;</a>
          </p>
        </div>
        <div class="card" style="padding: 1rem; margin-bottom: 0.75rem;">
          <strong>📚 Resources</strong>
          <p style="font-size: 0.85rem; margin-top: 0.35rem;">
            <a href={`${base}career-guide/resources/`}>Career resources &rarr;</a>
          </p>
        </div>
        <div class="card" style="padding: 1rem;">
          <strong>🎯 All Roles</strong>
          <p style="font-size: 0.85rem; margin-top: 0.35rem;">
            <a href={`${base}career-guide/roles/`}>View all disciplines &rarr;</a>
          </p>
        </div>
      </aside>
    </div>
  </WikiLayout>
</BaseLayout>