---
import BaseLayout from "../../../../../layouts/BaseLayout.astro";
import WikiLayout from "../../../../../layouts/WikiLayout.astro";
import RoleGuide from "../../../../../components/RoleGuide.astro";
const base = import.meta.env.BASE_URL;

const salaries = [
  { name: "InGameJob", url: "https://ingamejob.com/en/salaries" },
  { name: "Glassdoor", url: "https://www.glassdoor.com/Salaries/operations-manager-salary-SRCH_KO0,18.htm" },
  { name: "Salary.com", url: "https://www.salary.com/research/salary/position/game-operations-manager-salary" },
  { name: "ZipRecruiter", url: "https://www.ziprecruiter.com/Salaries/Operations-Manager-Salary#Yearly" }
];

const responsibilities = [
  "Design and implement post-launch live operations plans, including events, content updates, and player engagement strategies.",
  "Analyze player data and feedback, identify trends and pain points, and translate insights into actionable improvements for the game.",
  "Foster a healthy and vibrant community, manage communication channels, address player concerns, and build brand loyalty.",
  "Optimize in-game economies and monetization systems, ensuring fairness, profitability, and alignment with player expectations.",
  "Manage and schedule in-game content releases, ensuring a steady stream of engaging activities and experiences for players.",
  "Address player issues and reports promptly, troubleshoot technical problems, and ensure a smooth and enjoyable player experience.",
  "Track key performance indicators (KPIs) related to live operations, analyze performance, and recommend adjustments to optimize player engagement and retention.",
  "Collaborate with marketing teams on live ops campaigns, promote new content and updates, and drive player engagement through targeted messaging.",
  "Manage relationships with external partners, negotiate deals for in-game collaborations and promotions, and use partnerships to enhance the player experience."
];

const resources = [
  { name: "What Is Game LiveOps? by Heroic Labs", url: "https://heroiclabs.com/blog/what-is-game-liveops/" },
  { name: "What is live ops and why should you care? by PocketGamer.biz", url: "https://www.pocketgamer.biz/what-is-live-ops-and-why-should-you-care/" },
  { name: "Deconstructor of Fun: free-to-play game breakdowns and podcast", url: "https://www.deconstructoroffun.com/" },
  { name: "What does a Chief Operating Officer in games do? by Into Games", url: "https://intogames.org/news/how-do-you-become-a-chief-operating-officer-for-videogames" }
];

const books = [
  { name: "The Game Production Toolbox by Heather Maxwell Chandler", url: "https://www.amazon.com/Production-Toolbox-Heather-Maxwell-Chandler-ebook/dp/B086XLC7RY" },
  { name: "One Up: Creativity, Competition, and the Global Business of Video Games by Joost van Dreunen", url: "https://www.amazon.com/One-Up-Creativity-Competition-Business/dp/0231197527" },
  { name: "Press Reset: Ruin and Recovery in the Video Game Industry by Jason Schreier", url: "https://www.amazon.com/Press-Reset-Recovery-Video-Industry/dp/B08NTTVPJS/" },
  { name: "The Dream Architects: Adventures in the Video Game Industry by David Polfeldt", url: "https://www.amazon.com/Dream-Architects-Adventures-Video-Industry/dp/B08FMVSFMR" },
  { name: "Free-to-Play: Making Money From Games You Give Away by Will Luton", url: "https://www.amazon.com/dp/0321919017" }
];

const tools = [
  "Game Engines",
  "Jira",
  "Confluence",
  "Discord",
  "PagerDuty",
  "Datadog",
  "Grafana",
  "Tableau",
  "Power BI",
  "SQL",
  "Azure PlayFab"
];

const sidebarRoles = [
  { name: "Game Producer", slug: "game-producer", current: false },
  { name: "Executive Producer", slug: "executive-producer", current: false },
  { name: "Publisher", slug: "publisher", current: false },
  { name: "Project Manager", slug: "project-manager", current: false },
  { name: "Operations Manager", slug: "operations-manager", current: true }
];
---

<BaseLayout title="How to Become an Operations Manager in Games: Career Path & Skills" description="How to become an Operations Manager in the game industry: step-by-step career path, key skills, what to show employers, salary resources, tools to learn, and FAQs." activeNav="career-guide">
  <WikiLayout title="Operations Manager" activeNav="career-guide" activeSidebar="roles">
    <div class="career-layout">
      <aside class="career-sidebar">
        <h3>Production Roles</h3>
        {sidebarRoles.map((r) => (
          r.current ? (
            <div class="card" style="padding: 0.75rem; margin-bottom: 0.5rem; border-left: 3px solid var(--color-pink);">
              <strong style="font-size: 0.9rem; color: var(--color-pink);">{r.name}</strong>
            </div>
          ) : (
            <a href={`${base}career-guide/roles/production/${r.slug}/`} class="card" style="padding: 0.75rem; margin-bottom: 0.5rem; text-decoration: none; display: block;">
              <strong style="font-size: 0.9rem;">{r.name}</strong>
            </a>
          )
        ))}
        <div style="margin-top: 1rem;">
          <a href={`${base}career-guide/roles/production/`} class="btn btn-gold" style="font-size: 0.8rem; padding: 0.4rem 0.8rem;">&larr; Production</a>
        </div>
      </aside>

      <div class="career-main">
        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>About this Role</h2>
          <p>An Operations Manager in the game industry keeps a live game running smoothly after launch. At many studios this job is called live operations (live ops) manager. They plan the schedule of events, content updates, and seasons, watch player data and server health, and coordinate the response when something breaks. They work with developers, community managers, and marketing teams to decide what goes live and when. They use metrics like retention and engagement to judge what's working and adjust the plan. Note that some studios also use "operations manager" for studio operations, such as facilities, budgets, and administration. That side of the job is closer to the Office/Studio Manager and COO roles.</p>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Salary Resources</h2>
          <div style="display: flex; flex-wrap: wrap; gap: 0.75rem;">
            {salaries.map((s) => (
              <a href={s.url} target="_blank" rel="noopener noreferrer" class="btn btn-blue" style="font-size: 0.85rem;">
                {s.name} &rarr;
              </a>
            ))}
          </div>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Key Responsibilities</h2>
          <ul>
            {responsibilities.map((r) => (
              <li>{r}</li>
            ))}
          </ul>
        </div>

        <RoleGuide slug="operations-manager" part="guide" />

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Learning Resources</h2>
          <ul>
            {resources.map((r) => (
              <li><a href={r.url} target="_blank" rel="noopener noreferrer">{r.name}</a></li>
            ))}
          </ul>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Recommended Books</h2>
          <ul>
            {books.map((b) => (
              <li><a href={b.url} target="_blank" rel="noopener noreferrer">{b.name}</a></li>
            ))}
          </ul>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Tools to Learn</h2>
          <div class="callout callout-info">
            <p>You don&#39;t need to learn all of these — they are some of the more common tools for this role.</p>
          </div>
          <div style="display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.75rem;">
            {tools.map((t) => (
              <span style="background: var(--color-bg); border: 1px solid var(--color-dark); border-radius: 4px; padding: 0.3rem 0.6rem; font-size: 0.85rem;">{t}</span>
            ))}
          </div>
        </div>

        <RoleGuide slug="operations-manager" part="faq" />
      </div>

      <aside class="career-sidebar">
        <h3>Quick Links</h3>
        <div class="card" style="padding: 1rem; margin-bottom: 0.75rem;">
          <strong>📋 Job Boards</strong>
          <p style="font-size: 0.85rem; margin-top: 0.35rem;">
            <a href={`${base}career-guide/job-boards/`}>Browse job boards &rarr;</a>
          </p>
        </div>
        <div class="card" style="padding: 1rem; margin-bottom: 0.75rem;">
          <strong>📚 Resources</strong>
          <p style="font-size: 0.85rem; margin-top: 0.35rem;">
            <a href={`${base}career-guide/resources/`}>Career resources &rarr;</a>
          </p>
        </div>
        <div class="card" style="padding: 1rem;">
          <strong>🎯 All Roles</strong>
          <p style="font-size: 0.85rem; margin-top: 0.35rem;">
            <a href={`${base}career-guide/roles/`}>View all disciplines &rarr;</a>
          </p>
        </div>
      </aside>
    </div>
  </WikiLayout>
</BaseLayout>