---
import BaseLayout from "../../../../../layouts/BaseLayout.astro";
import WikiLayout from "../../../../../layouts/WikiLayout.astro";
const base = import.meta.env.BASE_URL;

const salaries = [
  { name: "InGameJob", url: "https://ingamejob.com/en/salaries" },
  { name: "Glassdoor", url: "https://www.glassdoor.com/Salaries/game-producer-salary-SRCH_KO0,13.htm" },
  { name: "Salary.com", url: "https://www.salary.com/research/salary/recruiting/game-producer-salary" },
  { name: "ZipRecruiter", url: "https://www.ziprecruiter.com/Salaries/GAME-Producer-Salary#Yearly" }
];

const responsibilities = [
  "Shape the game's core experience, working with designers and directors to maintain focus and ensure cohesive execution.",
  "Craft and manage development budgets, allocating resources responsibly to optimize value and mitigate financial risks.",
  "Orchestrate development timelines, break down project milestones, and keep all departments on track for a smooth launch.",
  "Motivate and lead development teams, resolving conflicts, fostering collaboration, and ensuring everyone's well-being.",
  "Secure funding, negotiate contracts with external vendors and service providers, and manage partnerships effectively.",
  "Collaborate on marketing campaigns, identify target audiences, and shape the game's public image.",
  "Analyze playtesting and market research, translating insights into actionable improvements for the game.",
  "Champion high standards, prioritize bug fixes and polish, and ensure a polished final product.",
  "Oversee the game's release, manage post-launch operations, and respond to player feedback with agility."
];

const resources = [
  { name: "Into Games’ Associate Producer Database", url: "https://entrylevel.games/database/associate-producer" },
  { name: "The Cost-Effective Game Development", url: "https://www.argentics.io/the-cost-effective-game-development-a-capacious-guide" },
  { name: "How can Robust Resource Management Future Proof the Gaming Industry", url: "https://www.saviom.com/blog/how-can-robust-resource-management-future-proof-the-gaming-industry/" },
  { name: "Mastering the Art of Video Game Production", url: "https://www.yellowbrick.co/blog/entertainment/mastering-the-art-of-video-game-production" },
  { name: "5 Types of Game Production Meetings by Noble Steed Games", url: "https://www.linkedin.com/pulse/5-types-game-production-meetings-noble-steed-games/" },
  { name: "An introduction to video game production", url: "https://www.gamesindustry.biz/an-introduction-to-video-game-production" },
  { name: "ScreenSkills’ Game Producer Profile", url: "https://www.screenskills.com/job-profiles/browse/games/production/games-producer-games/" },
  { name: "Guidance for a Game Production Environment on AWS", url: "https://github.com/aws-solutions-library-samples/guidance-for-game-production-environment-on-aws" },
  { name: "Game Pre-Production Core Steps", url: "https://room8studio.com/news/game-pre-production-core-steps/" }
];

const books = [
  { name: "Production Pipeline Fundamentals for Film and Games by Renee Dunlop", url: "https://www.amazon.com/Production-Pipeline-Fundamentals-Film-Games/dp/0415812291/" },
  { name: "Hooked: How to Build Habit-Forming Products by Nir Eyal", url: "https://www.amazon.com/Hooked-How-Build-Habit-Forming-Products/dp/1591847788" },
  { name: "The Game Producer's Handbook by Dan Irish", url: "https://www.amazon.com/Game-Producers-Handbook-Dan-Irish/dp/1592006175/" },
  { name: "The Game Production Toolbox by Heather Maxwell Chandler", url: "https://www.amazon.com/Production-Toolbox-Heather-Maxwell-Chandler-ebook/dp/B086XLC7RY" },
  { name: "The Game Production Handbook by Heather Maxwell Chandler", url: "https://www.amazon.com/Production-Handbook-Heather-Maxwell-Chandler/dp/1449688098/" },
  { name: "Cinematic Game Secrets for Creative Directors and Producers: Inspired Techniques From Industry Legends by Rich Newman", url: "https://www.amazon.com/Cinematic-Secrets-Creative-Directors-Producers-ebook/dp/B0B838DMCF/" },
  { name: "A Playful Production Process: For Game Designers (and Everyone) by Richard Lemarchand", url: "https://www.amazon.com/Playful-Production-Process-Designers-Everyone/dp/0262045516/" },
  { name: "Game Production: Prototyping and Producing Your Board Game by Geoffrey Engelstein", url: "https://www.amazon.com/Game-Production-Prototyping-Producing-Board-ebook/dp/B08NC57B7T" },
  { name: "Game Thinking: Innovate smarter & drive deep engagement with design techniques from hit games by Amy Jo Kim", url: "https://www.amazon.com/Game-Thinking-Innovate-engagement-techniques/dp/099978854X" },
  { name: "The Art of Game Design: A Book of Lenses by Jesse Schell", url: "https://www.amazon.com/Art-Game-Design-Lenses-Second/dp/1466598646" },
  { name: "Reality Is Broken: Why Games Make Us Better and How They Can Change the World by Jane McGonigal", url: "https://www.amazon.com/Reality-Broken-Games-Better-Change-ebook/dp/B004G8Q1Q4" },
  { name: "Map It: The hands-on guide to strategic training design by Cathy Moore", url: "https://www.amazon.com/Map-hands-strategic-training-design/dp/0999174509/ref=m_crc_dp_lf_d_t1_d_sccl_2_5/142-8161820-1280056?pd_rd_w=klo4F&content-id=amzn1.sym.76a0b561-a7b4-41dc-9467-a85a2fa27c1c&pf_rd_p=76a0b561-a7b4-41dc-9467-a85a2fa27c1c&pf_rd_r=52FQK966YCW6P3QVE75E&pd_rd_wg=ks59c&pd_rd_r=c5d144c4-78a7-43fd-a2f8-d335349b8cca&pd_rd_i=0999174509&psc=1" },
  { name: "Start with Why Series by Simon Sinek, David Mead and Peter Docker", url: "https://www.amazon.com/dp/B07VVJF819" },
  { name: "Extra Lives: Why Video Games Matter by Tom Bissell", url: "https://www.amazon.com/Extra-Lives-Video-Games-Matter/dp/0307474313" }
];

const tools = [
  "Game Engines",
  "Jira",
  "Microsoft Excel",
  "Confluence",
  "Slack",
  "Perforce",
  "Git",
  "Subversion",
  "Adobe Photoshop",
  "Adobe Illustrator",
  "Unity Analytics",
  "Google Analytics",
  "Discord",
  "Trello",
  "Asana"
];

const sidebarRoles = [
  { name: "Game Producer", slug: "game-producer", current: true },
  { name: "Executive Producer", slug: "executive-producer", current: false },
  { name: "Publisher", slug: "publisher", current: false },
  { name: "Project Manager", slug: "project-manager", current: false },
  { name: "Operations Manager", slug: "operations-manager", current: false }
];
---

<BaseLayout title="Game Producer" activeNav="career-guide">
  <WikiLayout title="Game Producer" activeNav="career-guide" activeSidebar="roles">
    <div class="career-layout">
      <aside class="career-sidebar">
        <h3>Production Roles</h3>
        {sidebarRoles.map((r) => (
          r.current ? (
            <div class="card" style="padding: 0.75rem; margin-bottom: 0.5rem; border-left: 3px solid var(--color-pink);">
              <strong style="font-size: 0.9rem; color: var(--color-pink);">{r.name}</strong>
            </div>
          ) : (
            <a href={`${base}career-guide/roles/production/${r.slug}/`} class="card" style="padding: 0.75rem; margin-bottom: 0.5rem; text-decoration: none; display: block;">
              <strong style="font-size: 0.9rem;">{r.name}</strong>
            </a>
          )
        ))}
        <div style="margin-top: 1rem;">
          <a href={`${base}career-guide/roles/production/`} class="btn btn-gold" style="font-size: 0.8rem; padding: 0.4rem 0.8rem;">&larr; Production</a>
        </div>
      </aside>

      <div class="career-main">
        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>About this Role</h2>
          <p>A Game Producer serves as the conductor, harmonizing the diverse talents and efforts that bring a game to life. They are the orchestrators of the entire journey, from initial concept to polished launch, ensuring the vision unfolds smoothly and within budget. Their role demands both strategic oversight and hands-on execution. They work with designers, programmers, artists, and other specialists, setting goals, managing resources, and navigating challenges. They are the glue that binds the team, ensuring everyone is aligned, motivated, and delivering their best work. Ultimately, the Game Producer's success lies in their ability to shepherd the game through the development gauntlet, delivering a final product that resonates with players and fulfills the vision.</p>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Salary Resources</h2>
          <div style="display: flex; flex-wrap: wrap; gap: 0.75rem;">
            {salaries.map((s) => (
              <a href={s.url} target="_blank" rel="noopener noreferrer" class="btn btn-blue" style="font-size: 0.85rem;">
                {s.name} &rarr;
              </a>
            ))}
          </div>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Key Responsibilities</h2>
          <ul>
            {responsibilities.map((r) => (
              <li>{r}</li>
            ))}
          </ul>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Learning Resources</h2>
          <ul>
            {resources.map((r) => (
              <li><a href={r.url} target="_blank" rel="noopener noreferrer">{r.name}</a></li>
            ))}
          </ul>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Recommended Books</h2>
          <ul>
            {books.map((b) => (
              <li><a href={b.url} target="_blank" rel="noopener noreferrer">{b.name}</a></li>
            ))}
          </ul>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Tools to Learn</h2>
          <div class="callout callout-info">
            <p>You don&#39;t need to learn all of these — they are some of the more common tools for this role.</p>
          </div>
          <div style="display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.75rem;">
            {tools.map((t) => (
              <span style="background: var(--color-bg); border: 1px solid var(--color-dark); border-radius: 4px; padding: 0.3rem 0.6rem; font-size: 0.85rem;">{t}</span>
            ))}
          </div>
        </div>
      </div>

      <aside class="career-sidebar">
        <h3>Quick Links</h3>
        <div class="card" style="padding: 1rem; margin-bottom: 0.75rem;">
          <strong>📋 Job Boards</strong>
          <p style="font-size: 0.85rem; margin-top: 0.35rem;">
            <a href={`${base}career-guide/job-boards/`}>Browse job boards &rarr;</a>
          </p>
        </div>
        <div class="card" style="padding: 1rem; margin-bottom: 0.75rem;">
          <strong>📚 Resources</strong>
          <p style="font-size: 0.85rem; margin-top: 0.35rem;">
            <a href={`${base}career-guide/resources/`}>Career resources &rarr;</a>
          </p>
        </div>
        <div class="card" style="padding: 1rem;">
          <strong>🎯 All Roles</strong>
          <p style="font-size: 0.85rem; margin-top: 0.35rem;">
            <a href={`${base}career-guide/roles/`}>View all disciplines &rarr;</a>
          </p>
        </div>
      </aside>
    </div>
  </WikiLayout>
</BaseLayout>