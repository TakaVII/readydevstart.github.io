---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import WikiLayout from "../../../../layouts/WikiLayout.astro";
const base = import.meta.env.BASE_URL;

const roles = [
  { name: "Producer", description: "Owns the project schedule, budget, and scope — the glue that keeps the team on track." },
  { name: "Associate Producer", description: "Supports the lead producer with scheduling, documentation, and cross-team coordination." },
  { name: "Project Manager", description: "Manages day-to-day task tracking, sprint planning, and team velocity." },
  { name: "Scrum Master", description: "Facilitates agile ceremonies, removes blockers, and champions team process improvements." },
];
---

<BaseLayout title="Production Roles" activeNav="career-guide">
  <WikiLayout title="Production Roles" activeNav="career-guide" activeSidebar="roles">
    <p>
      Production roles keep game teams organized, on schedule, and focused.
      Producers and project managers are the backbone of every studio.
    </p>

    <div class="career-layout">
      <aside class="career-sidebar">
        <h3>Production Roles</h3>
        {roles.map((r) => (
          <div class="card" style="padding: 0.75rem; margin-bottom: 0.5rem;">
            <strong style="font-size: 0.9rem;">{r.name}</strong>
          </div>
        ))}
        <div style="margin-top: 1rem;">
          <a href={`${base}career-guide/roles/`} class="btn btn-gold" style="font-size: 0.8rem; padding: 0.4rem 0.8rem;">← All Roles</a>
        </div>
      </aside>

      <div class="career-main">
        {roles.map((role) => (
          <div class="card" style="margin-bottom: 1rem;">
            <h3>{role.name}</h3>
            <p>{role.description}</p>
          </div>
        ))}
      </div>

      <aside class="career-sidebar">
        <h3>Related</h3>
        <div class="card" style="padding: 1rem; margin-bottom: 0.75rem;">
          <p style="font-size: 0.85rem;">
            <a href={`${base}equipment/project-management/`}>PM Tools →</a>
          </p>
        </div>
        <div class="card" style="padding: 1rem;">
          <p style="font-size: 0.85rem;">
            <a href={`${base}career-guide/job-boards/`}>Job Boards →</a>
          </p>
        </div>
      </aside>
    </div>
  </WikiLayout>
</BaseLayout>
