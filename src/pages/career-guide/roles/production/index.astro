---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import WikiLayout from "../../../../layouts/WikiLayout.astro";
const base = import.meta.env.BASE_URL;

const roles = [
  { name: "Game Producer", slug: "game-producer", description: "A Game Producer serves as the conductor, harmonizing the diverse talents and efforts that bring a game to life." },
  { name: "Executive Producer", slug: "executive-producer", description: "The Executive Producer in the game industry sits at the apex of a game's development, a strategic leader rather than a day-to-day manager." },
  { name: "Publisher", slug: "publisher", description: "The Publisher acts as the bridge between creation and consumption." },
  { name: "Project Manager", slug: "project-manager", description: "A Project Manager’s main role is to ensure that every instrument plays its part in harmony." },
  { name: "Operations Manager", slug: "operations-manager", description: "An Operations Manager in the game industry is the engine behind the smooth running of a live game." }
];

const skills = [
  "Project Management",
  "Resource Allocation",
  "Scheduling and Planning",
  "Budgeting and Cost Management",
  "Risk Assessment and Mitigation",
  "Team Coordination",
  "Cross-Functional Collaboration",
  "Vendor Management",
  "Quality Control",
  "Process Improvement",
  "Timeline Management",
  "Communication and Documentation",
  "Problem-Solving",
  "Decision-Making",
  "Creative Brief Development",
  "Production Workflow Management",
  "Stakeholder Management",
  "Conflict Resolution",
  "Leadership",
  "Adaptability and Flexibility"
];

const courses = [
  { name: "+1 Wisdom Blog", url: "https://www.plusonewisdom.com/" }
];
---

<BaseLayout title="Production Roles" activeNav="career-guide">
  <WikiLayout title="Production Roles" activeNav="career-guide" activeSidebar="roles">
    <p>Production careers in the game industry involve overseeing the development process of video games from concept to completion. Production professionals coordinate and manage various aspects of game development, including scheduling, budgeting, resource allocation, and team coordination. They work closely with designers, artists, programmers, and other team members to ensure that projects are delivered on time and within budget. Production careers require strong organizational and communication skills, as well as the ability to problem-solve and make critical decisions.</p>

    <div class="career-layout">
      <aside class="career-sidebar">
        <h3>Production Roles</h3>
        {roles.map((r) => (
          <a href={`${base}career-guide/roles/production/${r.slug}/`} class="card" style="padding: 0.75rem; margin-bottom: 0.5rem; text-decoration: none; display: block;">
            <strong style="font-size: 0.9rem;">{r.name}</strong>
          </a>
        ))}
        <div style="margin-top: 1rem;">
          <a href={`${base}career-guide/roles/`} class="btn btn-gold" style="font-size: 0.8rem; padding: 0.4rem 0.8rem;">&larr; All Roles</a>
        </div>
      </aside>

      <div class="career-main">
        <div class="card-grid" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
          {roles.map((role) => (
            <a href={`${base}career-guide/roles/production/${role.slug}/`} class="card" style="text-decoration:none;">
              <h3>{role.name}</h3>
              <p>{role.description}</p>
              <span class="btn btn-pink" style="font-size: 0.8rem; padding: 0.3rem 0.6rem; margin-top: 0.5rem; display: inline-block;">View Role &rarr;</span>
            </a>
          ))}
        </div>

        <div class="card" style="margin-top: 1.5rem;">
          <h3>Skills Involved</h3>
          <div style="display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.75rem;">
            {skills.map((s) => (
              <span style="background: var(--clr-bg); border: 1px solid var(--clr-dark); border-radius: 4px; padding: 0.3rem 0.6rem; font-size: 0.85rem;">{s}</span>
            ))}
          </div>
        </div>

        <div class="card" style="margin-top: 1.5rem;">
          <h3>Courses &amp; Resources</h3>
          <ul>
            {courses.map((c) => (
              <li><a href={c.url} target="_blank" rel="noopener noreferrer">{c.name}</a></li>
            ))}
          </ul>
        </div>
      </div>

      <aside class="career-sidebar">
        <h3>Related</h3>
        <div class="card" style="padding: 1rem; margin-bottom: 0.75rem;">
          <p style="font-size: 0.85rem;">
            <a href={`${base}career-guide/roles/marketing/`}>📣 Marketing Roles &rarr;</a>
          </p>
        </div>
        <div class="card" style="padding: 1rem; margin-bottom: 0.75rem;">
          <p style="font-size: 0.85rem;">
            <a href={`${base}career-guide/roles/qa/`}>🔍 Quality Assurance Roles &rarr;</a>
          </p>
        </div>
        <div class="card" style="padding: 1rem;">
          <p style="font-size: 0.85rem;">
            <a href={`${base}career-guide/job-boards/`}>Job Boards &rarr;</a>
          </p>
        </div>
      </aside>
    </div>
  </WikiLayout>
</BaseLayout>