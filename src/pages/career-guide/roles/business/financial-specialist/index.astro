---
import BaseLayout from "../../../../../layouts/BaseLayout.astro";
import WikiLayout from "../../../../../layouts/WikiLayout.astro";
const base = import.meta.env.BASE_URL;

const salaries = [
  { name: "InGameJob", url: "https://ingamejob.com/en/salaries" },
  { name: "Glassdoor", url: "https://www.glassdoor.com/Salaries/us-financial-specialist-salary-SRCH_IL.0,2_IN1_KO3,23.htm" },
  { name: "Salary.com", url: "https://www.salary.com/research/salary/recruiting/financial-specialist-salary" },
  { name: "ZipRecruiter", url: "https://www.ziprecruiter.com/Salaries/Financial-Specialist-Salary#Yearly" }
];

const responsibilities = [
  "Forecast project costs, allocate resources effectively, track expenses, and monitor budget variance to ensure financial viability throughout development and live operations.",
  "Analyze financial data, prepare revenue forecasts, generate profitability reports, and present clear financial insights to inform decision-making across the studio.",
  "Evaluate and implement optimal monetization strategies for the game, including in-app purchases, subscriptions, DLCs, and other models, balancing player experience with revenue generation.",
  "Handle royalty calculations, payments, and contract compliance for intellectual property (IP) licenses, distribution deals, and other agreements.",
  "Ensure compliance with relevant tax regulations for game development and revenue streams, preparing tax returns and managing tax liabilities.",
  "Collaborate with game developers, marketing, and product teams to understand product features, pricing models, and potential impacts on financial performance.",
  "Analyze player purchase data, identify spending patterns, and optimize monetization systems to maximize revenue while maintaining a fair and engaging experience for players.",
  "Navigate currency fluctuations, handle foreign transactions, and manage currency risks associated with global game distribution and partnerships.",
  "Participate in financial audits, prepare required documentation, and answer investor inquiries during fundraising or potential acquisitions."
];

const resources = [
  { name: "Finance a gaming startup", url: "https://fastercapital.com/content/Finance-a-gaming-startup.html" },
  { name: "The legal landscape of gaming company financing rounds", url: "https://nordialaw.com/insights-financing-round-gaming-company/" },
  { name: "Money in the Game Industry by Michael Fitch", url: "https://www.linkedin.com/pulse/money-game-industry-michael-fitch/" },
  { name: "The Video Game Industry: Insights for Investors", url: "https://www.visualcapitalist.com/sp/video-games-industry-for-investors/" },
  { name: "The Expensive Video Game Problem", url: "https://fleximize.com/articles/002825/funding-for-the-gaming-industry" },
  { name: "Everything About Game Industry Investors and Funding", url: "https://rocketbrush.com/blog/game-industry-investors-and-funding" },
  { name: "Game Industry Financing: The Complete Guide", url: "https://finmodelslab.com/blogs/rising-capital/gaming-industry-rising-capital" },
  { name: "The current state of games investment by GamesIndustry.biz", url: "https://www.gamesindustry.biz/the-current-state-of-games-investment" },
  { name: "The Cost-Effective Game Development", url: "https://www.argentics.io/the-cost-effective-game-development-a-capacious-guide" },
  { name: "The Art of Budgets and Pixels: A Guide to Effective Financial Management in Game Studios and Production by Christopher Mifsud", url: "https://www.linkedin.com/pulse/art-budgets-pixels-guide-effective-financial-game-studios-mifsud-9qehe/" }
];

const books = [
  { name: "One Up: Creativity, Competition, and the Global Business of Video Games by Joost van Dreunen", url: "https://www.amazon.com/One-Up-Creativity-Competition-Business/dp/0231197527" },
  { name: "The Accounting Game: Learn the Basics of Financial Accounting by Darrell Mullis and Judith Orloff", url: "https://www.amazon.com/Accounting-Game-Basic-Fresh-Lemonade/dp/1402211864/" },
  { name: "Level Up! The Guide to Great Video Game Design by Scott Rogers", url: "https://www.amazon.com/Level-Guide-Great-Video-Design-dp-1118877160/dp/1118877160/" },
  { name: "Mobile App Marketing And Monetization: How To Promote Mobile Apps Like A Pro by Alex Genadinik", url: "https://www.amazon.com/Mobile-App-Marketing-Monetization-downloads/dp/1502383829" },
  { name: "Thinking in Bets: Making Smarter Decisions When You Don't Have All the Facts by Annie Duke", url: "https://www.amazon.com/Thinking-Bets-Making-Smarter-Decisions-ebook/dp/B074DG9LQF" },
  { name: "The Missing Billionaires: A Guide to Better Financial Decisions by Victor Haghani and James White", url: "https://www.amazon.com/Missing-Billionaires-Better-Financial-Decisions-ebook/dp/B0CGW16YC4/" }
];

const tools = [
  "Unity Cloud Build",
  "Unreal Engine Analytics",
  "Steamworks",
  "App Annie",
  "Google Play Developer Console",
  "Perforce",
  "Tableau",
  "Power BI",
  "Microsoft Excel",
  "Xero",
  "QuickBooks",
  "Stripe",
  "AWS Cost Explorer"
];

const sidebarRoles = [
  { name: "Product Manager", slug: "product-manager", current: false },
  { name: "Business Development Executive", slug: "business-development-executive", current: false },
  { name: "User Acquisition Specialist", slug: "user-acquisition-specialist", current: false },
  { name: "Specialist Lawyer", slug: "specialist-lawyer", current: false },
  { name: "Human Resources Specialist", slug: "human-resources-specialist", current: false },
  { name: "Financial Specialist", slug: "financial-specialist", current: true },
  { name: "Office/Studio Manager", slug: "office-studio-manager", current: false }
];
---

<BaseLayout title="Financial Specialist" activeNav="career-guide">
  <WikiLayout title="Financial Specialist" activeNav="career-guide" activeSidebar="roles">
    <div class="career-layout">
      <aside class="career-sidebar">
        <h3>Business Roles</h3>
        {sidebarRoles.map((r) => (
          r.current ? (
            <div class="card" style="padding: 0.75rem; margin-bottom: 0.5rem; border-left: 3px solid var(--clr-pink);">
              <strong style="font-size: 0.9rem; color: var(--clr-pink);">{r.name}</strong>
            </div>
          ) : (
            <a href={`${base}career-guide/roles/business/${r.slug}/`} class="card" style="padding: 0.75rem; margin-bottom: 0.5rem; text-decoration: none; display: block;">
              <strong style="font-size: 0.9rem;">{r.name}</strong>
            </a>
          )
        ))}
        <div style="margin-top: 1rem;">
          <a href={`${base}career-guide/roles/business/`} class="btn btn-gold" style="font-size: 0.8rem; padding: 0.4rem 0.8rem;">&larr; Business</a>
        </div>
      </aside>

      <div class="career-main">
        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>About this Role</h2>
          <p>Financial Specialists are the budget architects and money navigators, ensuring studios spend wisely, maximize revenue, and keep the game financially afloat. Their magic bag of tricks includes analyzing budgets, forecasting revenue, securing funding, managing investments, and tracking metrics like a hawk. They negotiate with publishers, optimize spending, and identify new revenue streams, like in-app purchases or esports sponsorships. Ultimately, they ensure the game's financial sustainability, paving the way for creative freedom and long-term success.</p>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Salary Resources</h2>
          <div style="display: flex; flex-wrap: wrap; gap: 0.75rem;">
            {salaries.map((s) => (
              <a href={s.url} target="_blank" rel="noopener noreferrer" class="btn btn-blue" style="font-size: 0.85rem;">
                {s.name} &rarr;
              </a>
            ))}
          </div>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Key Responsibilities</h2>
          <ul>
            {responsibilities.map((r) => (
              <li>{r}</li>
            ))}
          </ul>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Learning Resources</h2>
          <ul>
            {resources.map((r) => (
              <li><a href={r.url} target="_blank" rel="noopener noreferrer">{r.name}</a></li>
            ))}
          </ul>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Recommended Books</h2>
          <ul>
            {books.map((b) => (
              <li><a href={b.url} target="_blank" rel="noopener noreferrer">{b.name}</a></li>
            ))}
          </ul>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Tools to Learn</h2>
          <div class="callout callout-info">
            <p>You don&#39;t need to learn all of these — they are some of the more common tools for this role.</p>
          </div>
          <div style="display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.75rem;">
            {tools.map((t) => (
              <span style="background: var(--clr-bg); border: 1px solid var(--clr-dark); border-radius: 4px; padding: 0.3rem 0.6rem; font-size: 0.85rem;">{t}</span>
            ))}
          </div>
        </div>
      </div>

      <aside class="career-sidebar">
        <h3>Quick Links</h3>
        <div class="card" style="padding: 1rem; margin-bottom: 0.75rem;">
          <strong>📋 Job Boards</strong>
          <p style="font-size: 0.85rem; margin-top: 0.35rem;">
            <a href={`${base}career-guide/job-boards/`}>Browse job boards &rarr;</a>
          </p>
        </div>
        <div class="card" style="padding: 1rem; margin-bottom: 0.75rem;">
          <strong>📚 Resources</strong>
          <p style="font-size: 0.85rem; margin-top: 0.35rem;">
            <a href={`${base}career-guide/resources/`}>Career resources &rarr;</a>
          </p>
        </div>
        <div class="card" style="padding: 1rem;">
          <strong>🎯 All Roles</strong>
          <p style="font-size: 0.85rem; margin-top: 0.35rem;">
            <a href={`${base}career-guide/roles/`}>View all disciplines &rarr;</a>
          </p>
        </div>
      </aside>
    </div>
  </WikiLayout>
</BaseLayout>