---
import BaseLayout from "../../../../../layouts/BaseLayout.astro";
import WikiLayout from "../../../../../layouts/WikiLayout.astro";
const base = import.meta.env.BASE_URL;

const salaries = [
  { name: "InGameJob", url: "https://ingamejob.com/en/salaries" },
  { name: "Glassdoor", url: "https://www.glassdoor.com/Salaries/product-manager-salary-SRCH_KO0,15.htm" },
  { name: "Salary.com", url: "https://www.salary.com/research/salary/listing/manager-product-salary" },
  { name: "ZipRecruiter", url: "https://www.ziprecruiter.com/Salaries/Product-Manager-Salary#Yearly" }
];

const responsibilities = [
  "Chart the overall direction of the game, setting clear goals, features, priorities, and release schedules for development and live operations.",
  "Analyze player behavior, design engaging live events, optimize retention strategies, and implement innovative monetization models that balance player experience with revenue generation.",
  "Bridge the gap between creative, technical, and business teams, ensuring aligned efforts towards delivering a high-quality and commercially successful game.",
  "Analyze player data, A/B test features, and monitor key metrics to measure progress, identify trends, and make informed decisions for improving the game.",
  "Deliver clear and concise communication to stakeholders, manage expectations, and champion the game's vision both internally and externally.",
  "Strike a balance between delivering a fun and engaging experience for players while meeting revenue targets and achieving financial sustainability.",
  "Monitor market shifts, emerging technologies, and competitor strategies to ensure the game remains competitive and innovative.",
  "Allocate resources effectively, manage project scope, and prioritize features based on impact and feasibility within budget and time constraints.",
  "Gather and analyze player feedback, iterate on gameplay and features based on community insights, and maintain a continuous feedback loop with the player base.",
  "Be adaptable and open to change during development, readily adjust plans based on data and feedback, and continuously improve the game experience through iterative updates and experimentation."
];

const resources = [
  { name: "What Is a Game Product Manager? Definition and Role", url: "https://chisellabs.com/glossary/what-is-a-game-product-manager/" },
  { name: "How to Become a Video Game Product Manager by ProductGym", url: "https://productgym.io/how-to-become-a-video-game-product-manager/" },
  { name: "Product management for Gaming Software by Ignition", url: "https://www.haveignition.com/industry-guides/product-management-for-gaming-software" },
  { name: "The Ultimate Guide to Resources for Product Managers", url: "https://www.productplan.com/learn/resources-for-product-managers/" },
  { name: "Hey! Listen!…Here’s How to Be a Gaming PM by Ellen Merryweather", url: "https://productschool.com/blog/team-management/gaming-product-manager" },
  { name: "How to get a job as a product manager by GamesIndustry.biz", url: "https://www.gamesindustry.biz/how-to-get-a-job-as-a-product-manager" },
  { name: "8 Reasons to Love Your Product Roadmap as a Gaming Product Manager", url: "https://www.productplan.com/learn/product-roadmap-gaming-product-manager/" },
  { name: "APM List: Top Resources for Aspiring and Experienced Product Managers", url: "https://www.joinleland.com/library/a/apm-list-top-resources-for-aspiring-and-experienced-product-managers" },
  { name: "Video Games that Made Me A Better Product Manager", url: "https://productcoalition.com/games-to-play-and-become-a-better-product-manager-c336953efc56" },
  { name: "What’s the Difference Between a Product Manager and a Game Producer?", url: "https://herndlbauer.com/blog/difference-between-product-managers-and-game-producers/" },
  { name: "The Cost-Effective Game Development", url: "https://www.argentics.io/the-cost-effective-game-development-a-capacious-guide" }
];

const books = [
  { name: "Hooked: How to Build Habit-Forming Products by Nir Eyal", url: "https://www.amazon.com/Hooked-How-Build-Habit-Forming-Products/dp/1591847788" },
  { name: "Product Management's Sacred Seven by Parth Detroja, Neel Mehta and Aditya Agashe", url: "https://www.amazon.com/Product-Managements-Sacred-Seven-World-Class/dp/0578740583" },
  { name: "The Product Book: How to Become a Great Product Manager by Carlos González de Villaumbrosia and Josh Anon", url: "https://www.amazon.com/The-Product-Book-audiobook/dp/B07N493QBM/" },
  { name: "Product Management For Dummies by Brian Lawley and Pamela Schure", url: "https://www.amazon.com/Product-Management-Dummies-Brian-Lawley/dp/1119264022/" },
  { name: "Blood, Sweat, and Pixels: The Triumphant, Turbulent Stories Behind How Video Games Are Made by Jason Schreier", url: "https://www.amazon.com/Blood-Sweat-Pixels-Triumphant-Turbulent-ebook/dp/B01NAKSWW1" },
  { name: "Level Up! The Guide to Great Video Game Design by Scott Rogers", url: "https://www.amazon.com/Level-Guide-Great-Video-Design-ebook/dp/B00JRYDCEQ" },
  { name: "Game Thinking: Innovate smarter & drive deep engagement with design techniques from hit games by Amy Jo Kim", url: "https://www.amazon.com/Game-Thinking-Innovate-engagement-techniques/dp/099978854X" },
  { name: "The Art of Game Design: A Book of Lenses by Jesse Schell", url: "https://www.amazon.com/Art-Game-Design-Lenses-Second/dp/1466598646" },
  { name: "Map It: The hands-on guide to strategic training design by Cathy Moore", url: "https://www.amazon.com/Map-hands-strategic-training-design/dp/0999174509/ref=m_crc_dp_lf_d_t1_d_sccl_2_5/142-8161820-1280056?pd_rd_w=klo4F&content-id=amzn1.sym.76a0b561-a7b4-41dc-9467-a85a2fa27c1c&pf_rd_p=76a0b561-a7b4-41dc-9467-a85a2fa27c1c&pf_rd_r=52FQK966YCW6P3QVE75E&pd_rd_wg=ks59c&pd_rd_r=c5d144c4-78a7-43fd-a2f8-d335349b8cca&pd_rd_i=0999174509&psc=1" },
  { name: "Remote Not Distant: Design a Company Culture That Will Help You Thrive in a Hybrid Workplace by Gustavo Razzetti", url: "https://www.amazon.com/Remote-Not-Distant-Company-Workplace/dp/0999097393" },
  { name: "Start with Why Series by Simon Sinek, David Mead and Peter Docker", url: "https://www.amazon.com/dp/B07VVJF819" }
];

const tools = [
  "Game Engines",
  "Jira",
  "Confluence",
  "Git",
  "Perforce",
  "Adobe Photoshop",
  "Figma",
  "Unity Analytics",
  "Google Analytics",
  "App Annie",
  "UserTesting",
  "Mixpanel",
  "Amplitude",
  "Heap",
  "SurveyMonkey"
];

const sidebarRoles = [
  { name: "Product Manager", slug: "product-manager", current: true },
  { name: "Business Development Executive", slug: "business-development-executive", current: false },
  { name: "User Acquisition Specialist", slug: "user-acquisition-specialist", current: false },
  { name: "Specialist Lawyer", slug: "specialist-lawyer", current: false },
  { name: "Human Resources Specialist", slug: "human-resources-specialist", current: false },
  { name: "Financial Specialist", slug: "financial-specialist", current: false },
  { name: "Office/Studio Manager", slug: "office-studio-manager", current: false }
];
---

<BaseLayout title="Product Manager" activeNav="career-guide">
  <WikiLayout title="Product Manager" activeNav="career-guide" activeSidebar="roles">
    <div class="career-layout">
      <aside class="career-sidebar">
        <h3>Business Roles</h3>
        {sidebarRoles.map((r) => (
          r.current ? (
            <div class="card" style="padding: 0.75rem; margin-bottom: 0.5rem; border-left: 3px solid var(--color-pink);">
              <strong style="font-size: 0.9rem; color: var(--color-pink);">{r.name}</strong>
            </div>
          ) : (
            <a href={`${base}career-guide/roles/business/${r.slug}/`} class="card" style="padding: 0.75rem; margin-bottom: 0.5rem; text-decoration: none; display: block;">
              <strong style="font-size: 0.9rem;">{r.name}</strong>
            </a>
          )
        ))}
        <div style="margin-top: 1rem;">
          <a href={`${base}career-guide/roles/business/`} class="btn btn-gold" style="font-size: 0.8rem; padding: 0.4rem 0.8rem;">&larr; Business</a>
        </div>
      </aside>

      <div class="career-main">
        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>About this Role</h2>
          <p>A game product manager is the captain steering the ship from concept to launch and beyond. They wear many hats, juggling the "what" and "why" of the game. Their job is to define the game's vision, features, and target audience, ensuring it resonates with players while hitting business goals. Think of them as the bridge between creative minds and technical know-how, guiding the development team and collaborating with everyone from artists to marketers. Ultimately, they strive to deliver an engaging, successful game that players love to play.</p>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Salary Resources</h2>
          <div style="display: flex; flex-wrap: wrap; gap: 0.75rem;">
            {salaries.map((s) => (
              <a href={s.url} target="_blank" rel="noopener noreferrer" class="btn btn-blue" style="font-size: 0.85rem;">
                {s.name} &rarr;
              </a>
            ))}
          </div>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Key Responsibilities</h2>
          <ul>
            {responsibilities.map((r) => (
              <li>{r}</li>
            ))}
          </ul>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Learning Resources</h2>
          <ul>
            {resources.map((r) => (
              <li><a href={r.url} target="_blank" rel="noopener noreferrer">{r.name}</a></li>
            ))}
          </ul>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Recommended Books</h2>
          <ul>
            {books.map((b) => (
              <li><a href={b.url} target="_blank" rel="noopener noreferrer">{b.name}</a></li>
            ))}
          </ul>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Tools to Learn</h2>
          <div class="callout callout-info">
            <p>You don&#39;t need to learn all of these — they are some of the more common tools for this role.</p>
          </div>
          <div style="display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.75rem;">
            {tools.map((t) => (
              <span style="background: var(--color-bg); border: 1px solid var(--color-dark); border-radius: 4px; padding: 0.3rem 0.6rem; font-size: 0.85rem;">{t}</span>
            ))}
          </div>
        </div>
      </div>

      <aside class="career-sidebar">
        <h3>Quick Links</h3>
        <div class="card" style="padding: 1rem; margin-bottom: 0.75rem;">
          <strong>📋 Job Boards</strong>
          <p style="font-size: 0.85rem; margin-top: 0.35rem;">
            <a href={`${base}career-guide/job-boards/`}>Browse job boards &rarr;</a>
          </p>
        </div>
        <div class="card" style="padding: 1rem; margin-bottom: 0.75rem;">
          <strong>📚 Resources</strong>
          <p style="font-size: 0.85rem; margin-top: 0.35rem;">
            <a href={`${base}career-guide/resources/`}>Career resources &rarr;</a>
          </p>
        </div>
        <div class="card" style="padding: 1rem;">
          <strong>🎯 All Roles</strong>
          <p style="font-size: 0.85rem; margin-top: 0.35rem;">
            <a href={`${base}career-guide/roles/`}>View all disciplines &rarr;</a>
          </p>
        </div>
      </aside>
    </div>
  </WikiLayout>
</BaseLayout>