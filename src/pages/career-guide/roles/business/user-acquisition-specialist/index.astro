---
import BaseLayout from "../../../../../layouts/BaseLayout.astro";
import WikiLayout from "../../../../../layouts/WikiLayout.astro";
const base = import.meta.env.BASE_URL;

const salaries = [
  { name: "InGameJob", url: "https://ingamejob.com/en/salaries" },
  { name: "Glassdoor", url: "https://www.glassdoor.com/Salaries/us-user-acquisition-specialist-salary-SRCH_IL.0,2_IN1_KO3,30.htm" },
  { name: "Salary.com", url: "https://www.salary.com/research/salary/recruiting/user-acquisition-specialist-salary" },
  { name: "ZipRecruiter", url: "https://www.ziprecruiter.com/Salaries/User-Acquisition-Specialist-Salary#Yearly" }
];

const responsibilities = [
  "Develop and implement effective strategies to attract new players to the game, across various marketing channels and platforms.",
  "Utilize data analytics tools and reports to measure campaign performance, identify successful strategies, and optimize tactics for maximum ROI.",
  "Plan, budget for, and manage user acquisition campaigns across diverse channels like social media, mobile ads, influencer marketing, and cross-promotion opportunities.",
  "Conduct market research and player analysis to define ideal user profiles, segment targets, and personalize ad creatives for different demographics and interests.",
  "Develop compelling ad copy, design eye-catching visuals, and craft impactful messaging that resonates with target audiences and motivates them to install and play the game.",
  "Continuously learn about industry trends, emerging platforms, and new user acquisition tools to adapt strategies and ensure competitive advantage.",
  "Work closely with marketing, product, and game development teams to align user acquisition goals with overall marketing strategy and game features.",
  "Build relationships with ad networks, publishers, and influencers to secure favorable placements and negotiate cost-effective deals.",
  "A/B test different ad creatives, channels, and targeting strategies to identify optimal approaches and refine campaign performance continuously.",
  "Clearly present user acquisition data, campaign reports, and insights to stakeholders, demonstrating the effectiveness of strategies and justifying resource allocation."
];

const resources = [
  { name: "What is User Acquisition? 8 Strategies to Get Users for Your App", url: "https://www.helpshift.com/what-is-user-acquisition-8-strategies-to-get-users-for-your-app/" },
  { name: "The Ultimate Guide to Customer Acquisition for 2023", url: "https://blog.hubspot.com/service/customer-acquisition" },
  { name: "Mobile Game User Acquisition Strategy by SuperScale", url: "https://superscale.com/user-acquisition/" },
  { name: "User acquisition: Campaigns and strategy", url: "https://www.is.com/glossary/user-acquisition/" },
  { name: "The Importance of User Acquisition in Mobile Gaming", url: "https://www.gamebizconsulting.com/blog/what-is-user-acquisition-mobile-gaming" },
  { name: "Mobile Game User Acquisition Growth Guide by Upptic", url: "https://upptic.com/mobile-game-user-acquisition-growth-guide/" }
];

const books = [
  { name: "Reality Is Broken: Why Games Make Us Better and How They Can Change the World by Jane McGonigal", url: "https://www.amazon.com/Reality-Broken-Games-Better-Change-ebook/dp/B004G8Q1Q4" },
  { name: "Extra Lives: Why Video Games Matter by Tom Bissell", url: "https://www.amazon.com/Extra-Lives-Video-Games-Matter/dp/0307474313" },
  { name: "Upstream Marketing: Unlock Growth Using the Combined Principles of Insight, Identity, and Innovation by Tim Koelzer and Kristin Kurth", url: "https://www.amazon.com/Upstream-Marketing-Transform-Principles-Innovation/dp/1626347514/" },
  { name: "One Up: Creativity, Competition, and the Global Business of Video Games by Joost van Dreunen", url: "https://www.amazon.com/One-Up-Creativity-Competition-Business/dp/0231197527" },
  { name: "$100M Offers: How to Make Offers So Good People Feel Stupid Saying No by Alex Hormozi", url: "https://www.amazon.com/100M-Offers-People-Stupid-Saying/dp/B09BK52JFJ/" },
  { name: "$100M Leads: How to Get Strangers to Want to Buy Your Stuff by Alex Hormozi", url: "https://www.amazon.com/dp/B0C7WK2GF6" },
  { name: "Growth Units: Learn to calculate Customer Acquisition Cost, Lifetime Value, and why businesses behave the way they do by Paul Orlando", url: "https://www.amazon.com/Growth-Units-calculate-Acquisition-businesses/dp/B08HB68NL6" },
  { name: "The StorySelling Method: Master the Art of Storytelling to Build Trust, Stand Out, and Boost Sales by Philipp Humm", url: "https://www.amazon.com/dp/B0BZ32CTSJ/" },
  { name: "Hook Point: How to Stand Out in a 3-Second World by Brendan Kane", url: "https://www.amazon.com/dp/B09VFS57QL/" },
  { name: "Retention Point by Robert Skrob", url: "https://www.amazon.com/dp/B07CZXD289/" }
];

const tools = [
  "AppsFlyer",
  "Adjust",
  "Kochava",
  "Branch",
  "Tenjin",
  "Google Analytics",
  "Facebook Analytics",
  "Meta Business Manager",
  "App Annie",
  "Sensor Tower",
  "Singular",
  "Leanplum",
  "Amplitude",
  "Mixpanel",
  "Apptentive"
];

const sidebarRoles = [
  { name: "Product Manager", slug: "product-manager", current: false },
  { name: "Business Development Executive", slug: "business-development-executive", current: false },
  { name: "User Acquisition Specialist", slug: "user-acquisition-specialist", current: true },
  { name: "Specialist Lawyer", slug: "specialist-lawyer", current: false },
  { name: "Human Resources Specialist", slug: "human-resources-specialist", current: false },
  { name: "Financial Specialist", slug: "financial-specialist", current: false },
  { name: "Office/Studio Manager", slug: "office-studio-manager", current: false }
];
---

<BaseLayout title="User Acquisition Specialist" activeNav="career-guide">
  <WikiLayout title="User Acquisition Specialist" activeNav="career-guide" activeSidebar="roles">
    <div class="career-layout">
      <aside class="career-sidebar">
        <h3>Business Roles</h3>
        {sidebarRoles.map((r) => (
          r.current ? (
            <div class="card" style="padding: 0.75rem; margin-bottom: 0.5rem; border-left: 3px solid var(--color-pink);">
              <strong style="font-size: 0.9rem; color: var(--color-pink);">{r.name}</strong>
            </div>
          ) : (
            <a href={`${base}career-guide/roles/business/${r.slug}/`} class="card" style="padding: 0.75rem; margin-bottom: 0.5rem; text-decoration: none; display: block;">
              <strong style="font-size: 0.9rem;">{r.name}</strong>
            </a>
          )
        ))}
        <div style="margin-top: 1rem;">
          <a href={`${base}career-guide/roles/business/`} class="btn btn-gold" style="font-size: 0.8rem; padding: 0.4rem 0.8rem;">&larr; Business</a>
        </div>
      </aside>

      <div class="career-main">
        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>About this Role</h2>
          <p>A User Acquisition Specialist is the one luring players to your game. They're the masterminds (along with the marketing team) behind those catchy ads you see online, the enticing social media campaigns, and the strategic app store optimizations that make your game irresistible to gamers. Their mission? To attract a steady stream of engaged players, ensuring your game thrives. This involves wielding data like a magic wand, crafting targeted campaigns across various platforms, analyzing their effectiveness, and constantly tinkering to optimize the flow of new players.</p>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Salary Resources</h2>
          <div style="display: flex; flex-wrap: wrap; gap: 0.75rem;">
            {salaries.map((s) => (
              <a href={s.url} target="_blank" rel="noopener noreferrer" class="btn btn-blue" style="font-size: 0.85rem;">
                {s.name} &rarr;
              </a>
            ))}
          </div>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Key Responsibilities</h2>
          <ul>
            {responsibilities.map((r) => (
              <li>{r}</li>
            ))}
          </ul>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Learning Resources</h2>
          <ul>
            {resources.map((r) => (
              <li><a href={r.url} target="_blank" rel="noopener noreferrer">{r.name}</a></li>
            ))}
          </ul>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Recommended Books</h2>
          <ul>
            {books.map((b) => (
              <li><a href={b.url} target="_blank" rel="noopener noreferrer">{b.name}</a></li>
            ))}
          </ul>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Tools to Learn</h2>
          <div class="callout callout-info">
            <p>You don&#39;t need to learn all of these — they are some of the more common tools for this role.</p>
          </div>
          <div style="display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.75rem;">
            {tools.map((t) => (
              <span style="background: var(--color-bg); border: 1px solid var(--color-dark); border-radius: 4px; padding: 0.3rem 0.6rem; font-size: 0.85rem;">{t}</span>
            ))}
          </div>
        </div>
      </div>

      <aside class="career-sidebar">
        <h3>Quick Links</h3>
        <div class="card" style="padding: 1rem; margin-bottom: 0.75rem;">
          <strong>📋 Job Boards</strong>
          <p style="font-size: 0.85rem; margin-top: 0.35rem;">
            <a href={`${base}career-guide/job-boards/`}>Browse job boards &rarr;</a>
          </p>
        </div>
        <div class="card" style="padding: 1rem; margin-bottom: 0.75rem;">
          <strong>📚 Resources</strong>
          <p style="font-size: 0.85rem; margin-top: 0.35rem;">
            <a href={`${base}career-guide/resources/`}>Career resources &rarr;</a>
          </p>
        </div>
        <div class="card" style="padding: 1rem;">
          <strong>🎯 All Roles</strong>
          <p style="font-size: 0.85rem; margin-top: 0.35rem;">
            <a href={`${base}career-guide/roles/`}>View all disciplines &rarr;</a>
          </p>
        </div>
      </aside>
    </div>
  </WikiLayout>
</BaseLayout>