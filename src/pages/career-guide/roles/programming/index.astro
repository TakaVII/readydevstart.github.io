---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import WikiLayout from "../../../../layouts/WikiLayout.astro";
const base = import.meta.env.BASE_URL;

const roles = [
  { name: "AI Programmer", slug: "ai-programmer", description: "An AI Programmer is the architect of intelligent behavior within the virtual world." },
  { name: "Gameplay Programmer", slug: "gameplay-programmer", description: "Gameplay Programmers are the ones who translate game design concepts into the code that makes characters move, objects react, and players engage." },
  { name: "Generalist Programmer", slug: "generalist-programmer", description: "A Generalist Programmer is a versatile coding wizard who thrives on diverse challenges." },
  { name: "VR Programmer", slug: "vr-programmer", description: "Unlike traditional programmers, VR Programmers must consider the unique challenges of virtual reality." },
  { name: "Tools Programmer", slug: "tools-programmer", description: "The Tools Programmer or Tools Engineer operates behind the scenes, crafting the essential instruments that empower artists, designers, and fellow programmers to weave their magic." },
  { name: "Network Engineer", slug: "network-engineer", description: "Network Engineers (also known as Server Programmer or Network Programmer) are the masters of data flow, ensuring smooth communication between players, servers, and all the digital infrastructure behind the scenes." },
  { name: "Engine Programmer", slug: "engine-programmer", description: "Engine Programmers are the architects of the invisible foundation upon which our games are built." },
  { name: "Graphics Programmer", slug: "graphics-programmer", description: "Graphics programmers are the magicians behind the stunning visuals in video games." },
  { name: "Audio Programmer", slug: "audio-programmer", description: "Audio programmers are the tech wizards behind the scenes of your favorite video games, movies, and even virtual reality experiences." },
  { name: "UX/UI Programmer", slug: "ux-ui-programmer", description: "The UX/UI Programmer stands as the bridge between technical expertise and player experience." },
  { name: "Physics Programmer", slug: "physics-programmer", description: "The Physics Programmer is responsible for simulating the real-world laws of motion, gravity, and collision within the game engine." }
];

const skills = [
  "Programming Languages",
  "Software Development",
  "System Architecture",
  "Data Structures",
  "Algorithms",
  "Debugging",
  "Version Control",
  "Testing and Quality Assurance",
  "Object-Oriented Programming (OOP)",
  "Web Development",
  "Mobile Development",
  "Game Development",
  "Networking",
  "Database Management",
  "Artificial Intelligence (AI)",
  "User Interface (UI) Design",
  "User Experience (UX) Design",
  "Agile Development",
  "Problem-Solving",
  "Collaboration"
];

const courses = [
  { name: "codebar: Free programming workshops for minority groups in tech.", url: "https://codebar.io/" },
  { name: "Into Games’ Junior Programmer Database", url: "https://entrylevel.games/database/junior-programmer" },
  { name: "Study Path for a Game Programmer by miloyip", url: "https://github.com/miloyip/game-programmer" },
  { name: "ID Software GitHub Repository", url: "https://github.com/id-Software" }
];
---

<BaseLayout title="Engineering & Programming Roles" activeNav="career-guide">
  <WikiLayout title="Engineering & Programming Roles" activeNav="career-guide" activeSidebar="roles">
    <p>Engineering and programming careers in the game industry involve the development and implementation of the technical aspects of video games. These professionals work on designing, coding, and optimizing game engines, systems, and mechanics.</p>

    <div class="career-layout">
      <aside class="career-sidebar">
        <h3>Engineering & Programming Roles</h3>
        {roles.map((r) => (
          <a href={`${base}career-guide/roles/programming/${r.slug}/`} class="card" style="padding: 0.75rem; margin-bottom: 0.5rem; text-decoration: none; display: block;">
            <strong style="font-size: 0.9rem;">{r.name}</strong>
          </a>
        ))}
        <div style="margin-top: 1rem;">
          <a href={`${base}career-guide/roles/`} class="btn btn-gold" style="font-size: 0.8rem; padding: 0.4rem 0.8rem;">&larr; All Roles</a>
        </div>
      </aside>

      <div class="career-main">
        <div class="card-grid" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
          {roles.map((role) => (
            <a href={`${base}career-guide/roles/programming/${role.slug}/`} class="card" style="text-decoration:none;">
              <h3>{role.name}</h3>
              <p>{role.description}</p>
              <span class="btn btn-pink" style="font-size: 0.8rem; padding: 0.3rem 0.6rem; margin-top: 0.5rem; display: inline-block;">View Role &rarr;</span>
            </a>
          ))}
        </div>

        <div class="card" style="margin-top: 1.5rem;">
          <h3>Skills Involved</h3>
          <div style="display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.75rem;">
            {skills.map((s) => (
              <span style="background: var(--color-bg); border: 1px solid var(--color-dark); border-radius: 4px; padding: 0.3rem 0.6rem; font-size: 0.85rem;">{s}</span>
            ))}
          </div>
        </div>

        <div class="card" style="margin-top: 1.5rem;">
          <h3>Courses &amp; Resources</h3>
          <ul>
            {courses.map((c) => (
              <li><a href={c.url} target="_blank" rel="noopener noreferrer">{c.name}</a></li>
            ))}
          </ul>
        </div>
      </div>

      <aside class="career-sidebar">
        <h3>Related</h3>
        <div class="card" style="padding: 1rem; margin-bottom: 0.75rem;">
          <p style="font-size: 0.85rem;">
            <a href={`${base}career-guide/roles/business/`}>💼 Business Roles &rarr;</a>
          </p>
        </div>
        <div class="card" style="padding: 1rem; margin-bottom: 0.75rem;">
          <p style="font-size: 0.85rem;">
            <a href={`${base}career-guide/roles/design/`}>🧩 Game Design Roles &rarr;</a>
          </p>
        </div>
        <div class="card" style="padding: 1rem;">
          <p style="font-size: 0.85rem;">
            <a href={`${base}career-guide/job-boards/`}>Job Boards &rarr;</a>
          </p>
        </div>
      </aside>
    </div>
  </WikiLayout>
</BaseLayout>