---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import WikiLayout from "../../../../layouts/WikiLayout.astro";
const base = import.meta.env.BASE_URL;

const roles = [
  { name: "Gameplay Programmer", description: "Implements core game mechanics, player controls, and interactive systems." },
  { name: "Engine Programmer", description: "Works on the game engine itself — rendering, physics, memory management, and core architecture." },
  { name: "Tools Programmer", description: "Builds internal tools and editor extensions that speed up content creation for the team." },
  { name: "Graphics Programmer", description: "Writes shaders, rendering pipelines, and visual effects systems." },
  { name: "Network Programmer", description: "Implements multiplayer networking, server architecture, and synchronization systems." },
];
---

<BaseLayout title="Programming Roles" activeNav="career-guide">
  <WikiLayout title="Programming Roles" activeNav="career-guide" activeSidebar="roles">
    <p>
      Programmers build the technical foundation that makes games run.
      From gameplay logic to rendering engines, there's a specialization
      for every interest.
    </p>

    <div class="career-layout">
      <aside class="career-sidebar">
        <h3>Programming Roles</h3>
        {roles.map((r) => (
          <div class="card" style="padding: 0.75rem; margin-bottom: 0.5rem;">
            <strong style="font-size: 0.9rem;">{r.name}</strong>
          </div>
        ))}
        <div style="margin-top: 1rem;">
          <a href={`${base}career-guide/roles/`} class="btn btn-gold" style="font-size: 0.8rem; padding: 0.4rem 0.8rem;">← All Roles</a>
        </div>
      </aside>

      <div class="career-main">
        {roles.map((role) => (
          <div class="card" style="margin-bottom: 1rem;">
            <h3>{role.name}</h3>
            <p>{role.description}</p>
          </div>
        ))}
      </div>

      <aside class="career-sidebar">
        <h3>Related</h3>
        <div class="card" style="padding: 1rem; margin-bottom: 0.75rem;">
          <p style="font-size: 0.85rem;">
            <a href={`${base}equipment/game-engines/`}>Game Engines →</a>
          </p>
        </div>
        <div class="card" style="padding: 1rem;">
          <p style="font-size: 0.85rem;">
            <a href={`${base}career-guide/resources/`}>Resources →</a>
          </p>
        </div>
      </aside>
    </div>
  </WikiLayout>
</BaseLayout>
