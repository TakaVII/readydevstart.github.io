---
import BaseLayout from "../../../../../layouts/BaseLayout.astro";
import WikiLayout from "../../../../../layouts/WikiLayout.astro";
const base = import.meta.env.BASE_URL;

const salaries = [
  { name: "InGameJob", url: "https://ingamejob.com/en/salaries" },
  { name: "Glassdoor", url: "https://www.glassdoor.com/Salaries/network-engineer-salary-SRCH_KO0,16.htm" },
  { name: "Salary.com", url: "https://www.salary.com/research/salary/listing/network-engineer-salary" },
  { name: "ZipRecruiter", url: "https://www.ziprecruiter.com/Salaries/Network-Engineer-Salary#Yearly" }
];

const responsibilities = [
  "Ensure seamless network performance, bandwidth allocation, and server stability for various game functionalities and player load.",
  "Protect game servers from cyberattacks, data breaches, and DDoS attacks, safeguarding player data and maintaining game integrity.",
  "Analyze network logs, identify performance bottlenecks, and troubleshoot connectivity problems to resolve player latency, disconnects, and other network-related issues.",
  "Implement cloud-based solutions, manage virtual servers, and optimize network resources for efficient operation and scalability.",
  "Build internal tools to monitor network health, track player traffic, and automate network tasks for improved efficiency and data-driven decision making.",
  "Continuously learn new protocols, software, and security solutions to adapt the network infrastructure to evolving online gaming demands.",
  "Scalably handle surges in traffic during game releases and major updates, ensuring a smooth and stable experience for players.",
  "Utilize data analytics to understand player behavior, optimize bandwidth allocation, and identify potential network bottlenecks for proactive maintenance.",
  "Maintain clear documentation of network architecture, troubleshooting steps, and security protocols for future maintenance and knowledge sharing."
];

const resources = [
  { name: "Network Direction Hub", url: "https://networkdirection.net/" },
  { name: "Training material for new network engineer list by u/VA_Network_Nerd", url: "https://www.reddit.com/r/networking/comments/7iudp5/training_material_for_new_network_engineer/" },
  { name: "ScreenSkills’ Network Programmer Profile", url: "https://www.screenskills.com/job-profiles/browse/games/programming/network-programmer/" },
  { name: "Elevating Your Network Engineering Game: A Deep Dive into Today's Essential Skills and Strategies by Leonardo Furtado", url: "https://www.linkedin.com/pulse/elevating-your-network-engineering-game-deep-dive-todays-furtado-fkime/" },
  { name: "Game Networking Resources Repository by ThusSpokeNomad", url: "https://github.com/ThusSpokeNomad/GameNetworkingResources" },
  { name: "Real-Time Game Server Internals: Basic Theory, Architecture, Optimization, Auto-Scaling by Aleksei Elivanov", url: "https://betterprogramming.pub/real-time-game-server-internals-basic-theory-architecture-optimization-auto-scaling-b2070aa803d9" },
  { name: "Socket Programming: Building an online multiplayer game server by Kareem Emad", url: "https://kareememad400.medium.com/socket-programming-building-an-online-multiplayer-game-server-38132f811fbd" }
];

const books = [
  { name: "Game Programming Patterns by Robert Nystrom", url: "https://www.amazon.com/Game-Programming-Patterns-Robert-Nystrom/dp/0990582906" },
  { name: "Multiplayer Game Programming: Architecting Networked Games by Josh Glazer and Sanjay Madhav", url: "https://www.amazon.com/Multiplayer-Game-Programming-Architecting-Networked-ebook/dp/B0189RXWJQ/" },
  { name: "Network Security: A Decision and Game-Theoretic Approach by Tansu Alpcan and Tamer Basar", url: "https://www.amazon.com/Network-Security-Decision-Game-Theoretic-Approach/dp/0521119324/" },
  { name: "Development and Deployment of Multiplayer Online Games by 'No Bugs' Hare", url: "https://www.amazon.com/Development-Deployment-Multiplayer-Online-Games/dp/3903213160/" },
  { name: "Networking All-in-One For Dummies by Doug Lowe", url: "https://www.amazon.com/Networking-All-One-Dummies-Computer/dp/1119689015" },
  { name: "Network Warrior: Everything You Need to Know That Wasn't on the CCNA by Gary Donahue", url: "https://www.amazon.com/Network-Warrior-Everything-Need-Wasnt/dp/1449387861/" },
  { name: "Massively Multiplayer Game Development by Thor Alexander", url: "https://www.amazon.com/Massively-Multiplayer-Game-Development/dp/1584502436/" },
  { name: "Network Programmability and Automation: Skills for the Next-Generation Network Engineer by Jason Edelman, Scott Lowe and Matt Oswalt", url: "https://www.amazon.com/Network-Programmability-Automation-Next-Generation-Engineer/dp/1491931256/" },
  { name: "Security Engineering: A Guide to Building Dependable Distributed Systems by Ross Anderson", url: "https://www.amazon.com/Security-Engineering-Building-Dependable-Distributed/dp/1119642787/" },
  { name: "Multiplayer Game Development with Unreal Engine 5 by Marco Secchi", url: "https://www.amazon.com/Multiplayer-Game-Development-Unreal-Engine/dp/1803232870/" }
];

const tools = [
  "Game Engines",
  "C#",
  "C++",
  "Wireshark",
  "tcpdump",
  "Netstat",
  "Ping",
  "Traceroute",
  "MTR (My Traceroute)",
  "nmap",
  "Microsoft Network Monitor",
  "SolarWinds Network Performance Monitor",
  "PRTG Network Monitor",
  "Nagios",
  "Icinga",
  "Zabbix",
  "Splunk"
];

const sidebarRoles = [
  { name: "AI Programmer", slug: "ai-programmer", current: false },
  { name: "Gameplay Programmer", slug: "gameplay-programmer", current: false },
  { name: "Generalist Programmer", slug: "generalist-programmer", current: false },
  { name: "VR Programmer", slug: "vr-programmer", current: false },
  { name: "Tools Programmer", slug: "tools-programmer", current: false },
  { name: "Network Engineer", slug: "network-engineer", current: true },
  { name: "Engine Programmer", slug: "engine-programmer", current: false },
  { name: "Graphics Programmer", slug: "graphics-programmer", current: false },
  { name: "Audio Programmer", slug: "audio-programmer", current: false },
  { name: "UX/UI Programmer", slug: "ux-ui-programmer", current: false },
  { name: "Physics Programmer", slug: "physics-programmer", current: false }
];
---

<BaseLayout title="Network Engineer" activeNav="career-guide">
  <WikiLayout title="Network Engineer" activeNav="career-guide" activeSidebar="roles">
    <div class="career-layout">
      <aside class="career-sidebar">
        <h3>Engineering & Programming Roles</h3>
        {sidebarRoles.map((r) => (
          r.current ? (
            <div class="card" style="padding: 0.75rem; margin-bottom: 0.5rem; border-left: 3px solid var(--clr-pink);">
              <strong style="font-size: 0.9rem; color: var(--clr-pink);">{r.name}</strong>
            </div>
          ) : (
            <a href={`${base}career-guide/roles/programming/${r.slug}/`} class="card" style="padding: 0.75rem; margin-bottom: 0.5rem; text-decoration: none; display: block;">
              <strong style="font-size: 0.9rem;">{r.name}</strong>
            </a>
          )
        ))}
        <div style="margin-top: 1rem;">
          <a href={`${base}career-guide/roles/programming/`} class="btn btn-gold" style="font-size: 0.8rem; padding: 0.4rem 0.8rem;">&larr; Engineering & Programming</a>
        </div>
      </aside>

      <div class="career-main">
        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>About this Role</h2>
          <p>Network Engineers (also known as Server Programmer or Network Programmer) are the masters of data flow, ensuring smooth communication between players, servers, and all the digital infrastructure behind the scenes. Their responsibilities encompass designing, building, and maintaining the game's network infrastructure. This includes setting up and configuring servers, optimizing data transmission pathways, and implementing security measures to prevent lag, outages, and breaches. They work closely with developers, testers, and system administrators, identifying and resolving network issues to guarantee a lag-free, enjoyable experience for players, ensuring the online world remains accessible and responsive, and allowing players to connect, compete, and collaborate without a hitch.</p>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Salary Resources</h2>
          <div style="display: flex; flex-wrap: wrap; gap: 0.75rem;">
            {salaries.map((s) => (
              <a href={s.url} target="_blank" rel="noopener noreferrer" class="btn btn-blue" style="font-size: 0.85rem;">
                {s.name} &rarr;
              </a>
            ))}
          </div>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Key Responsibilities</h2>
          <ul>
            {responsibilities.map((r) => (
              <li>{r}</li>
            ))}
          </ul>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Learning Resources</h2>
          <ul>
            {resources.map((r) => (
              <li><a href={r.url} target="_blank" rel="noopener noreferrer">{r.name}</a></li>
            ))}
          </ul>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Recommended Books</h2>
          <ul>
            {books.map((b) => (
              <li><a href={b.url} target="_blank" rel="noopener noreferrer">{b.name}</a></li>
            ))}
          </ul>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Tools to Learn</h2>
          <div class="callout callout-info">
            <p>You don&#39;t need to learn all of these — they are some of the more common tools for this role.</p>
          </div>
          <div style="display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.75rem;">
            {tools.map((t) => (
              <span style="background: var(--clr-bg); border: 1px solid var(--clr-dark); border-radius: 4px; padding: 0.3rem 0.6rem; font-size: 0.85rem;">{t}</span>
            ))}
          </div>
        </div>
      </div>

      <aside class="career-sidebar">
        <h3>Quick Links</h3>
        <div class="card" style="padding: 1rem; margin-bottom: 0.75rem;">
          <strong>📋 Job Boards</strong>
          <p style="font-size: 0.85rem; margin-top: 0.35rem;">
            <a href={`${base}career-guide/job-boards/`}>Browse job boards &rarr;</a>
          </p>
        </div>
        <div class="card" style="padding: 1rem; margin-bottom: 0.75rem;">
          <strong>📚 Resources</strong>
          <p style="font-size: 0.85rem; margin-top: 0.35rem;">
            <a href={`${base}career-guide/resources/`}>Career resources &rarr;</a>
          </p>
        </div>
        <div class="card" style="padding: 1rem;">
          <strong>🎯 All Roles</strong>
          <p style="font-size: 0.85rem; margin-top: 0.35rem;">
            <a href={`${base}career-guide/roles/`}>View all disciplines &rarr;</a>
          </p>
        </div>
      </aside>
    </div>
  </WikiLayout>
</BaseLayout>