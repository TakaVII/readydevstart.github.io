---
import BaseLayout from "../../../../../layouts/BaseLayout.astro";
import WikiLayout from "../../../../../layouts/WikiLayout.astro";
import RoleGuide from "../../../../../components/RoleGuide.astro";
const base = import.meta.env.BASE_URL;

const salaries = [
  { name: "InGameJob", url: "https://ingamejob.com/en/salaries" },
  { name: "Glassdoor", url: "https://www.glassdoor.com/Salaries/network-engineer-salary-SRCH_KO0,16.htm" },
  { name: "Salary.com", url: "https://www.salary.com/research/salary/listing/network-engineer-salary" },
  { name: "ZipRecruiter", url: "https://www.ziprecruiter.com/Salaries/Network-Engineer-Salary#Yearly" }
];

const responsibilities = [
  "Design and build the game's multiplayer architecture, such as client-server or peer-to-peer, and decide what the server is authoritative over.",
  "Synchronize game state between players and servers using replication, serialization, and the engine's networking layer.",
  "Hide latency with client-side prediction, reconciliation, interpolation, lag compensation, or rollback so the game feels responsive.",
  "Reduce bandwidth by sending only the data each player needs, compressing updates, and choosing sensible update rates.",
  "Keep the server authoritative and validate client input to limit cheating, and work with security teams on threats like DDoS attacks.",
  "Reproduce and fix desyncs, disconnects, and lag issues using logs, packet captures, and simulated latency and packet loss.",
  "Support dedicated servers, matchmaking, and online services, and help the team prepare for traffic spikes at launch and during updates.",
  "Work with gameplay programmers and designers so new features work correctly in multiplayer from the start.",
  "Maintain clear documentation of network architecture, protocols, and debugging steps for future maintenance and knowledge sharing."
];

const resources = [
  { name: "ScreenSkills’ Network Programmer Profile", url: "https://www.screenskills.com/job-profiles/browse/games/programming/network-programmer/" },
  { name: "Fast-Paced Multiplayer article series by Gabriel Gambetta", url: "https://www.gabrielgambetta.com/client-server-game-architecture.html" },
  { name: "Gaffer On Games by Glenn Fiedler", url: "https://gafferongames.com/" },
  { name: "Source Multiplayer Networking by Valve", url: "https://developer.valvesoftware.com/wiki/Source_Multiplayer_Networking" },
  { name: "Networking Overview for Unreal Engine by Epic Games", url: "https://dev.epicgames.com/documentation/en-us/unreal-engine/networking-overview-for-unreal-engine" },
  { name: "Game Networking Resources Repository by ThusSpokeNomad", url: "https://github.com/0xFA11/MultiplayerNetworkingResources" },
  { name: "Real-Time Game Server Internals: Basic Theory, Architecture, Optimization, Auto-Scaling by Aleksei Elivanov", url: "https://betterprogramming.pub/real-time-game-server-internals-basic-theory-architecture-optimization-auto-scaling-b2070aa803d9" }
];

const books = [
  { name: "Game Programming Patterns by Robert Nystrom", url: "https://www.amazon.com/Game-Programming-Patterns-Robert-Nystrom/dp/0990582906" },
  { name: "Multiplayer Game Programming: Architecting Networked Games by Josh Glazer and Sanjay Madhav", url: "https://www.amazon.com/Multiplayer-Game-Programming-Architecting-Networked-ebook/dp/B0189RXWJQ/" },
  { name: "Development and Deployment of Multiplayer Online Games by 'No Bugs' Hare", url: "https://www.amazon.com/Development-Deployment-Multiplayer-Online-Games/dp/3903213160/" },
  { name: "Multiplayer Game Development with Unreal Engine 5 by Marco Secchi", url: "https://www.amazon.com/Multiplayer-Game-Development-Unreal-Engine/dp/1803232870/" }
];

const tools = [
  "Game Engines",
  "C#",
  "C++",
  "Unreal Engine Replication",
  "Unity Netcode for GameObjects",
  "Photon",
  "Steamworks",
  "Wireshark",
  "tcpdump",
  "Clumsy",
  "Docker",
  "Linux"
];

const sidebarRoles = [
  { name: "AI Programmer", slug: "ai-programmer", current: false },
  { name: "Gameplay Programmer", slug: "gameplay-programmer", current: false },
  { name: "Generalist Programmer", slug: "generalist-programmer", current: false },
  { name: "VR Programmer", slug: "vr-programmer", current: false },
  { name: "Tools Programmer", slug: "tools-programmer", current: false },
  { name: "Network Engineer", slug: "network-engineer", current: true },
  { name: "Engine Programmer", slug: "engine-programmer", current: false },
  { name: "Graphics Programmer", slug: "graphics-programmer", current: false },
  { name: "Audio Programmer", slug: "audio-programmer", current: false },
  { name: "UX/UI Programmer", slug: "ux-ui-programmer", current: false },
  { name: "Physics Programmer", slug: "physics-programmer", current: false }
];
---

<BaseLayout title="How to Become a Network Engineer: Skills, Portfolio & Tools" description="How to become a Network Engineer in the game industry: step-by-step path, key skills, portfolio tips, salary resources, the tools to learn, and FAQs." activeNav="career-guide">
  <WikiLayout title="Network Engineer" activeNav="career-guide" activeSidebar="roles">
    <div class="career-layout">
      <aside class="career-sidebar">
        <h3>Engineering & Programming Roles</h3>
        {sidebarRoles.map((r) => (
          r.current ? (
            <div class="card" style="padding: 0.75rem; margin-bottom: 0.5rem; border-left: 3px solid var(--color-pink);">
              <strong style="font-size: 0.9rem; color: var(--color-pink);">{r.name}</strong>
            </div>
          ) : (
            <a href={`${base}career-guide/roles/programming/${r.slug}/`} class="card" style="padding: 0.75rem; margin-bottom: 0.5rem; text-decoration: none; display: block;">
              <strong style="font-size: 0.9rem;">{r.name}</strong>
            </a>
          )
        ))}
        <div style="margin-top: 1rem;">
          <a href={`${base}career-guide/roles/programming/`} class="btn btn-gold" style="font-size: 0.8rem; padding: 0.4rem 0.8rem;">&larr; Engineering & Programming</a>
        </div>
      </aside>

      <div class="career-main">
        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>About this Role</h2>
          <p>Network Engineers (also known as Server Programmer or Network Programmer) are the masters of data flow, ensuring smooth communication between players, servers, and all the digital infrastructure behind the scenes. In games, the role is mostly about netcode: designing the multiplayer architecture, keeping game state in sync between players and servers, and using techniques like client-side prediction and lag compensation so online play feels responsive. They also keep the server authoritative to limit cheating and help support dedicated servers and online services. They work closely with gameplay programmers, designers, testers, and online operations teams, identifying and resolving network issues to guarantee a lag-free, enjoyable experience for players, ensuring the online world remains accessible and responsive, and allowing players to connect, compete, and collaborate without a hitch.</p>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Salary Resources</h2>
          <div style="display: flex; flex-wrap: wrap; gap: 0.75rem;">
            {salaries.map((s) => (
              <a href={s.url} target="_blank" rel="noopener noreferrer" class="btn btn-blue" style="font-size: 0.85rem;">
                {s.name} &rarr;
              </a>
            ))}
          </div>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Key Responsibilities</h2>
          <ul>
            {responsibilities.map((r) => (
              <li>{r}</li>
            ))}
          </ul>
        </div>

        <RoleGuide slug="network-engineer" part="guide" />

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Learning Resources</h2>
          <ul>
            {resources.map((r) => (
              <li><a href={r.url} target="_blank" rel="noopener noreferrer">{r.name}</a></li>
            ))}
          </ul>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Recommended Books</h2>
          <ul>
            {books.map((b) => (
              <li><a href={b.url} target="_blank" rel="noopener noreferrer">{b.name}</a></li>
            ))}
          </ul>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Tools to Learn</h2>
          <div class="callout callout-info">
            <p>You don&#39;t need to learn all of these — they are some of the more common tools for this role.</p>
          </div>
          <div style="display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.75rem;">
            {tools.map((t) => (
              <span style="background: var(--color-bg); border: 1px solid var(--color-dark); border-radius: 4px; padding: 0.3rem 0.6rem; font-size: 0.85rem;">{t}</span>
            ))}
          </div>
        </div>

        <RoleGuide slug="network-engineer" part="faq" />
      </div>

      <aside class="career-sidebar">
        <h3>Quick Links</h3>
        <div class="card" style="padding: 1rem; margin-bottom: 0.75rem;">
          <strong>📋 Job Boards</strong>
          <p style="font-size: 0.85rem; margin-top: 0.35rem;">
            <a href={`${base}career-guide/job-boards/`}>Browse job boards &rarr;</a>
          </p>
        </div>
        <div class="card" style="padding: 1rem; margin-bottom: 0.75rem;">
          <strong>📚 Resources</strong>
          <p style="font-size: 0.85rem; margin-top: 0.35rem;">
            <a href={`${base}career-guide/resources/`}>Career resources &rarr;</a>
          </p>
        </div>
        <div class="card" style="padding: 1rem;">
          <strong>🎯 All Roles</strong>
          <p style="font-size: 0.85rem; margin-top: 0.35rem;">
            <a href={`${base}career-guide/roles/`}>View all disciplines &rarr;</a>
          </p>
        </div>
      </aside>
    </div>
  </WikiLayout>
</BaseLayout>