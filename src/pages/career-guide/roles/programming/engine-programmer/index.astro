---
import BaseLayout from "../../../../../layouts/BaseLayout.astro";
import WikiLayout from "../../../../../layouts/WikiLayout.astro";
const base = import.meta.env.BASE_URL;

const salaries = [
  { name: "InGameJob", url: "https://ingamejob.com/en/salaries" },
  { name: "Glassdoor", url: "https://www.glassdoor.com/Salaries/engine-programmer-salary-SRCH_KO0,17.htm" },
  { name: "Salary.com", url: "https://www.salary.com/research/salary/position/game-engine-programmer-salary" },
  { name: "ZipRecruiter", url: "https://www.ziprecruiter.com/Salaries/Game-Engine-Programmer-Salary#Yearly" }
];

const responsibilities = [
  "Craft the fundamental building blocks of the game engine, including rendering, physics, audio, input, memory management, and file I/O, ensuring efficient and performant operation.",
  "Profile code, identify bottlenecks, and implement optimizations to maximize game speed, reduce loading times, and ensure smooth gameplay across various platforms and hardware configurations.",
  "Create custom tools and editor extensions to streamline asset creation, level design, debugging, and testing processes, empowering other developers to work efficiently within the engine.",
  "Ensure code quality, fix bugs, address compatibility issues, and incorporate new features and technologies to keep the engine up-to-date and aligned with evolving game development needs.",
  "Thoroughly test new engine components and functionalities, gather feedback from developers, and iterate on designs to create a robust and user-friendly engine that empowers game creation.",
  "Participate in discussions and decisions regarding the overall structure, modularity, and extensibility of the engine, ensuring its long-term viability and adaptability to future projects.",
  "Adhere to coding standards, create clear and concise documentation, and promote code reusability to facilitate future engine development and collaboration among team members."
];

const resources = [
  { name: "Mastered’s Games Programming Bootcamp", url: "https://join.mastered.com/games_careers_sb" },
  { name: "Game Engine Programming 001 YouTube Series by Game Engine Series", url: "https://www.youtube.com/watch?v=hRL56gXqj-4&ab_channel=GameEngineSeries" },
  { name: "How to Make Your Own C++ Game Engine", url: "https://www.gamedeveloper.com/game-platforms/how-to-make-your-own-c-game-engine" },
  { name: "Learn Game Engine Programming List of Resources", url: "https://engine-programming.github.io/" },
  { name: "ScreenSkills’ Engine Programmer Profile", url: "https://www.screenskills.com/job-profiles/browse/games/programming/engine-programmer/" },
  { name: "Making Your Own Video Game Engine: The Beginners Guide", url: "https://www.gamedesigning.org/learn/make-a-game-engine/" },
  { name: "Into Games’ Engine Programmer Profile", url: "https://intogames.org/role/engine-programmer/" },
  { name: "How to become a game engine developer by Harold Serrano", url: "https://www.haroldserrano.com/blog/how-to-become-a-game-engine-developer" }
];

const books = [
  { name: "Game Programming Patterns by Robert Nystrom", url: "https://www.amazon.com/Game-Programming-Patterns-Robert-Nystrom/dp/0990582906" },
  { name: "Game Engine Architecture by Jason Gregory", url: "https://www.amazon.com/Engine-Architecture-Third-Jason-Gregory/dp/1138035459/" },
  { name: "Foundations of Game Engine Development by Eric Lengyel", url: "https://www.amazon.com/dp/B087C1X587" },
  { name: "Game Engine Black Book Wolfenstein 3D by Fabien Sanglard", url: "https://www.amazon.com/Game-Engine-Black-Book-Wolfenstein/dp/1070515841/" },
  { name: "Game Engine Black Book: DOOM by Fabien Sanglard", url: "https://www.amazon.com/Game-Engine-Black-Book-DOOM/dp/B0BMSP3GSS/" },
  { name: "Unreal Engine 5 Game Development with C++ Scripting by George Li", url: "https://www.amazon.com/Unreal-Engine-Game-Development-Scripting/dp/1804613932" },
  { name: "Beginning C++ Game Programming: Learn to program with C++ by building fun games by John Horton", url: "https://www.amazon.com/Beginning-Game-Programming-program-building/dp/1838648577/" },
  { name: "3D Game Engine Programming by Stefan Zerbst and Oliver Duvel", url: "https://www.amazon.com/3D-Game-Engine-Programming-Development/dp/1592003516/" }
];

const tools = [
  "Game Engines",
  "C++",
  "C#",
  "Git",
  "CMake",
  "Perf",
  "Valgrind",
  "CodeXL",
  "PIX",
  "RenderDoc",
  "Intel VTune Amplifier",
  "NVIDIA Nsight Graphics",
  "AMD Radeon GPU Profiler",
  "Tracy Profiler",
  "Boost",
  "Python",
  "Lua"
];

const sidebarRoles = [
  { name: "AI Programmer", slug: "ai-programmer", current: false },
  { name: "Gameplay Programmer", slug: "gameplay-programmer", current: false },
  { name: "Generalist Programmer", slug: "generalist-programmer", current: false },
  { name: "VR Programmer", slug: "vr-programmer", current: false },
  { name: "Tools Programmer", slug: "tools-programmer", current: false },
  { name: "Network Engineer", slug: "network-engineer", current: false },
  { name: "Engine Programmer", slug: "engine-programmer", current: true },
  { name: "Graphics Programmer", slug: "graphics-programmer", current: false },
  { name: "Audio Programmer", slug: "audio-programmer", current: false },
  { name: "UX/UI Programmer", slug: "ux-ui-programmer", current: false },
  { name: "Physics Programmer", slug: "physics-programmer", current: false }
];
---

<BaseLayout title="Engine Programmer" activeNav="career-guide">
  <WikiLayout title="Engine Programmer" activeNav="career-guide" activeSidebar="roles">
    <div class="career-layout">
      <aside class="career-sidebar">
        <h3>Engineering & Programming Roles</h3>
        {sidebarRoles.map((r) => (
          r.current ? (
            <div class="card" style="padding: 0.75rem; margin-bottom: 0.5rem; border-left: 3px solid var(--clr-pink);">
              <strong style="font-size: 0.9rem; color: var(--clr-pink);">{r.name}</strong>
            </div>
          ) : (
            <a href={`${base}career-guide/roles/programming/${r.slug}/`} class="card" style="padding: 0.75rem; margin-bottom: 0.5rem; text-decoration: none; display: block;">
              <strong style="font-size: 0.9rem;">{r.name}</strong>
            </a>
          )
        ))}
        <div style="margin-top: 1rem;">
          <a href={`${base}career-guide/roles/programming/`} class="btn btn-gold" style="font-size: 0.8rem; padding: 0.4rem 0.8rem;">&larr; Engineering & Programming</a>
        </div>
      </aside>

      <div class="career-main">
        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>About this Role</h2>
          <p>Engine Programmers are the architects of the invisible foundation upon which our games are built. They find themselves crafting and optimizing the game engine, the software that powers graphics, physics, sound, and everything that makes a game tick. Their task is multifaceted, encompassing both low-level optimization of core systems like rendering and memory management, alongside building high-level features like networking and animation tools. They work closely with other programmers, artists, and designers, ensuring the engine seamlessly supports their creative vision.</p>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Salary Resources</h2>
          <div style="display: flex; flex-wrap: wrap; gap: 0.75rem;">
            {salaries.map((s) => (
              <a href={s.url} target="_blank" rel="noopener noreferrer" class="btn btn-blue" style="font-size: 0.85rem;">
                {s.name} &rarr;
              </a>
            ))}
          </div>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Key Responsibilities</h2>
          <ul>
            {responsibilities.map((r) => (
              <li>{r}</li>
            ))}
          </ul>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Learning Resources</h2>
          <ul>
            {resources.map((r) => (
              <li><a href={r.url} target="_blank" rel="noopener noreferrer">{r.name}</a></li>
            ))}
          </ul>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Recommended Books</h2>
          <ul>
            {books.map((b) => (
              <li><a href={b.url} target="_blank" rel="noopener noreferrer">{b.name}</a></li>
            ))}
          </ul>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Tools to Learn</h2>
          <div class="callout callout-info">
            <p>You don&#39;t need to learn all of these — they are some of the more common tools for this role.</p>
          </div>
          <div style="display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.75rem;">
            {tools.map((t) => (
              <span style="background: var(--clr-bg); border: 1px solid var(--clr-dark); border-radius: 4px; padding: 0.3rem 0.6rem; font-size: 0.85rem;">{t}</span>
            ))}
          </div>
        </div>
      </div>

      <aside class="career-sidebar">
        <h3>Quick Links</h3>
        <div class="card" style="padding: 1rem; margin-bottom: 0.75rem;">
          <strong>📋 Job Boards</strong>
          <p style="font-size: 0.85rem; margin-top: 0.35rem;">
            <a href={`${base}career-guide/job-boards/`}>Browse job boards &rarr;</a>
          </p>
        </div>
        <div class="card" style="padding: 1rem; margin-bottom: 0.75rem;">
          <strong>📚 Resources</strong>
          <p style="font-size: 0.85rem; margin-top: 0.35rem;">
            <a href={`${base}career-guide/resources/`}>Career resources &rarr;</a>
          </p>
        </div>
        <div class="card" style="padding: 1rem;">
          <strong>🎯 All Roles</strong>
          <p style="font-size: 0.85rem; margin-top: 0.35rem;">
            <a href={`${base}career-guide/roles/`}>View all disciplines &rarr;</a>
          </p>
        </div>
      </aside>
    </div>
  </WikiLayout>
</BaseLayout>