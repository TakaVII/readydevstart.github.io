---
import BaseLayout from "../../../../../layouts/BaseLayout.astro";
import WikiLayout from "../../../../../layouts/WikiLayout.astro";
const base = import.meta.env.BASE_URL;

const salaries = [
  { name: "InGameJob", url: "https://ingamejob.com/en/salaries" },
  { name: "Glassdoor", url: "https://www.glassdoor.com/Salaries/vr-programmer-salary-SRCH_KO0,13.htm" },
  { name: "Salary.com", url: "https://www.salary.com/research/salary/hiring/vr-programmer-salary" },
  { name: "ZipRecruiter", url: "https://www.ziprecruiter.com/Salaries/Vr-Programmer-Salary#Yearly" }
];

const responsibilities = [
  "Deep understanding of VR platforms (Oculus, SteamVR, etc.), rendering pipelines, VR-specific input methods, and physics simulation tailored for VR experiences.",
  "Craft intuitive and comfortable interactions for navigating virtual environments, manipulating objects, and interacting with other players in VR.",
  "Balance visual fidelity with smooth frame rates, minimizing latency and potential motion sickness to ensure a comfortable and enjoyable VR experience.",
  "Implement spatial audio solutions to enhance immersion and utilize haptic feedback technologies to create believable touch interactions within the virtual environment.",
  "Adapt existing game engines like Unity or Unreal Engine to VR development needs, handling platform-specific requirements and optimization considerations.",
  "Continuously learn about emerging VR technologies, hardware advancements, and best practices to keep VR experiences innovative and impactful.",
  "Identify and fix performance issues, rendering glitches, and interaction problems unique to VR development, ensuring a polished and functional VR experience."
];

const resources = [
  { name: "Mastered’s VR Developer Bootcamp", url: "https://join.mastered.com/xr_careers_sb" },
  { name: "The Design of Virtual and Augmented Reality", url: "https://aliheston.gitbook.io/the-design-of-virtual-and-augmented-reality/" },
  { name: "VR Development for Beginners 2024 - How to get started by Valem Tutorials", url: "https://www.youtube.com/watch?v=i3DbJwy0R6E&ab_channel=ValemTutorials" },
  { name: "Best Programming Languages for VR – Guide", url: "https://qubit-labs.com/best-programming-languages-for-vr-guide/" },
  { name: "ScreenSkills’ VR Programmer Profile", url: "https://www.screenskills.com/job-profiles/browse/games/programming/virtual-reality-vr-programmer/" },
  { name: "The Technology Behind Virtual Reality: Coding and Design", url: "https://vr.space/news/education/vr-coding-design/" },
  { name: "How to Become a VR Developer: A Beginner's Guide", url: "https://www.makeuseof.com/how-to-become-a-vr-developer/" },
  { name: "Virtual Reality Resources Repository by gruberdev", url: "https://github.com/gruberdev/vr-resources" },
  { name: "Programming Development Guides: VR", url: "https://circuitstream.com/blog/programming-development-guides" },
  { name: "Virtual Reality (VR) Software Development: Tools You Need", url: "https://www.perforce.com/blog/vcs/virtual-reality-software-development" },
  { name: "AR/VR Guide Repository by mikeroyal", url: "https://github.com/mikeroyal/AR-VR-Guide" }
];

const books = [
  { name: "Game Programming Patterns by Robert Nystrom", url: "https://www.amazon.com/Game-Programming-Patterns-Robert-Nystrom/dp/0990582906" },
  { name: "Unreal Engine VR Cookbook: Developing Virtual Reality with UE4 by Mitch McCaffrey", url: "https://www.amazon.com/Unreal-Engine-VR-Cookbook-Developing/dp/0134649176/" },
  { name: "Unity in Action, Third Edition: Multiplatform game development in C# by Joe Hocking", url: "https://www.amazon.com/Unity-Action-Third-Joseph-Hocking/dp/1617299332/" },
  { name: "Learning Virtual Reality: Developing Immersive Experiences and Applications for Desktop, Web, and Mobile by Tony Parisi", url: "https://www.amazon.com/Learning-Virtual-Reality-Experiences-Applications/dp/1491922834/" },
  { name: "VR Developer Gems by William R. Sherman", url: "https://www.amazon.com/VR-Developer-Gems-William-Sherman/dp/1032475498/" },
  { name: "Augmented Reality with Unity AR Foundation by Jonathan Linowes", url: "https://www.amazon.com/Augmented-Reality-Unity-Foundation-cross-platform-ebook/dp/B0996TTM8Q/" },
  { name: "Unreal Engine 4 Virtual Reality Projects by Kevin Mack and Robert Ruud", url: "https://www.amazon.com/Unreal-Engine-Virtual-Reality-Projects/dp/1789132878/" },
  { name: "Enhancing Virtual Reality Experiences with Unity 2022 by Steven Antonio Christian", url: "https://www.amazon.com/Enhancing-Virtual-Reality-Experiences-Unity/dp/1804619531/" },
  { name: "Practical Augmented Reality: A Guide to the Technologies, Applications, and Human Factors for AR and VR by Steve Aukstakalnis", url: "https://www.amazon.com/Practical-Augmented-Reality-Technologies-Applications/dp/0134094239" }
];

const tools = [
  "Game Engines",
  "C#",
  "C++",
  "Unity XR Interaction Toolkit",
  "Open XR",
  "VRTK",
  "SteamVR",
  "Oculus Integration Package",
  "OpenXR",
  "Blender",
  "Maya",
  "Substance 3D",
  "Rider",
  "Git",
  "Perforce"
];

const sidebarRoles = [
  { name: "AI Programmer", slug: "ai-programmer", current: false },
  { name: "Gameplay Programmer", slug: "gameplay-programmer", current: false },
  { name: "Generalist Programmer", slug: "generalist-programmer", current: false },
  { name: "VR Programmer", slug: "vr-programmer", current: true },
  { name: "Tools Programmer", slug: "tools-programmer", current: false },
  { name: "Network Engineer", slug: "network-engineer", current: false },
  { name: "Engine Programmer", slug: "engine-programmer", current: false },
  { name: "Graphics Programmer", slug: "graphics-programmer", current: false },
  { name: "Audio Programmer", slug: "audio-programmer", current: false },
  { name: "UX/UI Programmer", slug: "ux-ui-programmer", current: false },
  { name: "Physics Programmer", slug: "physics-programmer", current: false }
];
---

<BaseLayout title="VR Programmer" activeNav="career-guide">
  <WikiLayout title="VR Programmer" activeNav="career-guide" activeSidebar="roles">
    <div class="career-layout">
      <aside class="career-sidebar">
        <h3>Engineering & Programming Roles</h3>
        {sidebarRoles.map((r) => (
          r.current ? (
            <div class="card" style="padding: 0.75rem; margin-bottom: 0.5rem; border-left: 3px solid var(--color-pink);">
              <strong style="font-size: 0.9rem; color: var(--color-pink);">{r.name}</strong>
            </div>
          ) : (
            <a href={`${base}career-guide/roles/programming/${r.slug}/`} class="card" style="padding: 0.75rem; margin-bottom: 0.5rem; text-decoration: none; display: block;">
              <strong style="font-size: 0.9rem;">{r.name}</strong>
            </a>
          )
        ))}
        <div style="margin-top: 1rem;">
          <a href={`${base}career-guide/roles/programming/`} class="btn btn-gold" style="font-size: 0.8rem; padding: 0.4rem 0.8rem;">&larr; Engineering & Programming</a>
        </div>
      </aside>

      <div class="career-main">
        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>About this Role</h2>
          <p>Unlike traditional programmers, VR Programmers must consider the unique challenges of virtual reality. They optimize experiences for head-mounted displays, ensuring smooth locomotion, responsive controls, and minimal latency to prevent nausea and discomfort. They also integrate advanced features like hand tracking and voice recognition, pushing the boundaries of what's possible within the VR realm. In essence, VR Programmers are architects of the future, shaping the next generation of interactive entertainment. Their skills and vision pave the way for unforgettable journeys into virtual worlds, pushing the boundaries of what games can be.</p>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Salary Resources</h2>
          <div style="display: flex; flex-wrap: wrap; gap: 0.75rem;">
            {salaries.map((s) => (
              <a href={s.url} target="_blank" rel="noopener noreferrer" class="btn btn-blue" style="font-size: 0.85rem;">
                {s.name} &rarr;
              </a>
            ))}
          </div>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Key Responsibilities</h2>
          <ul>
            {responsibilities.map((r) => (
              <li>{r}</li>
            ))}
          </ul>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Learning Resources</h2>
          <ul>
            {resources.map((r) => (
              <li><a href={r.url} target="_blank" rel="noopener noreferrer">{r.name}</a></li>
            ))}
          </ul>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Recommended Books</h2>
          <ul>
            {books.map((b) => (
              <li><a href={b.url} target="_blank" rel="noopener noreferrer">{b.name}</a></li>
            ))}
          </ul>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Tools to Learn</h2>
          <div class="callout callout-info">
            <p>You don&#39;t need to learn all of these — they are some of the more common tools for this role.</p>
          </div>
          <div style="display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.75rem;">
            {tools.map((t) => (
              <span style="background: var(--color-bg); border: 1px solid var(--color-dark); border-radius: 4px; padding: 0.3rem 0.6rem; font-size: 0.85rem;">{t}</span>
            ))}
          </div>
        </div>
      </div>

      <aside class="career-sidebar">
        <h3>Quick Links</h3>
        <div class="card" style="padding: 1rem; margin-bottom: 0.75rem;">
          <strong>📋 Job Boards</strong>
          <p style="font-size: 0.85rem; margin-top: 0.35rem;">
            <a href={`${base}career-guide/job-boards/`}>Browse job boards &rarr;</a>
          </p>
        </div>
        <div class="card" style="padding: 1rem; margin-bottom: 0.75rem;">
          <strong>📚 Resources</strong>
          <p style="font-size: 0.85rem; margin-top: 0.35rem;">
            <a href={`${base}career-guide/resources/`}>Career resources &rarr;</a>
          </p>
        </div>
        <div class="card" style="padding: 1rem;">
          <strong>🎯 All Roles</strong>
          <p style="font-size: 0.85rem; margin-top: 0.35rem;">
            <a href={`${base}career-guide/roles/`}>View all disciplines &rarr;</a>
          </p>
        </div>
      </aside>
    </div>
  </WikiLayout>
</BaseLayout>