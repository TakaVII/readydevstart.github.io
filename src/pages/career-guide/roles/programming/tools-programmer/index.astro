---
import BaseLayout from "../../../../../layouts/BaseLayout.astro";
import WikiLayout from "../../../../../layouts/WikiLayout.astro";
const base = import.meta.env.BASE_URL;

const salaries = [
  { name: "InGameJob", url: "https://ingamejob.com/en/salaries" },
  { name: "Glassdoor", url: "https://www.glassdoor.com/Salaries/tools-programmer-salary-SRCH_KO0,16.htm" },
  { name: "Salary.com", url: "https://www.salary.com/research/salary/position/tools-programmer-salary" },
  { name: "ZipRecruiter", url: "https://www.ziprecruiter.com/Salaries/Tools-Programmer-Salary#Yearly" }
];

const responsibilities = [
  "Design and develop tools that streamline workflows, increase artist/designer efficiency, and add new functionalities to existing editors.",
  "Adapt third-party tools and integrate them seamlessly into the game development pipeline, optimizing for performance and usability.",
  "Develop scripts and automation tools to streamline workflows, handle data manipulation, and reduce manual effort across various game development stages.",
  "Assist artists, designers, and programmers with using custom tools effectively, offering training and documentation to maximize tool utility.",
  "Continuously learn new programming languages, libraries, and game engine features to improve existing tools and develop innovative solutions.",
  "Analyze tool usage and data, identify pain points, and implement optimizations to improve efficiency and workflow speed.",
  "Create clear and detailed documentation for custom tools and internal APIs, facilitating future maintenance and usage by other developers.",
  "Work closely with artists, designers, programmers, and other departments to understand their needs, gather feedback, and tailor tools to specific workflows."
];

const resources = [
  { name: "Mastered’s Games Programming Bootcamp", url: "https://join.mastered.com/games_careers_sb" },
  { name: "What I Learned About Tools Development From Games Industry Legends - GDC Talk by David Lightbown", url: "https://www.youtube.com/watch?v=Zp4tJQJKIPs&ab_channel=GDC" },
  { name: "What Do Tool Programmers Do? by 80Level", url: "https://80.lv/articles/what-do-tool-programmers-do/" },
  { name: "ScreenSkills’ Tools Engineer Profile", url: "https://www.screenskills.com/job-profiles/browse/games/programming/tools-engineer/" },
  { name: "What’s a Tools Engineer? by Bungie", url: "https://www.bungie.net/7/en/News/article/50492" }
];

const books = [
  { name: "Game Programming Patterns by Robert Nystrom", url: "https://www.amazon.com/Game-Programming-Patterns-Robert-Nystrom/dp/0990582906" },
  { name: "Game Development Tool Essentials by (A lot of people)", url: "https://www.amazon.com/Game-Development-Essentials-Paula-Berinstein-ebook/dp/B01JFSOXC8/" },
  { name: "Designing the User Experience of Game Development Tools by David Lightbown", url: "https://www.amazon.com/Designing-User-Experience-Development-Tools/dp/148224019X/" },
  { name: "Game Engine Architecture by Jason Gregory", url: "https://www.amazon.com/Game-Engine-Architecture-Jason-Gregory/dp/1466560010" },
  { name: "Foundations of Game Engine Development by Eric Lengyel", url: "https://www.amazon.com/dp/B087C1X587" }
];

const tools = [
  "Game Engines",
  "Git",
  "Perforce",
  "Python",
  "C++",
  "C#",
  "Mel/Maya Embedded Language",
  "Substance Painter",
  "Houdini",
  "CMake",
  "Pycharm"
];

const sidebarRoles = [
  { name: "AI Programmer", slug: "ai-programmer", current: false },
  { name: "Gameplay Programmer", slug: "gameplay-programmer", current: false },
  { name: "Generalist Programmer", slug: "generalist-programmer", current: false },
  { name: "VR Programmer", slug: "vr-programmer", current: false },
  { name: "Tools Programmer", slug: "tools-programmer", current: true },
  { name: "Network Engineer", slug: "network-engineer", current: false },
  { name: "Engine Programmer", slug: "engine-programmer", current: false },
  { name: "Graphics Programmer", slug: "graphics-programmer", current: false },
  { name: "Audio Programmer", slug: "audio-programmer", current: false },
  { name: "UX/UI Programmer", slug: "ux-ui-programmer", current: false },
  { name: "Physics Programmer", slug: "physics-programmer", current: false }
];
---

<BaseLayout title="Tools Programmer" activeNav="career-guide">
  <WikiLayout title="Tools Programmer" activeNav="career-guide" activeSidebar="roles">
    <div class="career-layout">
      <aside class="career-sidebar">
        <h3>Engineering & Programming Roles</h3>
        {sidebarRoles.map((r) => (
          r.current ? (
            <div class="card" style="padding: 0.75rem; margin-bottom: 0.5rem; border-left: 3px solid var(--color-pink);">
              <strong style="font-size: 0.9rem; color: var(--color-pink);">{r.name}</strong>
            </div>
          ) : (
            <a href={`${base}career-guide/roles/programming/${r.slug}/`} class="card" style="padding: 0.75rem; margin-bottom: 0.5rem; text-decoration: none; display: block;">
              <strong style="font-size: 0.9rem;">{r.name}</strong>
            </a>
          )
        ))}
        <div style="margin-top: 1rem;">
          <a href={`${base}career-guide/roles/programming/`} class="btn btn-gold" style="font-size: 0.8rem; padding: 0.4rem 0.8rem;">&larr; Engineering & Programming</a>
        </div>
      </aside>

      <div class="career-main">
        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>About this Role</h2>
          <p>The Tools Programmer or Tools Engineer operates behind the scenes, crafting the essential instruments that empower artists, designers, and fellow programmers to weave their magic. They are the architects of internal software tools, meticulously sculpting applications that streamline workflows, automate tedious tasks, and ultimately facilitate the birth of captivating game experiences. From building editors for environments and characters to developing pipelines for asset management and version control, their work forms the backbone of efficient development, freeing creative minds to focus on the artistic and technical complexities of the game itself.</p>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Salary Resources</h2>
          <div style="display: flex; flex-wrap: wrap; gap: 0.75rem;">
            {salaries.map((s) => (
              <a href={s.url} target="_blank" rel="noopener noreferrer" class="btn btn-blue" style="font-size: 0.85rem;">
                {s.name} &rarr;
              </a>
            ))}
          </div>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Key Responsibilities</h2>
          <ul>
            {responsibilities.map((r) => (
              <li>{r}</li>
            ))}
          </ul>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Learning Resources</h2>
          <ul>
            {resources.map((r) => (
              <li><a href={r.url} target="_blank" rel="noopener noreferrer">{r.name}</a></li>
            ))}
          </ul>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Recommended Books</h2>
          <ul>
            {books.map((b) => (
              <li><a href={b.url} target="_blank" rel="noopener noreferrer">{b.name}</a></li>
            ))}
          </ul>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Tools to Learn</h2>
          <div class="callout callout-info">
            <p>You don&#39;t need to learn all of these — they are some of the more common tools for this role.</p>
          </div>
          <div style="display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.75rem;">
            {tools.map((t) => (
              <span style="background: var(--color-bg); border: 1px solid var(--color-dark); border-radius: 4px; padding: 0.3rem 0.6rem; font-size: 0.85rem;">{t}</span>
            ))}
          </div>
        </div>
      </div>

      <aside class="career-sidebar">
        <h3>Quick Links</h3>
        <div class="card" style="padding: 1rem; margin-bottom: 0.75rem;">
          <strong>📋 Job Boards</strong>
          <p style="font-size: 0.85rem; margin-top: 0.35rem;">
            <a href={`${base}career-guide/job-boards/`}>Browse job boards &rarr;</a>
          </p>
        </div>
        <div class="card" style="padding: 1rem; margin-bottom: 0.75rem;">
          <strong>📚 Resources</strong>
          <p style="font-size: 0.85rem; margin-top: 0.35rem;">
            <a href={`${base}career-guide/resources/`}>Career resources &rarr;</a>
          </p>
        </div>
        <div class="card" style="padding: 1rem;">
          <strong>🎯 All Roles</strong>
          <p style="font-size: 0.85rem; margin-top: 0.35rem;">
            <a href={`${base}career-guide/roles/`}>View all disciplines &rarr;</a>
          </p>
        </div>
      </aside>
    </div>
  </WikiLayout>
</BaseLayout>