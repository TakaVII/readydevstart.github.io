---
import BaseLayout from "../../../../../layouts/BaseLayout.astro";
import WikiLayout from "../../../../../layouts/WikiLayout.astro";
import RoleGuide from "../../../../../components/RoleGuide.astro";
const base = import.meta.env.BASE_URL;

const salaries = [
  { name: "InGameJob", url: "https://ingamejob.com/en/salaries" },
  { name: "Glassdoor", url: "https://www.glassdoor.com/Salary/Audio-Programmer-Salaries-E5245909.htm" },
  { name: "Salary.com", url: "https://www.salary.com/research/salary/position/audio-programmer-salary" },
  { name: "ZipRecruiter", url: "https://www.ziprecruiter.com/Salaries/Audio-Programmer-Salary#Yearly" }
];

const responsibilities = [
  "Build and integrate audio middleware with the game engine, ensuring smooth playback, triggering, and manipulation of sound effects, music, and dialogue.",
  "Analyze and address memory usage, resource allocation, and processing demands of audio assets to maintain smooth performance without compromising sound quality.",
  "Create scripts and tools to automate tasks, extend engine functionality, and solve specific audio challenges within the game.",
  "Implement systems for dynamic soundscapes, reactive music, and procedural audio effects that respond to player actions and environmental changes.",
  "Synchronize sound effects and music with animations, events, and gameplay actions to create immersive and responsive audio experiences.",
  "Identify and resolve audio glitches, clipping, performance bottlenecks, and inconsistencies across various platforms and hardware configurations.",
  "Collaborate closely with sound designers and composers to understand artistic vision, translate design documents into technical solutions, and optimize audio workflows.",
  "Use C++ and other languages with audio middleware like Wwise and FMOD and with game engine audio systems."
];

const resources = [
  { name: "ScreenSkills’ Audio Programmer Profile", url: "https://www.screenskills.com/job-profiles/browse/games/audio/audio-programmer/" },
  { name: "Wwise 101 Certification Course by Audiokinetic", url: "https://www.audiokinetic.com/en/courses/wwise101/" },
  { name: "FMOD Scripting Examples | Programmer Sounds", url: "https://www.fmod.com/docs/2.03/unity/examples-programmer-sounds.html" },
  { name: "Game Audio Implementation Resources", url: "https://gameaudioimplementation.com/" },
  { name: "Introduction to Digital Filters with Audio Applications by Julius O. Smith III", url: "https://ccrma.stanford.edu/~jos/filters/" },
  { name: "Getting Started with Audio Programming", url: "https://audiodev.blog/newbie-resources/" },
  { name: "Audio Programming Resources by PelleJuul", url: "https://github.com/PelleJuul/audio-programming-resources" },
  { name: "The Audio Programmer Community", url: "https://www.theaudioprogrammer.com/" },
  { name: "JUCE Tutorials", url: "https://juce.com/learn/tutorials/" },
  { name: "How I Got Started With Audio Programming | WolfTalk #001 by Jan Wilczek", url: "https://thewolfsound.com/talk001/" }
];

const books = [
  { name: "Game Audio Programming: Principles and Practices, Volume 1 by Guy Somberg", url: "https://www.amazon.com/Game-Audio-Programming-Principles-Practices/dp/149874673X" },
  { name: "Game Audio Programming 2 by Guy Somberg", url: "https://www.amazon.com/Game-Audio-Programming-Principles-Practices-ebook/dp/B07H36LRB9/" },
  { name: "Game Audio Programming 3 by Guy Somberg", url: "https://www.amazon.com/Game-Audio-Programming-Principles-Practices/dp/0367348047" },
  { name: "Game Audio Programming 4 by Guy Somberg", url: "https://www.amazon.com/Game-Audio-Programming-Principles-Practices/dp/1032361077" },
  { name: "Designing Audio Effect Plugins in C++ by Will Pirkle", url: "https://www.amazon.com/Designing-Audio-Effect-Plugins-C/dp/1138591939" },
  { name: "The Audio Programming Book by Richard Boulanger and Victor Lazzarini", url: "https://www.amazon.com/Audio-Programming-Book-MIT-Press/dp/0262014467" },
  { name: "Game Audio Implementation by Richard Stevens and Dave Raybould", url: "https://www.amazon.com/Game-Audio-Implementation-Practical-Unreal/dp/1138777242/" },
  { name: "Principles of Game Audio and Sound Design by Jean-Luc Sinclair", url: "https://www.amazon.com/Principles-Game-Audio-Sound-Design/dp/1138738972/" },
  { name: "Beep to Boom: The Development of Advanced Runtime Sound Systems for Games and Extended Reality by Simon Goodwin", url: "https://www.amazon.com/Beep-Audio-Engineering-Society-Presents/dp/113854390X/" },
  { name: "The Computer Music Tutorial (2nd Edition) by Curtis Roads", url: "https://www.amazon.com/Computer-Music-Tutorial-second/dp/0262044919" },
  { name: "Game Programming Patterns by Robert Nystrom", url: "https://www.amazon.com/Game-Programming-Patterns-Robert-Nystrom/dp/0990582906" }
];

const tools = [
  "Game Engines",
  "C++",
  "C#",
  "Lua",
  "Wwise",
  "FMOD Studio",
  "MetaSounds (Unreal)",
  "JUCE",
  "Reaper",
  "Pure Data",
  "SuperCollider",
  "Visual Studio",
  "Git"
];

const sidebarRoles = [
  { name: "AI Programmer", slug: "ai-programmer", current: false },
  { name: "Gameplay Programmer", slug: "gameplay-programmer", current: false },
  { name: "Generalist Programmer", slug: "generalist-programmer", current: false },
  { name: "VR Programmer", slug: "vr-programmer", current: false },
  { name: "Tools Programmer", slug: "tools-programmer", current: false },
  { name: "Network Engineer", slug: "network-engineer", current: false },
  { name: "Engine Programmer", slug: "engine-programmer", current: false },
  { name: "Graphics Programmer", slug: "graphics-programmer", current: false },
  { name: "Audio Programmer", slug: "audio-programmer", current: true },
  { name: "UX/UI Programmer", slug: "ux-ui-programmer", current: false },
  { name: "Physics Programmer", slug: "physics-programmer", current: false }
];
---

<BaseLayout title="How to Become an Audio Programmer: Skills, Portfolio & Tools" description="How to become an Audio Programmer in the game industry: step-by-step path, key skills, portfolio tips, salary resources, the tools to learn, and FAQs." activeNav="career-guide">
  <WikiLayout title="Audio Programmer" activeNav="career-guide" activeSidebar="roles">
    <div class="career-layout">
      <aside class="career-sidebar">
        <h3>Engineering & Programming Roles</h3>
        {sidebarRoles.map((r) => (
          r.current ? (
            <div class="card" style="padding: 0.75rem; margin-bottom: 0.5rem; border-left: 3px solid var(--color-pink);">
              <strong style="font-size: 0.9rem; color: var(--color-pink);">{r.name}</strong>
            </div>
          ) : (
            <a href={`${base}career-guide/roles/programming/${r.slug}/`} class="card" style="padding: 0.75rem; margin-bottom: 0.5rem; text-decoration: none; display: block;">
              <strong style="font-size: 0.9rem;">{r.name}</strong>
            </a>
          )
        ))}
        <div style="margin-top: 1rem;">
          <a href={`${base}career-guide/roles/programming/`} class="btn btn-gold" style="font-size: 0.8rem; padding: 0.4rem 0.8rem;">&larr; Engineering & Programming</a>
        </div>
      </aside>

      <div class="career-main">
        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>About this Role</h2>
          <p>Audio programmers are the tech wizards behind the scenes of your favorite video games, including virtual reality experiences. They're the ones who take all the sound effects, music, and dialogue and make sure they play at the right time, in the right place, and sound amazing. They use their coding skills to integrate audio into game engines, ensuring smooth playback, high quality, and minimal processing power usage. Think of them as the invisible conductors of the immersive audio orchestra that brings these interactive worlds to life. In short, audio programmers are the bridge between the creative world of sound design and the technical world of software development. They're the ones who make sure that all the sonic elements come together to create a truly unforgettable audio experience.</p>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Salary Resources</h2>
          <div style="display: flex; flex-wrap: wrap; gap: 0.75rem;">
            {salaries.map((s) => (
              <a href={s.url} target="_blank" rel="noopener noreferrer" class="btn btn-blue" style="font-size: 0.85rem;">
                {s.name} &rarr;
              </a>
            ))}
          </div>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Key Responsibilities</h2>
          <ul>
            {responsibilities.map((r) => (
              <li>{r}</li>
            ))}
          </ul>
        </div>

        <RoleGuide slug="audio-programmer" part="guide" />

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Learning Resources</h2>
          <ul>
            {resources.map((r) => (
              <li><a href={r.url} target="_blank" rel="noopener noreferrer">{r.name}</a></li>
            ))}
          </ul>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Recommended Books</h2>
          <ul>
            {books.map((b) => (
              <li><a href={b.url} target="_blank" rel="noopener noreferrer">{b.name}</a></li>
            ))}
          </ul>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Tools to Learn</h2>
          <div class="callout callout-info">
            <p>You don&#39;t need to learn all of these — they are some of the more common tools for this role.</p>
          </div>
          <div style="display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.75rem;">
            {tools.map((t) => (
              <span style="background: var(--color-bg); border: 1px solid var(--color-dark); border-radius: 4px; padding: 0.3rem 0.6rem; font-size: 0.85rem;">{t}</span>
            ))}
          </div>
        </div>

        <RoleGuide slug="audio-programmer" part="faq" />
      </div>

      <aside class="career-sidebar">
        <h3>Quick Links</h3>
        <div class="card" style="padding: 1rem; margin-bottom: 0.75rem;">
          <strong>📋 Job Boards</strong>
          <p style="font-size: 0.85rem; margin-top: 0.35rem;">
            <a href={`${base}career-guide/job-boards/`}>Browse job boards &rarr;</a>
          </p>
        </div>
        <div class="card" style="padding: 1rem; margin-bottom: 0.75rem;">
          <strong>📚 Resources</strong>
          <p style="font-size: 0.85rem; margin-top: 0.35rem;">
            <a href={`${base}career-guide/resources/`}>Career resources &rarr;</a>
          </p>
        </div>
        <div class="card" style="padding: 1rem;">
          <strong>🎯 All Roles</strong>
          <p style="font-size: 0.85rem; margin-top: 0.35rem;">
            <a href={`${base}career-guide/roles/`}>View all disciplines &rarr;</a>
          </p>
        </div>
      </aside>
    </div>
  </WikiLayout>
</BaseLayout>