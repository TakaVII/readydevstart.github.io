---
import BaseLayout from "../../../../../layouts/BaseLayout.astro";
import WikiLayout from "../../../../../layouts/WikiLayout.astro";
import RoleGuide from "../../../../../components/RoleGuide.astro";
const base = import.meta.env.BASE_URL;

const salaries = [
  { name: "InGameJob", url: "https://ingamejob.com/en/salaries" },
  { name: "Glassdoor", url: "https://www.glassdoor.com/Salaries/ui-programmer-salary-SRCH_KO0,13.htm" },
  { name: "Salary.com", url: "https://www.salary.com/research/salary/opening/ui-ux-developer-salary" },
  { name: "ZipRecruiter", url: "https://www.ziprecruiter.com/Salaries/Ux-Ui-Programmer-Salary#Yearly" }
];

const responsibilities = [
  "Bring to life menus, buttons, HUDs, inventories, character customization screens, and other interactive elements, ensuring they are intuitive, visually appealing, and responsive to player input.",
  "Ensure smooth transitions, minimal loading times, and consistent frame rates across various devices and platforms, delivering a smooth user experience.",
  "Connect UI elements with gameplay mechanics, player data, and game events, providing feedback, information, and control options that enhance player immersion.",
  "Collaborate with UX designers to create logical and intuitive user journeys, guiding players through game interactions and features effortlessly.",
  "Ensure UI elements are usable for players with visual, auditory, or motor impairments, promoting inclusivity and diverse player experiences.",
  "Build reusable UI components, styles, and layout rules so every screen stays consistent with the visual standards set by UI artists and designers.",
  "Rapidly create prototypes to test UI concepts, gather player feedback, and refine designs iteratively to optimize usability and player experience.",
  "Work closely with UX designers, UI artists, and animators to create visually appealing and functional interfaces that align with the game's overall aesthetic and narrative."
];

const resources = [
  { name: "Game UI Database", url: "https://gameuidatabase.com/" },
  { name: "Getting Started with UI Toolkit by Unity Learn", url: "https://learn.unity.com/tutorial/getting-started-with-ui-toolkit" },
  { name: "Your First Hour in UMG by Epic Games", url: "https://dev.epicgames.com/community/learning/courses/D7P/your-first-hour-in-umg" },
  { name: "Game Accessibility Guidelines", url: "https://gameaccessibilityguidelines.com/" },
  { name: "Game UX Resources for getting into the industry", url: "https://medium.com/design-bootcamp/game-ux-resources-for-getting-into-the-industry-29350545017d" },
  { name: "What Is Games ‘User Experience’ (UX) and How Does It Help?", url: "https://playerresearch.medium.com/what-is-games-user-experience-ux-and-how-does-it-help-ea35ceaa9f05" },
  { name: "Game UI Design: Everything You Need To Know", url: "https://careerfoundry.com/en/blog/ui-design/game-ui-design/" }
];

const books = [
  { name: "The Gamer's Brain: How Neuroscience and UX Can Impact Video Game Design by Celia Hodent", url: "https://www.amazon.com/Gamers-Brain-Neuroscience-Impact-Design/dp/1498775500" },
  { name: "Game Usability (2nd Edition) by Katherine Isbister and Celia Hodent", url: "https://www.amazon.com/dp/0367619923" },
  { name: "Don't Make Me Think, Revisited: A Common Sense Approach to Web Usability by Steve Krug", url: "https://www.amazon.com/Dont-Make-Think-Revisited-Usability/dp/0321965515" },
  { name: "Game Programming Patterns by Robert Nystrom", url: "https://www.amazon.com/Game-Programming-Patterns-Robert-Nystrom/dp/0990582906" },
  { name: "What UX is Really About: Introducing a Mindset for Great Experiences by Celia Hodent", url: "https://www.amazon.com/What-Really-About-Celia-Hodent/dp/1032104449" },
  { name: "The Secret Science of Games by John Hopson", url: "https://www.amazon.com/The-Secret-Science-of-Games/dp/B0C3T6PSBS/" },
  { name: "The Design Of Everyday Things by Don Norman", url: "https://www.amazon.com/Design-Everyday-Things-Revised-Expanded/dp/0465050654" }
];

const tools = [
  "Game Engines",
  "C++",
  "C#",
  "Unity UI Toolkit",
  "Unity UI (uGUI)",
  "Unreal Motion Graphics (UMG)",
  "Common UI (Unreal)",
  "Shader Graph",
  "Figma",
  "Adobe Photoshop",
  "After Effects",
  "Rive",
  "Coherent Gameface",
  "NoesisGUI"
];

const sidebarRoles = [
  { name: "AI Programmer", slug: "ai-programmer", current: false },
  { name: "Gameplay Programmer", slug: "gameplay-programmer", current: false },
  { name: "Generalist Programmer", slug: "generalist-programmer", current: false },
  { name: "VR Programmer", slug: "vr-programmer", current: false },
  { name: "Tools Programmer", slug: "tools-programmer", current: false },
  { name: "Network Engineer", slug: "network-engineer", current: false },
  { name: "Engine Programmer", slug: "engine-programmer", current: false },
  { name: "Graphics Programmer", slug: "graphics-programmer", current: false },
  { name: "Audio Programmer", slug: "audio-programmer", current: false },
  { name: "UX/UI Programmer", slug: "ux-ui-programmer", current: true },
  { name: "Physics Programmer", slug: "physics-programmer", current: false }
];
---

<BaseLayout title="How to Become a UX/UI Programmer: Skills, Portfolio & Tools" description="How to become a UX/UI Programmer in the game industry: step-by-step path, key skills, portfolio tips, salary resources, the tools to learn, and FAQs." activeNav="career-guide">
  <WikiLayout title="UX/UI Programmer" activeNav="career-guide" activeSidebar="roles">
    <div class="career-layout">
      <aside class="career-sidebar">
        <h3>Engineering & Programming Roles</h3>
        {sidebarRoles.map((r) => (
          r.current ? (
            <div class="card" style="padding: 0.75rem; margin-bottom: 0.5rem; border-left: 3px solid var(--color-pink);">
              <strong style="font-size: 0.9rem; color: var(--color-pink);">{r.name}</strong>
            </div>
          ) : (
            <a href={`${base}career-guide/roles/programming/${r.slug}/`} class="card" style="padding: 0.75rem; margin-bottom: 0.5rem; text-decoration: none; display: block;">
              <strong style="font-size: 0.9rem;">{r.name}</strong>
            </a>
          )
        ))}
        <div style="margin-top: 1rem;">
          <a href={`${base}career-guide/roles/programming/`} class="btn btn-gold" style="font-size: 0.8rem; padding: 0.4rem 0.8rem;">&larr; Engineering & Programming</a>
        </div>
      </aside>

      <div class="career-main">
        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>About this Role</h2>
          <p>The UX/UI Programmer stands as the bridge between technical expertise and player experience. They shape the game's interfaces and interactions, ensuring smooth navigation, intuitive controls, and a visually pleasing aesthetic. Their responsibilities encompass both front-end development, building the UI elements players see and interact with, and back-end integration, connecting those elements to the game's core systems. They collaborate with designers and programmers, translating visual concepts into functional code and optimizing interactions for maximum user comfort and clarity, crucial for creating user-friendly and engaging experiences that keep players immersed in the game's world.</p>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Salary Resources</h2>
          <div style="display: flex; flex-wrap: wrap; gap: 0.75rem;">
            {salaries.map((s) => (
              <a href={s.url} target="_blank" rel="noopener noreferrer" class="btn btn-blue" style="font-size: 0.85rem;">
                {s.name} &rarr;
              </a>
            ))}
          </div>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Key Responsibilities</h2>
          <ul>
            {responsibilities.map((r) => (
              <li>{r}</li>
            ))}
          </ul>
        </div>

        <RoleGuide slug="ux-ui-programmer" part="guide" />

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Learning Resources</h2>
          <ul>
            {resources.map((r) => (
              <li><a href={r.url} target="_blank" rel="noopener noreferrer">{r.name}</a></li>
            ))}
          </ul>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Recommended Books</h2>
          <ul>
            {books.map((b) => (
              <li><a href={b.url} target="_blank" rel="noopener noreferrer">{b.name}</a></li>
            ))}
          </ul>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Tools to Learn</h2>
          <div class="callout callout-info">
            <p>You don&#39;t need to learn all of these — they are some of the more common tools for this role.</p>
          </div>
          <div style="display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.75rem;">
            {tools.map((t) => (
              <span style="background: var(--color-bg); border: 1px solid var(--color-dark); border-radius: 4px; padding: 0.3rem 0.6rem; font-size: 0.85rem;">{t}</span>
            ))}
          </div>
        </div>

        <RoleGuide slug="ux-ui-programmer" part="faq" />
      </div>

      <aside class="career-sidebar">
        <h3>Quick Links</h3>
        <div class="card" style="padding: 1rem; margin-bottom: 0.75rem;">
          <strong>📋 Job Boards</strong>
          <p style="font-size: 0.85rem; margin-top: 0.35rem;">
            <a href={`${base}career-guide/job-boards/`}>Browse job boards &rarr;</a>
          </p>
        </div>
        <div class="card" style="padding: 1rem; margin-bottom: 0.75rem;">
          <strong>📚 Resources</strong>
          <p style="font-size: 0.85rem; margin-top: 0.35rem;">
            <a href={`${base}career-guide/resources/`}>Career resources &rarr;</a>
          </p>
        </div>
        <div class="card" style="padding: 1rem;">
          <strong>🎯 All Roles</strong>
          <p style="font-size: 0.85rem; margin-top: 0.35rem;">
            <a href={`${base}career-guide/roles/`}>View all disciplines &rarr;</a>
          </p>
        </div>
      </aside>
    </div>
  </WikiLayout>
</BaseLayout>