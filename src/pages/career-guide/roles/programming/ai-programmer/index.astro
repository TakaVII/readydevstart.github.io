---
import BaseLayout from "../../../../../layouts/BaseLayout.astro";
import WikiLayout from "../../../../../layouts/WikiLayout.astro";
const base = import.meta.env.BASE_URL;

const salaries = [
  { name: "InGameJob", url: "https://ingamejob.com/en/salaries" },
  { name: "Glassdoor", url: "https://www.glassdoor.com/Salaries/artificial-intelligence-programmer-salary-SRCH_KO0,34.htm" },
  { name: "Salary.com", url: "https://www.salary.com/research/salary/recruiting/ai-programmer-salary" },
  { name: "ZipRecruiter", url: "https://www.ziprecruiter.com/Salaries/Ai-Programmer-Salary#Yearly" }
];

const responsibilities = [
  "Define AI goals and behaviors for characters, enemies, and environments, crafting algorithms and decision trees to govern their actions and reactions.",
  "Seamlessly integrate AI code with the game engine, ensuring smooth interaction between AI entities and other game elements like physics, environment, and player actions.",
  "Tune AI algorithms and resource allocation to achieve desired behavior while maintaining smooth gameplay performance and frame rate.",
  "Design AI difficulty levels and progression curves that offer a rewarding challenge for players, encouraging engagement and avoiding frustration.",
  "Craft diverse and dynamic AI behaviors that mimic natural movement, decision-making, and reactions to create immersive and unpredictable gameplay experiences.",
  "Implement machine learning algorithms like reinforcement learning and neural networks to enable AI agents to learn, adapt, and improve over time.",
  "Work closely with game designers, programmers, artists, and animators to ensure AI systems seamlessly fit within the game's narrative, environment, and visual style.",
  "Continuously learn about emerging AI research, tools, and techniques to utilize the latest advancements and keep AI systems innovative and engaging.",
  "Identify and fix bugs and unexpected behaviors in AI systems, ensuring optimal performance and a smooth player experience.",
  "Clearly document AI algorithms, decision trees, and design choices to facilitate future maintenance and collaboration with other developers."
];

const resources = [
  { name: "Mastered’s Games Programming Bootcamp", url: "https://join.mastered.com/games_careers_sb" },
  { name: "ScreenSkills’ AI Programmer Profile", url: "https://www.screenskills.com/job-profiles/browse/games/programming/artificial-intelligence-ai-programmer/" },
  { name: "The Total Beginner's Guide to Game AI by Ben Sizer", url: "https://www.gamedev.net/tutorials/programming/artificial-intelligence/the-total-beginners-guide-to-game-ai-r4942/" },
  { name: "Introduction to AI Programming for Games by Kodeco", url: "https://www.kodeco.com/2808-introduction-to-ai-programming-for-games" },
  { name: "AI Programming for Games by GameDesigning", url: "https://www.gamedesigning.org/career/ai-programmer/" },
  { name: "AI in Gaming | 5 Biggest Innovations (+40 AI Games)", url: "https://www.engati.com/blog/ai-in-gaming" },
  { name: "AI for Game Developers by David M Bourg, Glenn Seemann", url: "https://www.oreilly.com/library/view/ai-for-game/0596005555/ch01.html" },
  { name: "An Introduction to Utility Theory by David “Rez” Graham", url: "http://www.gameaipro.com/GameAIPro/GameAIPro_Chapter09_An_Introduction_to_Utility_Theory.pdf" },
  { name: "Improving AI Decision Modeling Through Utility Theory - GDC Talk by Kevin Dill and Dave Mark", url: "https://www.gdcvault.com/play/1012410/Improving-AI-Decision-Modeling-Through" },
  { name: "Winding Road Ahead: Designing Utility AI with Curvature - GDC Talk by Mike Lewis", url: "https://www.youtube.com/watch?v=TCf1GdRrerw&ab_channel=GDC" },
  { name: "Awesome Game AI materials of Multi-Agent Reinforcement Learning", url: "https://github.com/datamllab/awesome-game-ai" },
  { name: "Game AI: The State of the Industry", url: "https://www.gamedeveloper.com/design/game-ai-the-state-of-the-industry" }
];

const books = [
  { name: "Game Programming Patterns by Robert Nystrom", url: "https://www.amazon.com/Game-Programming-Patterns-Robert-Nystrom/dp/0990582906" },
  { name: "AI for Games by Ian Millington", url: "https://www.amazon.com/AI-Games-Third-Ian-Millington/dp/1138483974/" },
  { name: "Programming Game AI by Example by Mat Buckland", url: "https://www.amazon.com/Programming-Example-Wordware-Developers-Library/dp/1556220782/" },
  { name: "Game AI Pro by Steven Rabin", url: "https://www.amazon.com/Game-AI-Pro-Steven-Rabin/dp/1032477458/" },
  { name: "Artificial Intelligence and Games by Georgios N. Yannakakis and Julian Togelius", url: "https://www.amazon.com/Artificial-Intelligence-Games-Georgios-Yannakakis-ebook/dp/B079WGWJB9/" },
  { name: "AI for Game Developers: Creating Intelligent Behavior in Games by David M. Bourg and Glenn Seemann", url: "https://www.amazon.com/AI-Game-Developers-Creating-Intelligent/dp/0596005555/" },
  { name: "Behavioral Mathematics for Game AI by Dave Mark", url: "https://www.amazon.com/Behavioral-Mathematics-Game-AI-Applied/dp/1584506849/" },
  { name: "AI Techniques for Game Programming by Mat Buckland", url: "https://www.amazon.com/Techniques-Programming-Premier-Press-Development/dp/193184108X/" },
  { name: "Game AI Pro 360: Guide to Tactics and Strategy by Steve Rabin", url: "https://www.amazon.com/Game-AI-Pro-360-Strategy-ebook/dp/B07XJ88HPD/" },
  { name: "AI Game Programming Wisdom by Steve Rabin", url: "https://www.amazon.com/AI-Game-Programming-Wisdom-Development/dp/1584500778" }
];

const tools = [
  "Game Engines",
  "TensorFlow",
  "PyTorch",
  "Scikit-learn",
  "Unity ML-Agents Toolkit",
  "Keras",
  "Pandas",
  "NumPy",
  "OpenAI Gym",
  "OpenCV",
  "Jupyter Notebook",
  "Git",
  "PyCharm",
  "Blender",
  "Houdini"
];

const sidebarRoles = [
  { name: "AI Programmer", slug: "ai-programmer", current: true },
  { name: "Gameplay Programmer", slug: "gameplay-programmer", current: false },
  { name: "Generalist Programmer", slug: "generalist-programmer", current: false },
  { name: "VR Programmer", slug: "vr-programmer", current: false },
  { name: "Tools Programmer", slug: "tools-programmer", current: false },
  { name: "Network Engineer", slug: "network-engineer", current: false },
  { name: "Engine Programmer", slug: "engine-programmer", current: false },
  { name: "Graphics Programmer", slug: "graphics-programmer", current: false },
  { name: "Audio Programmer", slug: "audio-programmer", current: false },
  { name: "UX/UI Programmer", slug: "ux-ui-programmer", current: false },
  { name: "Physics Programmer", slug: "physics-programmer", current: false }
];
---

<BaseLayout title="AI Programmer" activeNav="career-guide">
  <WikiLayout title="AI Programmer" activeNav="career-guide" activeSidebar="roles">
    <div class="career-layout">
      <aside class="career-sidebar">
        <h3>Engineering & Programming Roles</h3>
        {sidebarRoles.map((r) => (
          r.current ? (
            <div class="card" style="padding: 0.75rem; margin-bottom: 0.5rem; border-left: 3px solid var(--color-pink);">
              <strong style="font-size: 0.9rem; color: var(--color-pink);">{r.name}</strong>
            </div>
          ) : (
            <a href={`${base}career-guide/roles/programming/${r.slug}/`} class="card" style="padding: 0.75rem; margin-bottom: 0.5rem; text-decoration: none; display: block;">
              <strong style="font-size: 0.9rem;">{r.name}</strong>
            </a>
          )
        ))}
        <div style="margin-top: 1rem;">
          <a href={`${base}career-guide/roles/programming/`} class="btn btn-gold" style="font-size: 0.8rem; padding: 0.4rem 0.8rem;">&larr; Engineering & Programming</a>
        </div>
      </aside>

      <div class="career-main">
        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>About this Role</h2>
          <p>An AI Programmer is the architect of intelligent behavior within the virtual world. They design and implement algorithms that power the brains of non-player characters (NPCs), enemies, and even environmental elements. Their code dictates how these entities react to players, make decisions, and adapt to the unfolding narrative. The work involves expertise in various areas like machine learning, pathfinding algorithms, and scripting languages. AI Programmers create diverse behaviors, from basic pathfinding and combat routines to complex decision trees that simulate individual personalities and emotional responses. Their goal is to breathe life into the game world, making it feel dynamic, believable, and engaging for players to explore and interact with.</p>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Salary Resources</h2>
          <div style="display: flex; flex-wrap: wrap; gap: 0.75rem;">
            {salaries.map((s) => (
              <a href={s.url} target="_blank" rel="noopener noreferrer" class="btn btn-blue" style="font-size: 0.85rem;">
                {s.name} &rarr;
              </a>
            ))}
          </div>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Key Responsibilities</h2>
          <ul>
            {responsibilities.map((r) => (
              <li>{r}</li>
            ))}
          </ul>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Learning Resources</h2>
          <ul>
            {resources.map((r) => (
              <li><a href={r.url} target="_blank" rel="noopener noreferrer">{r.name}</a></li>
            ))}
          </ul>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Recommended Books</h2>
          <ul>
            {books.map((b) => (
              <li><a href={b.url} target="_blank" rel="noopener noreferrer">{b.name}</a></li>
            ))}
          </ul>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Tools to Learn</h2>
          <div class="callout callout-info">
            <p>You don&#39;t need to learn all of these — they are some of the more common tools for this role.</p>
          </div>
          <div style="display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.75rem;">
            {tools.map((t) => (
              <span style="background: var(--color-bg); border: 1px solid var(--color-dark); border-radius: 4px; padding: 0.3rem 0.6rem; font-size: 0.85rem;">{t}</span>
            ))}
          </div>
        </div>
      </div>

      <aside class="career-sidebar">
        <h3>Quick Links</h3>
        <div class="card" style="padding: 1rem; margin-bottom: 0.75rem;">
          <strong>📋 Job Boards</strong>
          <p style="font-size: 0.85rem; margin-top: 0.35rem;">
            <a href={`${base}career-guide/job-boards/`}>Browse job boards &rarr;</a>
          </p>
        </div>
        <div class="card" style="padding: 1rem; margin-bottom: 0.75rem;">
          <strong>📚 Resources</strong>
          <p style="font-size: 0.85rem; margin-top: 0.35rem;">
            <a href={`${base}career-guide/resources/`}>Career resources &rarr;</a>
          </p>
        </div>
        <div class="card" style="padding: 1rem;">
          <strong>🎯 All Roles</strong>
          <p style="font-size: 0.85rem; margin-top: 0.35rem;">
            <a href={`${base}career-guide/roles/`}>View all disciplines &rarr;</a>
          </p>
        </div>
      </aside>
    </div>
  </WikiLayout>
</BaseLayout>