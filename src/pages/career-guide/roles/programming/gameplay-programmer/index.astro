---
import BaseLayout from "../../../../../layouts/BaseLayout.astro";
import WikiLayout from "../../../../../layouts/WikiLayout.astro";
const base = import.meta.env.BASE_URL;

const salaries = [
  { name: "InGameJob", url: "https://ingamejob.com/en/salaries" },
  { name: "Glassdoor", url: "https://www.glassdoor.com/Salaries/gameplay-programmer-salary-SRCH_KO0,19.htm" },
  { name: "Salary.com", url: "https://www.salary.com/research/salary/hiring/gameplay-programmer-salary" },
  { name: "ZipRecruiter", url: "https://www.ziprecruiter.com/Salaries/Gameplay-Programmer-Salary#Yearly" }
];

const responsibilities = [
  "Translate game design documents and concepts into code, building the fundamental systems that govern player movement, interactions, combat, and progression.",
  "Analyze and troubleshoot performance bottlenecks, implement optimizations to maintain smooth gameplay frame rates and responsiveness across various platforms.",
  "Connect different game features like physics, animation, audio, and rendering, ensuring seamless interaction and a cohesive gameplay experience.",
  "Implement systems for balancing character abilities, enemy difficulty, resource management, and progression curves to create a fair and engaging challenge for players.",
  "Identify and fix bugs, glitches, and unintended behaviors in gameplay mechanics, ensuring a polished and satisfying player experience.",
  "Develop rapid prototypes and iterate on mechanics through testing to refine gameplay elements and ensure functionality before integration into the main game.",
  "Work closely with game designers, artists, animators, and programmers to ensure gameplay aligns with the overall vision and integrates seamlessly with other game elements.",
  "Clearly document your code, gameplay algorithms, and design decisions to facilitate future maintenance and collaboration with other developers."
];

const resources = [
  { name: "Mastered’s Games Programming Bootcamp", url: "https://join.mastered.com/games_careers_sb" },
  { name: "ScreenSkills’ Gameplay Programmer Profile", url: "https://www.screenskills.com/job-profiles/browse/games/programming/gameplay-programmer/" },
  { name: "Into Games’ Gameplay Programmer Profile", url: "https://intogames.org/role/gameplay-programmer/" },
  { name: "Gameplay Programming Best Practices by eLearning Industry", url: "https://elearningindustry.com/gameplay-programming-best-practices" },
  { name: "Gameplay Programmer Accreditation by CDA", url: "https://certifieddigitalartist.com/games-gameplay-programmer/" },
  { name: "Working on Video Games as a Gameplay Programmer", url: "https://www.codingame.com/blog/video-games-gameplay-programmer/" },
  { name: "2 months of Gameplay Programming by @Randy", url: "https://www.youtube.com/watch?v=0_2NtACW8XI&ab_channel=Randy" },
  { name: "Gameplay Programming is More Than Just Writing Code", url: "https://www.dsdambuster.com/blog/gameplay-programming-is-more-than-just-writing-code-part-one" }
];

const books = [
  { name: "Game Programming Patterns by Robert Nystrom", url: "https://www.amazon.com/Game-Programming-Patterns-Robert-Nystrom/dp/0990582906" },
  { name: "Game Engine Architecture by Jason Gregory", url: "https://www.amazon.com/Engine-Architecture-Third-Jason-Gregory/dp/1138035459/" },
  { name: "Game Design Workshop: A Playcentric Approach to Creating Innovative Games by Tracy Fullerton", url: "https://www.amazon.com/Game-Design-Workshop-Playcentric-Innovative/dp/1138098779/" },
  { name: "Game Programming Algorithms and Techniques: A Platform-Agnostic Approach by Sanjay Madhav", url: "https://www.amazon.com/Game-Programming-Algorithms-Techniques-Platform-Agnostic-ebook/dp/B00HCHUU90/" }
];

const tools = [
  "Game Engines",
  "C#",
  "C++",
  "Python",
  "Git",
  "CMake",
  "Havok Physics",
  "Oculus SDK",
  "OpenXR",
  "TensorFlow",
  "PyTorch",
  "Protobuf",
  "Wireshark",
  "Valgrind",
  "MemorySanitizer",
  "JProfiler",
  "Cppcheck",
  "Static Code Analysis Tool",
  "Postman",
  "REST Client"
];

const sidebarRoles = [
  { name: "AI Programmer", slug: "ai-programmer", current: false },
  { name: "Gameplay Programmer", slug: "gameplay-programmer", current: true },
  { name: "Generalist Programmer", slug: "generalist-programmer", current: false },
  { name: "VR Programmer", slug: "vr-programmer", current: false },
  { name: "Tools Programmer", slug: "tools-programmer", current: false },
  { name: "Network Engineer", slug: "network-engineer", current: false },
  { name: "Engine Programmer", slug: "engine-programmer", current: false },
  { name: "Graphics Programmer", slug: "graphics-programmer", current: false },
  { name: "Audio Programmer", slug: "audio-programmer", current: false },
  { name: "UX/UI Programmer", slug: "ux-ui-programmer", current: false },
  { name: "Physics Programmer", slug: "physics-programmer", current: false }
];
---

<BaseLayout title="Gameplay Programmer" activeNav="career-guide">
  <WikiLayout title="Gameplay Programmer" activeNav="career-guide" activeSidebar="roles">
    <div class="career-layout">
      <aside class="career-sidebar">
        <h3>Engineering & Programming Roles</h3>
        {sidebarRoles.map((r) => (
          r.current ? (
            <div class="card" style="padding: 0.75rem; margin-bottom: 0.5rem; border-left: 3px solid var(--color-pink);">
              <strong style="font-size: 0.9rem; color: var(--color-pink);">{r.name}</strong>
            </div>
          ) : (
            <a href={`${base}career-guide/roles/programming/${r.slug}/`} class="card" style="padding: 0.75rem; margin-bottom: 0.5rem; text-decoration: none; display: block;">
              <strong style="font-size: 0.9rem;">{r.name}</strong>
            </a>
          )
        ))}
        <div style="margin-top: 1rem;">
          <a href={`${base}career-guide/roles/programming/`} class="btn btn-gold" style="font-size: 0.8rem; padding: 0.4rem 0.8rem;">&larr; Engineering & Programming</a>
        </div>
      </aside>

      <div class="career-main">
        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>About this Role</h2>
          <p>Gameplay Programmers are the ones who translate game design concepts into the code that makes characters move, objects react, and players engage. Their work touches every facet of the game's core experience, from combat mechanics and enemy AI to level interactions and resource management. Gameplay programmers are problem solvers at heart. They combine strong coding skills with a deep understanding of game mechanics and physics. They collaborate closely with game designers to ensure features function as intended, optimize performance for smooth gameplay, and debug any issues that arise. Their ability to bring game concepts to life through efficient and creative code is essential for creating a truly enjoyable and engaging experience for players.</p>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Salary Resources</h2>
          <div style="display: flex; flex-wrap: wrap; gap: 0.75rem;">
            {salaries.map((s) => (
              <a href={s.url} target="_blank" rel="noopener noreferrer" class="btn btn-blue" style="font-size: 0.85rem;">
                {s.name} &rarr;
              </a>
            ))}
          </div>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Key Responsibilities</h2>
          <ul>
            {responsibilities.map((r) => (
              <li>{r}</li>
            ))}
          </ul>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Learning Resources</h2>
          <ul>
            {resources.map((r) => (
              <li><a href={r.url} target="_blank" rel="noopener noreferrer">{r.name}</a></li>
            ))}
          </ul>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Recommended Books</h2>
          <ul>
            {books.map((b) => (
              <li><a href={b.url} target="_blank" rel="noopener noreferrer">{b.name}</a></li>
            ))}
          </ul>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Tools to Learn</h2>
          <div class="callout callout-info">
            <p>You don&#39;t need to learn all of these — they are some of the more common tools for this role.</p>
          </div>
          <div style="display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.75rem;">
            {tools.map((t) => (
              <span style="background: var(--color-bg); border: 1px solid var(--color-dark); border-radius: 4px; padding: 0.3rem 0.6rem; font-size: 0.85rem;">{t}</span>
            ))}
          </div>
        </div>
      </div>

      <aside class="career-sidebar">
        <h3>Quick Links</h3>
        <div class="card" style="padding: 1rem; margin-bottom: 0.75rem;">
          <strong>📋 Job Boards</strong>
          <p style="font-size: 0.85rem; margin-top: 0.35rem;">
            <a href={`${base}career-guide/job-boards/`}>Browse job boards &rarr;</a>
          </p>
        </div>
        <div class="card" style="padding: 1rem; margin-bottom: 0.75rem;">
          <strong>📚 Resources</strong>
          <p style="font-size: 0.85rem; margin-top: 0.35rem;">
            <a href={`${base}career-guide/resources/`}>Career resources &rarr;</a>
          </p>
        </div>
        <div class="card" style="padding: 1rem;">
          <strong>🎯 All Roles</strong>
          <p style="font-size: 0.85rem; margin-top: 0.35rem;">
            <a href={`${base}career-guide/roles/`}>View all disciplines &rarr;</a>
          </p>
        </div>
      </aside>
    </div>
  </WikiLayout>
</BaseLayout>