---
import BaseLayout from "../../../../../layouts/BaseLayout.astro";
import WikiLayout from "../../../../../layouts/WikiLayout.astro";
const base = import.meta.env.BASE_URL;

const salaries = [
  { name: "InGameJob", url: "https://ingamejob.com/en/salaries" },
  { name: "Glassdoor", url: "https://www.glassdoor.com/Salaries/voiceover-artist-salary-SRCH_KO0,16.htm" },
  { name: "Salary.com", url: "https://www.salary.com/research/salary/position/voiceover-artist-salary" },
  { name: "ZipRecruiter", url: "https://www.ziprecruiter.com/Salaries/voiceover-Artist-Salary" }
];

const responsibilities = [
  "Deliver expressive and engaging vocal performances for in-game characters, narrators, announcements, and tutorials, drawing players into the story and enhancing immersion.",
  "Master a wide range of accents, dialects, and emotional tones to portray different characters, environments, and gameplay situations convincingly.",
  "Work closely with game directors and sound designers to understand character personalities, narrative arcs, and desired vocal styles, ensuring cohesion with the overall audio design.",
  "Deliver clean and consistent recordings, adhering to timing cues, pronunciation guides, and technical specifications provided by the audio team.",
  "Express subtle emotions, reactions, and nuances within the dialogue to deepen character portrayal and enhance player engagement.",
  "Analyze scripts for tone, character motivations, and pacing, translating textual intent into impactful vocal performances.",
  "Openly receive feedback from directors and sound designers, adjust deliveries, and refine performances to achieve the desired results."
];

const resources = [
  { name: "Game Audio Implementation Resources", url: "https://gameaudioimplementation.com/" },
  { name: "The Voice Over Resource Guide", url: "https://voiceoverresourceguide.com/" },
  { name: "The Voice Over Roadmap Resource Guide", url: "https://www.voiceoverroadmap.com/resources" },
  { name: "Voiceover Training Resources by VoiceOverKickstart", url: "https://voiceoverkickstart.com/voiceover-training-resources-and-advice/" },
  { name: "I’m New To Voice Over, How Do I Get Started?", url: "https://www.voiceshopcoaching.com/voice-over-resources" },
  { name: "Global Voice Acting Academy Resources", url: "https://globalvoiceacademy.com/resources/" },
  { name: "Voice Acting Resource List by Tracy Lindley", url: "https://tracylindley.com/resources/" },
  { name: "How to Become a Video Game Voice Actor by Kevin Redding", url: "https://www.backstage.com/magazine/article/video-game-voice-actor-guide-75034/" },
  { name: "Video Game Archetypes", url: "https://voiceoverkickstart.com/video-game-archetypes/" }
];

const books = [
  { name: "Game Audio Mixing by Alex Riviere", url: "https://www.amazon.com/Game-Audio-Mixing-Alex-Riviere/dp/1032397357/ref=sr_1_14" },
  { name: "The Art of Game Design by Jesse Schell", url: "https://www.amazon.com/Art-Game-Design-Lenses-Third-ebook/dp/B07X59RN6N" },
  { name: "Sound Synthesis and Sampling by Martin Russ", url: "https://www.amazon.com/Sound-Synthesis-Sampling-Third-Technology/dp/0240521056" },
  { name: "So You Want To Do VO?: Working from home as a voiceover actor Paperback by Rob Marley", url: "https://www.amazon.com/So-You-Want-Do-voiceover/dp/1973507773" },
  { name: "Voice-Over Voice Actor: The Extended Edition by Yuri Lowenthal and Tara Platt", url: "https://www.amazon.com/Voice-Over-Voice-Actor-Extended/dp/B07DPQTN89/ref=sr_1_4" },
  { name: "On The Mic: Voice Training for Voiceover Artists, Podcasters, Speakers & Presenters by Nic Redman", url: "https://www.amazon.com/Mic-Training-Voiceover-Podcasters-Presenters/dp/B0BW2KMG8B/ref=sr_1_6" },
  { name: "Voiceover Narration: Creating Performances from the Inside Out by Dian Perry", url: "https://www.amazon.com/Voiceover-Narration-Creating-Performances-Inside/dp/B099LQFQD7/" },
  { name: "The Voice Over Actor's Handbook: How to Analyze, Interpret, and Deliver Scripts by John Burr", url: "https://www.amazon.com/Voice-Over-Actors-Handbook-Interpret/dp/B0BCQDMYYM/" }
];

const tools = [
  "Game Engines",
  "Reaper",
  "Cubase",
  "Logic Pro X",
  "Source-Connect",
  "Cleanfeed",
  "iZotope RX",
  "Audio-Repair",
  "Waves Vocal Rider",
  "Melodyne",
  "Waves DeEsser",
  "Sibilance Control",
  "Soundtoys Decapitator",
  "UAD Helios",
  "Audient iD14",
  "RME Babyface Pro",
  "Krisp",
  "Cleanfeed Noise Removal"
];

const sidebarRoles = [
  { name: "Audio Programmer", slug: "audio-programmer", current: false },
  { name: "Audio Producer", slug: "audio-producer", current: false },
  { name: "Composer", slug: "composer", current: false },
  { name: "Foley Artist", slug: "foley-artist", current: false },
  { name: "Sound Designer", slug: "sound-designer", current: false },
  { name: "Voiceover Artist", slug: "voiceover-artist", current: true }
];
---

<BaseLayout title="Voiceover Artist" activeNav="career-guide">
  <WikiLayout title="Voiceover Artist" activeNav="career-guide" activeSidebar="roles">
    <div class="career-layout">
      <aside class="career-sidebar">
        <h3>Audio & Music Roles</h3>
        {sidebarRoles.map((r) => (
          r.current ? (
            <div class="card" style="padding: 0.75rem; margin-bottom: 0.5rem; border-left: 3px solid var(--color-pink);">
              <strong style="font-size: 0.9rem; color: var(--color-pink);">{r.name}</strong>
            </div>
          ) : (
            <a href={`${base}career-guide/roles/audio/${r.slug}/`} class="card" style="padding: 0.75rem; margin-bottom: 0.5rem; text-decoration: none; display: block;">
              <strong style="font-size: 0.9rem;">{r.name}</strong>
            </a>
          )
        ))}
        <div style="margin-top: 1rem;">
          <a href={`${base}career-guide/roles/audio/`} class="btn btn-gold" style="font-size: 0.8rem; padding: 0.4rem 0.8rem;">&larr; Audio & Music</a>
        </div>
      </aside>

      <div class="career-main">
        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>About this Role</h2>
          <p>A game voiceover artist is a chameleon of spoken word, inhabiting digital avatars and breathing life into interactive narratives. Utilizing nuanced vocal control and emotional intelligence, they deliver dialogue, narration, and in-game prompts with precision and dynamism. Their artistry lies in inhabiting diverse characters, from gruff warriors to witty AI companions, while adhering to tight performance specifications and technical limitations. Their ability to capture subtle tonal shifts, react to dynamic cues, and deliver consistent performances across vast quantities of recorded lines is fundamental to immersing players in the game's emotional core. In essence, the game voiceover artist is the unseen storyteller, painting emotional landscapes with their voice and etching themselves into the very fabric of the interactive experience.</p>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Salary Resources</h2>
          <div style="display: flex; flex-wrap: wrap; gap: 0.75rem;">
            {salaries.map((s) => (
              <a href={s.url} target="_blank" rel="noopener noreferrer" class="btn btn-blue" style="font-size: 0.85rem;">
                {s.name} &rarr;
              </a>
            ))}
          </div>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Key Responsibilities</h2>
          <ul>
            {responsibilities.map((r) => (
              <li>{r}</li>
            ))}
          </ul>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Learning Resources</h2>
          <ul>
            {resources.map((r) => (
              <li><a href={r.url} target="_blank" rel="noopener noreferrer">{r.name}</a></li>
            ))}
          </ul>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Recommended Books</h2>
          <ul>
            {books.map((b) => (
              <li><a href={b.url} target="_blank" rel="noopener noreferrer">{b.name}</a></li>
            ))}
          </ul>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Tools to Learn</h2>
          <div class="callout callout-info">
            <p>You don&#39;t need to learn all of these — they are some of the more common tools for this role.</p>
          </div>
          <div style="display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.75rem;">
            {tools.map((t) => (
              <span style="background: var(--color-bg); border: 1px solid var(--color-dark); border-radius: 4px; padding: 0.3rem 0.6rem; font-size: 0.85rem;">{t}</span>
            ))}
          </div>
        </div>
      </div>

      <aside class="career-sidebar">
        <h3>Quick Links</h3>
        <div class="card" style="padding: 1rem; margin-bottom: 0.75rem;">
          <strong>📋 Job Boards</strong>
          <p style="font-size: 0.85rem; margin-top: 0.35rem;">
            <a href={`${base}career-guide/job-boards/`}>Browse job boards &rarr;</a>
          </p>
        </div>
        <div class="card" style="padding: 1rem; margin-bottom: 0.75rem;">
          <strong>📚 Resources</strong>
          <p style="font-size: 0.85rem; margin-top: 0.35rem;">
            <a href={`${base}career-guide/resources/`}>Career resources &rarr;</a>
          </p>
        </div>
        <div class="card" style="padding: 1rem;">
          <strong>🎯 All Roles</strong>
          <p style="font-size: 0.85rem; margin-top: 0.35rem;">
            <a href={`${base}career-guide/roles/`}>View all disciplines &rarr;</a>
          </p>
        </div>
      </aside>
    </div>
  </WikiLayout>
</BaseLayout>