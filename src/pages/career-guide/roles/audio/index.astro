---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import WikiLayout from "../../../../layouts/WikiLayout.astro";
const base = import.meta.env.BASE_URL;

const roles = [
  { name: "Audio Programmer", slug: "audio-programmer", description: "Audio programmers are the tech wizards behind the scenes of your favorite video games, movies, and even virtual reality experiences." },
  { name: "Audio Producer", slug: "audio-producer", description: "Audio Producer is a specialized role in the game industry." },
  { name: "Composer", slug: "composer", description: "A composer is the weaver of emotions in sound." },
  { name: "Foley Artist", slug: "foley-artist", description: "Foley artists are magicians of sound." },
  { name: "Sound Designer", slug: "sound-designer", description: "A game sound designer sculpts the sonic architecture of interactive worlds." },
  { name: "Voiceover Artist", slug: "voiceover-artist", description: "A game voiceover artist is a chameleon of spoken word, inhabiting digital avatars and breathing life into interactive narratives." }
];

const skills = [
  "Audio Editing",
  "Audio Editing Tools",
  "Audio Engineering",
  "Audio Implementation",
  "Audio Localization",
  "Audio Mixing",
  "Audio Processing",
  "Audio Producing",
  "Audio Programming",
  "Audio Recording",
  "Creativity",
  "Foley Artistry",
  "Music Theory",
  "Problem-Solving",
  "Scripting",
  "Sound Design",
  "Sound Effects",
  "Speech Perception"
];

const courses = [
  { name: "Game Audio Learning - Community Resources", url: "https://www.gameaudiolearning.com/resources" },
  { name: "Game Audio Resource -Implementation Guides & SFX Libraries", url: "https://gameaudioresource.com/" },
  { name: "jsfxr - Free 8-bit sound maker and sfx generator", url: "https://sfxr.me/" },
  { name: "Beepbox - Free online tool for sketching and sharing instrumental music", url: "https://www.beepbox.co/#9n31s0k0l00e03t2ma7g0fj07r1i0o432T1v1uc0f10l7q011d23A4F3B5Q0506Pd474E361963279T6v1u74f10q8q00d03W4E122T7v1u21f30j61552n8q011d07H_SJ5JJFAAAkAAAh8IcE0T2v1u15f10w4qw02d03w0E0b4h400000000h4g000000014h000000004h400000000p16000000" },
  { name: "ChipTone - Free tool for generating sfx", url: "https://sfbgames.itch.io/chiptone" }
];
---

<BaseLayout title="Audio & Music Roles" activeNav="career-guide">
  <WikiLayout title="Audio & Music Roles" activeNav="career-guide" activeSidebar="roles">
    <p>Audio and music professionals are the creative minds behind the immersive soundscapes of video games, crafting captivating soundtracks and realistic audio effects that elevate the gaming experience. Their artistry transforms the auditory landscape of virtual worlds, immersing players in the game's narrative, evoking emotions, and amplifying the thrills of gameplay. From the captivating melodies that underscore the story to the adrenaline-pumping sound effects that heighten action sequences, their work is an integral component of the video game experience.</p>

    <div class="career-layout">
      <aside class="career-sidebar">
        <h3>Audio & Music Roles</h3>
        {roles.map((r) => (
          <a href={`${base}career-guide/roles/audio/${r.slug}/`} class="card" style="padding: 0.75rem; margin-bottom: 0.5rem; text-decoration: none; display: block;">
            <strong style="font-size: 0.9rem;">{r.name}</strong>
          </a>
        ))}
        <div style="margin-top: 1rem;">
          <a href={`${base}career-guide/roles/`} class="btn btn-gold" style="font-size: 0.8rem; padding: 0.4rem 0.8rem;">&larr; All Roles</a>
        </div>
      </aside>

      <div class="career-main">
        <div class="card-grid" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
          {roles.map((role) => (
            <a href={`${base}career-guide/roles/audio/${role.slug}/`} class="card" style="text-decoration:none;">
              <h3>{role.name}</h3>
              <p>{role.description}</p>
              <span class="btn btn-pink" style="font-size: 0.8rem; padding: 0.3rem 0.6rem; margin-top: 0.5rem; display: inline-block;">View Role &rarr;</span>
            </a>
          ))}
        </div>

        <div class="card" style="margin-top: 1.5rem;">
          <h3>Skills Involved</h3>
          <div style="display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.75rem;">
            {skills.map((s) => (
              <span style="background: var(--clr-bg); border: 1px solid var(--clr-dark); border-radius: 4px; padding: 0.3rem 0.6rem; font-size: 0.85rem;">{s}</span>
            ))}
          </div>
        </div>

        <div class="card" style="margin-top: 1.5rem;">
          <h3>Courses &amp; Resources</h3>
          <ul>
            {courses.map((c) => (
              <li><a href={c.url} target="_blank" rel="noopener noreferrer">{c.name}</a></li>
            ))}
          </ul>
        </div>
      </div>

      <aside class="career-sidebar">
        <h3>Related</h3>
        <div class="card" style="padding: 1rem; margin-bottom: 0.75rem;">
          <p style="font-size: 0.85rem;">
            <a href={`${base}career-guide/roles/art/`}>🎨 Art Roles &rarr;</a>
          </p>
        </div>
        <div class="card" style="padding: 1rem; margin-bottom: 0.75rem;">
          <p style="font-size: 0.85rem;">
            <a href={`${base}career-guide/roles/business/`}>💼 Business Roles &rarr;</a>
          </p>
        </div>
        <div class="card" style="padding: 1rem;">
          <p style="font-size: 0.85rem;">
            <a href={`${base}career-guide/job-boards/`}>Job Boards &rarr;</a>
          </p>
        </div>
      </aside>
    </div>
  </WikiLayout>
</BaseLayout>