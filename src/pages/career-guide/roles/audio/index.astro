---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import WikiLayout from "../../../../layouts/WikiLayout.astro";
const base = import.meta.env.BASE_URL;

const roles = [
  { name: "Sound Designer", description: "Creates and implements sound effects that bring game actions and environments to life." },
  { name: "Composer", description: "Writes original music — from ambient soundscapes to epic orchestral scores — that sets the game's emotional tone." },
  { name: "Audio Programmer", description: "Implements audio systems, middleware integration (Wwise, FMOD), and interactive sound behaviors." },
  { name: "Voice Director", description: "Directs voice actors during recording sessions and manages dialogue pipelines." },
];
---

<BaseLayout title="Audio Roles" activeNav="career-guide">
  <WikiLayout title="Audio Roles" activeNav="career-guide" activeSidebar="roles">
    <p>
      Audio roles shape the sonic landscape of games. From foley and SFX to
      dynamic music systems, audio professionals create the sounds that
      immerse players.
    </p>

    <div class="career-layout">
      <aside class="career-sidebar">
        <h3>Audio Roles</h3>
        {roles.map((r) => (
          <div class="card" style="padding: 0.75rem; margin-bottom: 0.5rem;">
            <strong style="font-size: 0.9rem;">{r.name}</strong>
          </div>
        ))}
        <div style="margin-top: 1rem;">
          <a href={`${base}career-guide/roles/`} class="btn btn-gold" style="font-size: 0.8rem; padding: 0.4rem 0.8rem;">← All Roles</a>
        </div>
      </aside>

      <div class="career-main">
        {roles.map((role) => (
          <div class="card" style="margin-bottom: 1rem;">
            <h3>{role.name}</h3>
            <p>{role.description}</p>
          </div>
        ))}
      </div>

      <aside class="career-sidebar">
        <h3>Related</h3>
        <div class="card" style="padding: 1rem; margin-bottom: 0.75rem;">
          <p style="font-size: 0.85rem;">
            <a href={`${base}equipment/audio-tools/`}>Audio Tools →</a>
          </p>
        </div>
        <div class="card" style="padding: 1rem;">
          <p style="font-size: 0.85rem;">
            <a href={`${base}career-guide/job-boards/`}>Job Boards →</a>
          </p>
        </div>
      </aside>
    </div>
  </WikiLayout>
</BaseLayout>
