---
import BaseLayout from "../../../../../layouts/BaseLayout.astro";
import WikiLayout from "../../../../../layouts/WikiLayout.astro";
const base = import.meta.env.BASE_URL;

const salaries = [
  { name: "InGameJob", url: "https://ingamejob.com/en/salaries" },
  { name: "Glassdoor", url: "https://www.glassdoor.com/Salary/Audio-Programmer-Salaries-E5245909.htm" },
  { name: "Salary.com", url: "https://www.salary.com/research/salary/position/audio-programmer-salary" },
  { name: "ZipRecruiter", url: "https://www.ziprecruiter.com/Salaries/Audio-Programmer-Salary#Yearly" }
];

const responsibilities = [
  "Build and integrate audio middleware with the game engine, ensuring seamless playback, triggering, and manipulation of sound effects, music, and dialogue.",
  "Analyze and address memory usage, resource allocation, and processing demands of audio assets to maintain smooth performance without compromising sound quality.",
  "Create scripts, shaders, and tools to automate tasks, extend engine functionality, and solve specific audio challenges within the game.",
  "Implement systems for dynamic soundscapes, reactive music, and procedural audio effects that respond to player actions and environmental changes.",
  "Synchronize sound effects and music with animations, events, and gameplay actions to create immersive and responsive audio experiences.",
  "Identify and resolve audio glitches, clipping, performance bottlenecks, and inconsistencies across various platforms and hardware configurations.",
  "Collaborate closely with sound designers and composers to understand artistic vision, translate design documents into technical solutions, and optimize audio workflows.",
  "Proficiently utilize audio programming languages as well as audio middleware tools and game engine audio APIs."
];

const resources = [
  { name: "FMOD Scripting Examples | Programmer Sounds", url: "https://www.fmod.com/docs/2.02/unity/examples-programmer-sounds.html" },
  { name: "Game Audio Implementation Resources", url: "https://gameaudioimplementation.com/" },
  { name: "Introduction to Digital Filters with Audio Applications by Julius O. Smith III", url: "https://ccrma.stanford.edu/~jos/filters/" },
  { name: "Getting Started with Audio Programming", url: "https://audiodev.blog/newbie-resources/" },
  { name: "Audio Programming Resources by PelleJuul", url: "https://github.com/PelleJuul/audio-programming-resources" },
  { name: "The Audio Programmer Wiki", url: "https://wiki.theaudioprogrammer.com/" },
  { name: "How I Got Started With Audio Programming | WolfTalk #001 by Jan Wilczek", url: "https://thewolfsound.com/talk001/" },
  { name: "ScreenSkills’ Audio Programmer Profile", url: "https://www.screenskills.com/job-profiles/browse/games/audio/audio-programmer/" },
  { name: "Audio Programming Languages By Matt Temperley", url: "https://thevelvetshadow.com/how-to-program-audio-plugins-languages" }
];

const books = [
  { name: "The Audio Programming Book", url: "https://www.amazon.com/Audio-Programming-Book-MIT-Press/dp/0262014467" },
  { name: "Game Programming Patterns by Robert Nystrom", url: "https://www.amazon.com/Game-Programming-Patterns-Robert-Nystrom/dp/0990582906" },
  { name: "Game Audio Programming 1 by Guy Somberg", url: "https://www.amazon.com/Game-Audio-Programming-Principles-Practices/dp/149874673X" },
  { name: "Game Audio Programming 2 by Guy Somberg", url: "https://www.amazon.com/Game-Audio-Programming-Principles-Practices-ebook/dp/B07H36LRB9/ref=sr_1_8" },
  { name: "Game Audio Programming 3 by Guy Somberg", url: "https://www.amazon.com/Game-Audio-Programming-Principles-Practices/dp/0367348047" },
  { name: "Game Audio Programming 4 by Guy Somberg", url: "https://www.amazon.com/Game-Audio-Programming-Principles-Practices/dp/1032361077" },
  { name: "The Game Audio Tutorial: A Practical Guide to Sound and Music for Interactive Games by Richard Stevens", url: "https://www.amazon.com/Game-Audio-Tutorial-Practical-Interactive/dp/0240817265/ref=sr_1_1" },
  { name: "Principles of Game Audio and Sound Design by Jean-Luc Sinclair", url: "https://www.amazon.com/Principles-Game-Audio-Sound-Design/dp/1138738972/ref=sr_1_24" },
  { name: "The Game Audio Strategy Guide: A Practical Course by Gina Zdanowicz and Spencer Bambrick", url: "https://www.amazon.com/Game-Audio-Strategy-Guide-Practical/dp/1138498343/ref=sr_1_1" },
  { name: "Game Audio Implementation by Richard Stevens and Dave Raybould", url: "https://www.amazon.com/Game-Audio-Implementation-Practical-Unreal/dp/1138777242/ref=sr_1_2" },
  { name: "Complete Guide to Game Audio by Aaron Marks", url: "https://www.amazon.com/Aaron-Marks-Complete-Guide-Audio/dp/1138795380/ref=sr_1_4" },
  { name: "The Essential Guide to Game Audio by Steve Horowitz and Scott Looney", url: "https://www.amazon.com/Essential-Guide-Game-Audio-Practice/dp/041570670X/ref=sr_1_13" },
  { name: "Audio Programming for Interactive Games by Martin D. Wilde", url: "https://www.amazon.com/Audio-Programming-Interactive-Games-Computer/dp/0240519418/ref=sr_1_15" },
  { name: "Beep to Boom: The Development of Advanced Runtime Sound Systems for Games and Extended Reality by Simon Goodwin", url: "https://www.amazon.com/Beep-Audio-Engineering-Society-Presents/dp/113854390X/ref=sr_1_19" },
  { name: "The Computer Music Tutorial by Curtis Roads", url: "https://www.amazon.com/Computer-Music-Tutorial-MIT-Press/dp/0262680823" },
  { name: "Sound Synthesis and Sampling by Martin Russ", url: "https://www.amazon.com/Sound-Synthesis-Sampling-Third-Technology/dp/0240521056" }
];

const tools = [
  "Game Engines",
  "C++",
  "C#",
  "Lua",
  "Wwise",
  "FMOD Studio",
  "Dolby Atmos Authoring Tool",
  "Reaper",
  "Pro Tools",
  "Sound Forge",
  "iZotope RX",
  "FabFilter Pro-Q 3",
  "Kontakt",
  "Soundtoys Decapitator",
  "Valhalla Room",
  "Spline",
  "SuperCollider",
  "Pure Data",
  "Sqript",
  "JUCE"
];

const sidebarRoles = [
  { name: "Audio Programmer", slug: "audio-programmer", current: true },
  { name: "Audio Producer", slug: "audio-producer", current: false },
  { name: "Composer", slug: "composer", current: false },
  { name: "Foley Artist", slug: "foley-artist", current: false },
  { name: "Sound Designer", slug: "sound-designer", current: false },
  { name: "Voiceover Artist", slug: "voiceover-artist", current: false }
];
---

<BaseLayout title="Audio Programmer" activeNav="career-guide">
  <WikiLayout title="Audio Programmer" activeNav="career-guide" activeSidebar="roles">
    <div class="career-layout">
      <aside class="career-sidebar">
        <h3>Audio & Music Roles</h3>
        {sidebarRoles.map((r) => (
          r.current ? (
            <div class="card" style="padding: 0.75rem; margin-bottom: 0.5rem; border-left: 3px solid var(--color-pink);">
              <strong style="font-size: 0.9rem; color: var(--color-pink);">{r.name}</strong>
            </div>
          ) : (
            <a href={`${base}career-guide/roles/audio/${r.slug}/`} class="card" style="padding: 0.75rem; margin-bottom: 0.5rem; text-decoration: none; display: block;">
              <strong style="font-size: 0.9rem;">{r.name}</strong>
            </a>
          )
        ))}
        <div style="margin-top: 1rem;">
          <a href={`${base}career-guide/roles/audio/`} class="btn btn-gold" style="font-size: 0.8rem; padding: 0.4rem 0.8rem;">&larr; Audio & Music</a>
        </div>
      </aside>

      <div class="career-main">
        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>About this Role</h2>
          <p>Audio programmers are the tech wizards behind the scenes of your favorite video games, movies, and even virtual reality experiences. They're the ones who take all the sound effects, music, and dialogue and make sure they play at the right time, in the right place, and sound amazing. They use their coding skills to integrate audio into game engines, ensuring smooth playback, high quality, and minimal processing power usage. Think of them as the invisible conductors of the immersive audio orchestra that brings these interactive worlds to life. In short, audio programmers are the bridge between the creative world of sound design and the technical world of software development. They're the ones who make sure that all the sonic elements come together seamlessly to create a truly unforgettable audio experience.</p>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Salary Resources</h2>
          <div style="display: flex; flex-wrap: wrap; gap: 0.75rem;">
            {salaries.map((s) => (
              <a href={s.url} target="_blank" rel="noopener noreferrer" class="btn btn-blue" style="font-size: 0.85rem;">
                {s.name} &rarr;
              </a>
            ))}
          </div>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Key Responsibilities</h2>
          <ul>
            {responsibilities.map((r) => (
              <li>{r}</li>
            ))}
          </ul>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Learning Resources</h2>
          <ul>
            {resources.map((r) => (
              <li><a href={r.url} target="_blank" rel="noopener noreferrer">{r.name}</a></li>
            ))}
          </ul>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Recommended Books</h2>
          <ul>
            {books.map((b) => (
              <li><a href={b.url} target="_blank" rel="noopener noreferrer">{b.name}</a></li>
            ))}
          </ul>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Tools to Learn</h2>
          <div class="callout callout-info">
            <p>You don&#39;t need to learn all of these — they are some of the more common tools for this role.</p>
          </div>
          <div style="display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.75rem;">
            {tools.map((t) => (
              <span style="background: var(--color-bg); border: 1px solid var(--color-dark); border-radius: 4px; padding: 0.3rem 0.6rem; font-size: 0.85rem;">{t}</span>
            ))}
          </div>
        </div>
      </div>

      <aside class="career-sidebar">
        <h3>Quick Links</h3>
        <div class="card" style="padding: 1rem; margin-bottom: 0.75rem;">
          <strong>📋 Job Boards</strong>
          <p style="font-size: 0.85rem; margin-top: 0.35rem;">
            <a href={`${base}career-guide/job-boards/`}>Browse job boards &rarr;</a>
          </p>
        </div>
        <div class="card" style="padding: 1rem; margin-bottom: 0.75rem;">
          <strong>📚 Resources</strong>
          <p style="font-size: 0.85rem; margin-top: 0.35rem;">
            <a href={`${base}career-guide/resources/`}>Career resources &rarr;</a>
          </p>
        </div>
        <div class="card" style="padding: 1rem;">
          <strong>🎯 All Roles</strong>
          <p style="font-size: 0.85rem; margin-top: 0.35rem;">
            <a href={`${base}career-guide/roles/`}>View all disciplines &rarr;</a>
          </p>
        </div>
      </aside>
    </div>
  </WikiLayout>
</BaseLayout>