---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import WikiLayout from "../../../layouts/WikiLayout.astro";
const base = import.meta.env.BASE_URL;

const roleDisciplines = [
  {
    name: "Animation",
    icon: "🎬",
    href: `${base}career-guide/roles/animation/`,
    description: "Bring characters and worlds to life through motion.",
    roles: ["Character Animator", "Cinematic Animator", "Motion Capture Artist", "Technical Animator", "UX/UI Animator", "VFX Animator", "Rigging Artist"],
  },
  {
    name: "Art",
    icon: "🎨",
    href: `${base}career-guide/roles/art/`,
    description: "Create the visual identity of games — from concept to final asset.",
    roles: ["3D Modeling Artist", "Concept Artist", "Character Artist", "Environment Artist", "Lighting Artist", "Storyboard Artist", "Texture Artist", "Technical Artist", "VFX Artist", "UX/UI Artist"],
  },
  {
    name: "Audio & Music",
    icon: "🎵",
    href: `${base}career-guide/roles/audio/`,
    description: "Design the sonic landscape that immerses players.",
    roles: ["Audio Programmer", "Audio Producer", "Composer", "Foley Artist", "Sound Designer", "Voiceover Artist"],
  },
  {
    name: "Business",
    icon: "💼",
    href: `${base}career-guide/roles/business/`,
    description: "Handle strategic, operational, and financial aspects of game development.",
    roles: ["Product Manager", "Business Development Executive", "User Acquisition Specialist", "Specialist Lawyer", "Human Resources Specialist", "Financial Specialist", "Office/Studio Manager"],
  },
  {
    name: "Game Design",
    icon: "🧩",
    href: `${base}career-guide/roles/design/`,
    description: "Shape the rules, systems, and experiences players interact with.",
    roles: ["Game Designer", "Level Designer", "Narrative Designer/Writer", "Gameplay Designer", "System Designer", "UX/UI Designer", "Technical Designer"],
  },
  {
    name: "Engineering & Programming",
    icon: "💻",
    href: `${base}career-guide/roles/programming/`,
    description: "Build the systems and technology that make games run.",
    roles: ["AI Programmer", "Gameplay Programmer", "Generalist Programmer", "VR Programmer", "Tools Programmer", "Network Engineer", "Engine Programmer", "Graphics Programmer", "Audio Programmer", "UX/UI Programmer", "Physics Programmer"],
  },
  {
    name: "Infrastructure & Live Ops",
    icon: "🖧",
    href: `${base}career-guide/roles/infrastructure/`,
    description: "Manage live games, data, and backend infrastructure post-launch.",
    roles: ["LiveOps Engineer", "Data Analyst", "Customer Support Specialist", "Data Scientist"],
  },
  {
    name: "Marketing",
    icon: "📣",
    href: `${base}career-guide/roles/marketing/`,
    description: "Promote games, build communities, and drive player engagement.",
    roles: ["Social Media Specialist", "Community Manager", "Influencer Marketer", "Content Marketer", "Campaign Specialist", "PR Specialist", "Performance Marketer"],
  },
  {
    name: "Production",
    icon: "📊",
    href: `${base}career-guide/roles/production/`,
    description: "Keep teams on track and projects moving forward.",
    roles: ["Game Producer", "Executive Producer", "Publisher", "Project Manager", "Operations Manager"],
  },
  {
    name: "Quality Assurance",
    icon: "🔍",
    href: `${base}career-guide/roles/qa/`,
    description: "Ensure quality and catch issues before players do.",
    roles: ["Playtester", "QA Analyst", "QA Engineer", "Localization Tester"],
  },
];
---

<BaseLayout title="Roles" activeNav="career-guide">
  <WikiLayout title="Gamedev Career Roles" activeNav="career-guide" activeSidebar="roles">
    <p>
      The game industry spans many disciplines. Explore each category below
      to learn about specific roles, what they do, and how to break in.
    </p>

    <!-- 3-column layout: sidebar | main | sidebar -->
    <div class="career-layout">
      <aside class="career-sidebar">
        <h3>Disciplines</h3>
        {roleDisciplines.map((d) => (
          <a href={d.href} class="card" style="text-decoration:none; display:block;">
            <span style="font-size:1.25rem;">{d.icon}</span>
            <strong>{d.name}</strong>
          </a>
        ))}
      </aside>

      <div class="career-main">
        <div class="card-grid" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
          {roleDisciplines.map((discipline) => (
            <a href={discipline.href} class="card" style="text-decoration:none;">
              <div class="card-icon">{discipline.icon}</div>
              <h3>{discipline.name}</h3>
              <p>{discipline.description}</p>
              <ul style="margin-top: 0.5rem; font-size: 0.85rem;">
                {discipline.roles.map((role) => (
                  <li>{role}</li>
                ))}
              </ul>
            </a>
          ))}
        </div>
      </div>

      <aside class="career-sidebar">
        <h3>Quick Links</h3>
        <div class="card" style="padding: 1rem; margin-bottom: 0.75rem;">
          <strong>🎯 Not sure where to start?</strong>
          <p style="font-size: 0.85rem; margin-top: 0.35rem;">
            Check out the <a href={`${base}career-guide/resources/`}>Resource List</a> for career guides and self-assessments.
          </p>
        </div>
        <div class="card" style="padding: 1rem;">
          <strong>💼 Ready to apply?</strong>
          <p style="font-size: 0.85rem; margin-top: 0.35rem;">
            Browse our <a href={`${base}career-guide/job-boards/`}>Job Boards</a> directory.
          </p>
        </div>
      </aside>
    </div>
  </WikiLayout>
</BaseLayout>
