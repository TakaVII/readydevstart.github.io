---
import BaseLayout from "../../../../../layouts/BaseLayout.astro";
import WikiLayout from "../../../../../layouts/WikiLayout.astro";
const base = import.meta.env.BASE_URL;

const salaries = [
  { name: "InGameJob", url: "https://ingamejob.com/en/salaries" },
  { name: "Glassdoor", url: "https://www.glassdoor.com/Salaries/playtester-salary-SRCH_KO0,10.htm" },
  { name: "Salary.com", url: "https://www.salary.com/research/salary/hiring/game-tester-salary" },
  { name: "ZipRecruiter", url: "https://www.ziprecruiter.com/Salaries/Game-Tester-Salary#Yearly" }
];

const responsibilities = [
  "Explore the game extensively, meticulously identifying and documenting bugs, glitches, and technical issues.",
  "Provide detailed and constructive feedback on gameplay mechanics, balance, user interface, and overall game experience.",
  "Simulate different player types and playstyles, uncovering potential issues and ensuring accessibility for diverse audiences.",
  "Thoroughly test and evaluate all aspects of game content, from story missions to side quests and minigames.",
  "Uncover narrative inconsistencies, illogical story beats, and potential plot holes.",
  "Test text localization, identify translation errors, and ensure cultural appropriateness for global audiences.",
  "Analyze game difficulty across various levels and skill sets, providing feedback for balanced and engaging gameplay.",
  "Test game performance on different platforms and configurations, identifying performance bottlenecks and optimization opportunities.",
  "Test game features for accessibility, ensuring usability for players with disabilities."
];

const resources = [
  { name: "Into Games’ Junior QA Tester Database", url: "https://entrylevel.games/database/qa-tester" },
  { name: "Writing A Playtest Report: Tips and Tricks for Creating a Strong Post-Playtest Report", url: "https://blog.playtestcloud.com/writing-a-playtest-report/" },
  { name: "Best Practices: Five Tips for Better Playtesting", url: "https://www.gamedeveloper.com/design/best-practices-five-tips-for-better-playtesting" },
  { name: "Choose the Right Playtest Method", url: "https://gamesuserresearch.com/choose-the-right-playtest-method/" },
  { name: "VR Playtest Best Practices Featuring Schell Games", url: "https://schellgames.com/blog/vr-playtest-best-practices-featuring-schell-games" },
  { name: "The 3 stages of playtesting — Internal, Local, and Blind", url: "https://www.backerkit.com/blog/tabletop-games-crowdfunding-roadmap/playtest/the-3-stages-of-playtesting-internal-local-and-blind/" },
  { name: "How to Be a Better Playtester", url: "https://stonemaiergames.com/how-to-be-a-better-playtester/" }
];

const books = [
  { name: "Modern Game Testing: Learn how to test games like a pro, optimize testing effort, and skyrocket your QA career by Nikolina Finska", url: "https://www.amazon.com/dp/1803244402/" },
  { name: "Games, Design and Play: A detailed approach to iterative game design by Colleen Macklin and John Sharp", url: "https://www.amazon.com/Games-Design-Play-detailed-iterative/dp/0134392078/" },
  { name: "Players Making Decisions: Game Design Essentials and the Art of Understanding Your Players by Zack Hiwiller", url: "https://www.amazon.com/Players-Making-Decisions-Essentials-Understanding/dp/0134396758/" },
  { name: "Mobile Playtesting Playbook: Make Better Games by Testing Early and Often by Gareth Lloyd", url: "https://www.amazon.com/Mobile-Playtesting-Playbook-Better-Testing/dp/B09TZBPVW7/" },
  { name: "Game Testing: All in One by Charles P. Schultz and Robert Denton Bryant", url: "https://www.amazon.com/Game-Testing-Charles-P-Schultz/dp/1942270763/" },
  { name: "Modern Game Testing: A Pragmatic Guide to Test Planning and Strategy by Chris Howell", url: "https://www.amazon.com/Modern-Game-Testing-Pragmatic-Planning/dp/1739711505/" },
  { name: "Land a Job as a Video Game Tester by Jason W. Bay", url: "https://www.amazon.com/Land-Job-Video-Game-Tester/dp/0692536779/" },
  { name: "The Complete Software Tester: Concepts, Skills, and Strategies for High-Quality Testing by Kristin Jackvony", url: "https://www.amazon.com/Complete-Software-Tester-Strategies-High-Quality-ebook/dp/B09NGVVCJ9/" }
];

const tools = [
  "Game Engines",
  "Discord",
  "OBS Studio",
  "ShareX",
  "Jira",
  "Bugzilla",
  "TeamViewer",
  "AnyDesk",
  "Trello",
  "Asana",
  "FRAPS",
  "NVIDIA GeForce Experience",
  "Wireshark",
  "Cheat Engine",
  "Process Explorer"
];

const sidebarRoles = [
  { name: "Playtester", slug: "playtester", current: true },
  { name: "QA Analyst", slug: "qa-analyst", current: false },
  { name: "QA Engineer", slug: "qa-engineer", current: false },
  { name: "Localization Tester", slug: "localization-tester", current: false }
];
---

<BaseLayout title="Playtester" activeNav="career-guide">
  <WikiLayout title="Playtester" activeNav="career-guide" activeSidebar="roles">
    <div class="career-layout">
      <aside class="career-sidebar">
        <h3>Quality Assurance Roles</h3>
        {sidebarRoles.map((r) => (
          r.current ? (
            <div class="card" style="padding: 0.75rem; margin-bottom: 0.5rem; border-left: 3px solid var(--clr-pink);">
              <strong style="font-size: 0.9rem; color: var(--clr-pink);">{r.name}</strong>
            </div>
          ) : (
            <a href={`${base}career-guide/roles/qa/${r.slug}/`} class="card" style="padding: 0.75rem; margin-bottom: 0.5rem; text-decoration: none; display: block;">
              <strong style="font-size: 0.9rem;">{r.name}</strong>
            </a>
          )
        ))}
        <div style="margin-top: 1rem;">
          <a href={`${base}career-guide/roles/qa/`} class="btn btn-gold" style="font-size: 0.8rem; padding: 0.4rem 0.8rem;">&larr; Quality Assurance</a>
        </div>
      </aside>

      <div class="career-main">
        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>About this Role</h2>
          <p>Playtesters are the first line of experience, the guinea pigs who dive headfirst into the digital world to sniff out bugs, glitches, and frustrations. They are the crucial critics, meticulously exploring every corner, pushing buttons, and breaking things, all in the name of a smoother, more enjoyable game. Their feedback is the lifeblood of development, guiding designers and programmers to refine mechanics, polish interfaces, and eliminate any roadblocks that could impede the player's journey.</p>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Salary Resources</h2>
          <div style="display: flex; flex-wrap: wrap; gap: 0.75rem;">
            {salaries.map((s) => (
              <a href={s.url} target="_blank" rel="noopener noreferrer" class="btn btn-blue" style="font-size: 0.85rem;">
                {s.name} &rarr;
              </a>
            ))}
          </div>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Key Responsibilities</h2>
          <ul>
            {responsibilities.map((r) => (
              <li>{r}</li>
            ))}
          </ul>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Learning Resources</h2>
          <ul>
            {resources.map((r) => (
              <li><a href={r.url} target="_blank" rel="noopener noreferrer">{r.name}</a></li>
            ))}
          </ul>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Recommended Books</h2>
          <ul>
            {books.map((b) => (
              <li><a href={b.url} target="_blank" rel="noopener noreferrer">{b.name}</a></li>
            ))}
          </ul>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Tools to Learn</h2>
          <div class="callout callout-info">
            <p>You don&#39;t need to learn all of these — they are some of the more common tools for this role.</p>
          </div>
          <div style="display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.75rem;">
            {tools.map((t) => (
              <span style="background: var(--clr-bg); border: 1px solid var(--clr-dark); border-radius: 4px; padding: 0.3rem 0.6rem; font-size: 0.85rem;">{t}</span>
            ))}
          </div>
        </div>
      </div>

      <aside class="career-sidebar">
        <h3>Quick Links</h3>
        <div class="card" style="padding: 1rem; margin-bottom: 0.75rem;">
          <strong>📋 Job Boards</strong>
          <p style="font-size: 0.85rem; margin-top: 0.35rem;">
            <a href={`${base}career-guide/job-boards/`}>Browse job boards &rarr;</a>
          </p>
        </div>
        <div class="card" style="padding: 1rem; margin-bottom: 0.75rem;">
          <strong>📚 Resources</strong>
          <p style="font-size: 0.85rem; margin-top: 0.35rem;">
            <a href={`${base}career-guide/resources/`}>Career resources &rarr;</a>
          </p>
        </div>
        <div class="card" style="padding: 1rem;">
          <strong>🎯 All Roles</strong>
          <p style="font-size: 0.85rem; margin-top: 0.35rem;">
            <a href={`${base}career-guide/roles/`}>View all disciplines &rarr;</a>
          </p>
        </div>
      </aside>
    </div>
  </WikiLayout>
</BaseLayout>