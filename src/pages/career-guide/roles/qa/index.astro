---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import WikiLayout from "../../../../layouts/WikiLayout.astro";
const base = import.meta.env.BASE_URL;

const roles = [
  { name: "Playtester", slug: "playtester", description: "Playtesters are the first line of experience, the guinea pigs who dive headfirst into the digital world to sniff out bugs, glitches, and frustrations." },
  { name: "QA Analyst", slug: "qa-analyst", description: "A QA Analyst in the game industry delves deeper than just bug-hunting." },
  { name: "QA Engineer", slug: "qa-engineer", description: "A QA Engineer is a sentinel against bugs and glitches." },
  { name: "Localization Tester", slug: "localization-tester", description: "Localization Testers serve as cultural guardians, ensuring that games transcend borders and resonate with players worldwide." }
];

const skills = [
  "Test Planning and Execution",
  "Bug Tracking and Reporting",
  "Test Automation",
  "Regression Testing",
  "Test Case Design",
  "Performance Testing",
  "Compatibility Testing",
  "User Acceptance Testing (UAT)",
  "Test Documentation",
  "Continuous Integration",
  "Defect Triage",
  "Test Environment Setup and Configuration",
  "Test Data Management",
  "Risk Assessment and Mitigation",
  "Test Strategy Development",
  "Adherence to Quality Standards",
  "Root Cause Analysis",
  "Communication and Collaboration",
  "Metrics and Reporting",
  "Agile Testing Methodologies"
];

const courses = [
  { name: "Tips and tricks for building a QA portfolio", url: "https://www.gamesindustry.biz/tips-and-tricks-for-building-a-qa-portfolio" },
  { name: "What You Need To Know About Video Game Quality Assurance", url: "https://www.youtube.com/watch?v=XjiZNe8LW-U&ab_channel=GeorgiaGameDevelopersAssociation" }
];
---

<BaseLayout title="Quality Assurance Roles" activeNav="career-guide">
  <WikiLayout title="Quality Assurance Roles" activeNav="career-guide" activeSidebar="roles">
    <p>QA professionals play a vital role in testing games for bugs, glitches, and other issues to ensure a smooth and polished gaming experience. They meticulously analyze and report on gameplay mechanics, user interfaces, audiovisual elements, and overall game performance. QA testers collaborate with game developers to identify and resolve issues, verify fixes, and provide valuable feedback for improvements. Their responsibilities also include conducting compatibility testing, multiplayer testing, and ensuring compliance with industry standards.</p>

    <div class="career-layout">
      <aside class="career-sidebar">
        <h3>Quality Assurance Roles</h3>
        {roles.map((r) => (
          <a href={`${base}career-guide/roles/qa/${r.slug}/`} class="card" style="padding: 0.75rem; margin-bottom: 0.5rem; text-decoration: none; display: block;">
            <strong style="font-size: 0.9rem;">{r.name}</strong>
          </a>
        ))}
        <div style="margin-top: 1rem;">
          <a href={`${base}career-guide/roles/`} class="btn btn-gold" style="font-size: 0.8rem; padding: 0.4rem 0.8rem;">&larr; All Roles</a>
        </div>
      </aside>

      <div class="career-main">
        <div class="card-grid" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
          {roles.map((role) => (
            <a href={`${base}career-guide/roles/qa/${role.slug}/`} class="card" style="text-decoration:none;">
              <h3>{role.name}</h3>
              <p>{role.description}</p>
              <span class="btn btn-pink" style="font-size: 0.8rem; padding: 0.3rem 0.6rem; margin-top: 0.5rem; display: inline-block;">View Role &rarr;</span>
            </a>
          ))}
        </div>

        <div class="card" style="margin-top: 1.5rem;">
          <h3>Skills Involved</h3>
          <div style="display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.75rem;">
            {skills.map((s) => (
              <span style="background: var(--clr-bg); border: 1px solid var(--clr-dark); border-radius: 4px; padding: 0.3rem 0.6rem; font-size: 0.85rem;">{s}</span>
            ))}
          </div>
        </div>

        <div class="card" style="margin-top: 1.5rem;">
          <h3>Courses &amp; Resources</h3>
          <ul>
            {courses.map((c) => (
              <li><a href={c.url} target="_blank" rel="noopener noreferrer">{c.name}</a></li>
            ))}
          </ul>
        </div>
      </div>

      <aside class="career-sidebar">
        <h3>Related</h3>
        <div class="card" style="padding: 1rem; margin-bottom: 0.75rem;">
          <p style="font-size: 0.85rem;">
            <a href={`${base}career-guide/roles/production/`}>📊 Production Roles &rarr;</a>
          </p>
        </div>
        <div class="card" style="padding: 1rem; margin-bottom: 0.75rem;">
          <p style="font-size: 0.85rem;">
            <a href={`${base}career-guide/roles/animation/`}>🎬 Animation Roles &rarr;</a>
          </p>
        </div>
        <div class="card" style="padding: 1rem;">
          <p style="font-size: 0.85rem;">
            <a href={`${base}career-guide/job-boards/`}>Job Boards &rarr;</a>
          </p>
        </div>
      </aside>
    </div>
  </WikiLayout>
</BaseLayout>