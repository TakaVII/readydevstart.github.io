---
import BaseLayout from "../../../../../layouts/BaseLayout.astro";
import WikiLayout from "../../../../../layouts/WikiLayout.astro";
const base = import.meta.env.BASE_URL;

const salaries = [
  { name: "InGameJob", url: "https://ingamejob.com/en/salaries" },
  { name: "Glassdoor", url: "https://www.glassdoor.com/Salaries/localization-tester-salary-SRCH_KO0,19.htm" },
  { name: "Salary.com", url: "https://www.salary.com/research/salary/recruiting/qa-localization-tester-salary" },
  { name: "ZipRecruiter", url: "https://www.ziprecruiter.com/Salaries/Localization-Tester-Salary#Yearly" }
];

const responsibilities = [
  "Scrutinize all in-game text, dialogue, menus, UI elements, and supporting documentation for flawless translation and grammar in the target language.",
  "Ensure content aligns with cultural norms and sensitivities, avoiding any potential offense or misunderstandings in the target market.",
  "Verify that UI elements, text formatting, and character rendering function correctly and maintain visual appeal across different languages and scripts.",
  "Review voiceovers, sound effects, and music to ensure they match the localized text, convey intended emotions, and align with cultural expectations.",
  "Verify compliance with regional regulations and content restrictions, adapting content sensitively when necessary.",
  "Identify and document any text errors, display glitches, formatting issues, or cultural inconsistencies in the localized version.",
  "Communicate effectively with translators and localization teams to clarify ambiguities, provide context, and ensure accurate interpretation.",
  "Offer insights on cultural nuances and suggest potential adaptations to enhance player experience and engagement in the target market.",
  "Verify compatibility with regional hardware, software, and network configurations to ensure smooth gameplay across different territories.",
  "Maintain awareness of evolving cultural references, slang, and gaming terminology to ensure localization stays relevant and engaging."
];

const resources = [
  { name: "Localization testing: a step-by-step guide and checklist", url: "https://es.smartcat.com/blog/localization-testing-a-step-by-step-guide-and-checklist/" },
  { name: "Complete Guide to Localization Testing: Best Practices and Step by Step", url: "https://www.weglot.com/blog/localization-testing" },
  { name: "Game Localization Testing Strategy: Tips and Best Practices", url: "https://blog.alconost.com/en/game-localization-testing-strategy" },
  { name: "LQA Guide: What Is Game Localization Testing And How To Do It Right", url: "https://www.localizedirect.com/posts/lqa-what-is-game-localization-testing" },
  { name: "Inside Game Localization Testing - Maria Lee From Terra | The Localization Podcast #56", url: "https://www.youtube.com/watch?v=HmXRl3AMeks&ab_channel=LocalizationAcademy" },
  { name: "Localization & Internationalization Testing", url: "https://medium.com/@case_lab/localization-internationalization-testing-9a441e448995" },
  { name: "Ultimate Guide to Localization Testing in 2024: Top 6 Benefits", url: "https://research.aimultiple.com/localization-testing/" },
  { name: "What is Localization Testing: Tools and Technologies", url: "https://www.appsierra.com/blog/localization-testing" }
];

const books = [
  { name: "The Little Book of Localization: A Guide to Bringing Your Products to International Markets by Sören Eberhardt", url: "https://www.amazon.com/Little-Book-Localization-Bringing-International-ebook/dp/B0BWSQMJ42/" },
  { name: "The Language of Localization by Katherine Brown-Hoekstra", url: "https://www.amazon.com/Language-Localization-Katherine-Brown-Hoekstra-ebook/dp/B07PQZPR1X/" },
  { name: "A Practical Guide to Localization by Bert Esselink", url: "https://www.amazon.com/Practical-Localization-Language-International-Directory/dp/9027219559/" },
  { name: "The Game Localization Handbook by Heather Maxwell Chandler and Stephanie O'Malley Deming", url: "https://www.amazon.com/Localization-Handbook-Heather-Maxwell-Chandler/dp/0763795933/" },
  { name: "Game Localization: Translating for the Global Digital Entertainment Industry by Minako O'Hagan and Carme Mangiron", url: "https://www.amazon.com/Game-Localization-Translating-entertainment-Translation/dp/9027224579/" },
  { name: "Legends of Localization, Book 1: The Legend of Zelda by Clyde (Author) Mandelin", url: "https://www.amazon.com/Legends-Localization-Book-Legend-Zelda/dp/0984503277/" }
];

const tools = [
  "Game Engines",
  "XTM Cloud",
  "Memsource",
  "Smartcat",
  "SDL Trados Studio",
  "Transifex",
  "Phrase",
  "Poedit",
  "Crowdin",
  "Localyzer",
  "JIRA",
  "TestRail",
  "BugZilla",
  "Git",
  "Microsoft Excel"
];

const sidebarRoles = [
  { name: "Playtester", slug: "playtester", current: false },
  { name: "QA Analyst", slug: "qa-analyst", current: false },
  { name: "QA Engineer", slug: "qa-engineer", current: false },
  { name: "Localization Tester", slug: "localization-tester", current: true }
];
---

<BaseLayout title="Localization Tester" activeNav="career-guide">
  <WikiLayout title="Localization Tester" activeNav="career-guide" activeSidebar="roles">
    <div class="career-layout">
      <aside class="career-sidebar">
        <h3>Quality Assurance Roles</h3>
        {sidebarRoles.map((r) => (
          r.current ? (
            <div class="card" style="padding: 0.75rem; margin-bottom: 0.5rem; border-left: 3px solid var(--color-pink);">
              <strong style="font-size: 0.9rem; color: var(--color-pink);">{r.name}</strong>
            </div>
          ) : (
            <a href={`${base}career-guide/roles/qa/${r.slug}/`} class="card" style="padding: 0.75rem; margin-bottom: 0.5rem; text-decoration: none; display: block;">
              <strong style="font-size: 0.9rem;">{r.name}</strong>
            </a>
          )
        ))}
        <div style="margin-top: 1rem;">
          <a href={`${base}career-guide/roles/qa/`} class="btn btn-gold" style="font-size: 0.8rem; padding: 0.4rem 0.8rem;">&larr; Quality Assurance</a>
        </div>
      </aside>

      <div class="career-main">
        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>About this Role</h2>
          <p>Localization Testers serve as cultural guardians, ensuring that games transcend borders and resonate with players worldwide. They are the meticulous explorers who venture into the heart of each localized version, ensuring that every word, image, and cultural reference aligns seamlessly with the target audience. Their mission is to bridge the gap between languages and cultures, ensuring that the game's essence shines through effortlessly, regardless of where it's played. They meticulously scrutinize every translated text, interface element, and cultural nuance, pinpointing inconsistencies, grammatical errors, and potential misunderstandings. From scrutinizing dialogue boxes to ensuring that character names and in-game references resonate locally, they safeguard the integrity of the game's cultural identity on a global scale.</p>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Salary Resources</h2>
          <div style="display: flex; flex-wrap: wrap; gap: 0.75rem;">
            {salaries.map((s) => (
              <a href={s.url} target="_blank" rel="noopener noreferrer" class="btn btn-blue" style="font-size: 0.85rem;">
                {s.name} &rarr;
              </a>
            ))}
          </div>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Key Responsibilities</h2>
          <ul>
            {responsibilities.map((r) => (
              <li>{r}</li>
            ))}
          </ul>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Learning Resources</h2>
          <ul>
            {resources.map((r) => (
              <li><a href={r.url} target="_blank" rel="noopener noreferrer">{r.name}</a></li>
            ))}
          </ul>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Recommended Books</h2>
          <ul>
            {books.map((b) => (
              <li><a href={b.url} target="_blank" rel="noopener noreferrer">{b.name}</a></li>
            ))}
          </ul>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Tools to Learn</h2>
          <div class="callout callout-info">
            <p>You don&#39;t need to learn all of these — they are some of the more common tools for this role.</p>
          </div>
          <div style="display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.75rem;">
            {tools.map((t) => (
              <span style="background: var(--color-bg); border: 1px solid var(--color-dark); border-radius: 4px; padding: 0.3rem 0.6rem; font-size: 0.85rem;">{t}</span>
            ))}
          </div>
        </div>
      </div>

      <aside class="career-sidebar">
        <h3>Quick Links</h3>
        <div class="card" style="padding: 1rem; margin-bottom: 0.75rem;">
          <strong>📋 Job Boards</strong>
          <p style="font-size: 0.85rem; margin-top: 0.35rem;">
            <a href={`${base}career-guide/job-boards/`}>Browse job boards &rarr;</a>
          </p>
        </div>
        <div class="card" style="padding: 1rem; margin-bottom: 0.75rem;">
          <strong>📚 Resources</strong>
          <p style="font-size: 0.85rem; margin-top: 0.35rem;">
            <a href={`${base}career-guide/resources/`}>Career resources &rarr;</a>
          </p>
        </div>
        <div class="card" style="padding: 1rem;">
          <strong>🎯 All Roles</strong>
          <p style="font-size: 0.85rem; margin-top: 0.35rem;">
            <a href={`${base}career-guide/roles/`}>View all disciplines &rarr;</a>
          </p>
        </div>
      </aside>
    </div>
  </WikiLayout>
</BaseLayout>