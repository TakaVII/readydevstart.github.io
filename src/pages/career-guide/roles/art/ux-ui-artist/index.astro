---
import BaseLayout from "../../../../../layouts/BaseLayout.astro";
import WikiLayout from "../../../../../layouts/WikiLayout.astro";
const base = import.meta.env.BASE_URL;

const salaries = [
  { name: "InGameJob", url: "https://ingamejob.com/en/salaries" },
  { name: "Glassdoor", url: "https://www.glassdoor.com/Salaries/ui-artist-salary-SRCH_KO0,9.htm" },
  { name: "Salary.com", url: "https://www.salary.com/research/salary/hiring/ui-artist-salary" },
  { name: "ZipRecruiter", url: "https://www.ziprecruiter.com/Salaries/UI-Artist-Salary" }
];

const responsibilities = [
  "Design menus, HUDs, inventory systems, and other UI elements that are visually appealing, easy to navigate, and enhance the overall player experience.",
  "Adapt UI layouts and interactions for various devices like consoles, PCs, mobile phones, and VR headsets, ensuring a smooth and enjoyable experience across platforms.",
  "Analyze gameplay mechanics and player behavior to design UI elements that support intuitive interaction, minimize cognitive load, and maximize player engagement.",
  "Work closely with game designers and programmers to translate gameplay concepts into functional and visually appealing UI elements, ensuring seamless integration with the game's mechanics.",
  "Proficiently utilize tools to create high-quality UI mockups, prototypes, and final assets.",
  "Maintain a cohesive visual language across all UI elements, aligning with the game's overall art style and theme to create a unified and immersive experience.",
  "Develop interactive prototypes and conduct user testing to gather feedback, refine UI elements, and ensure optimal usability before final implementation.",
  "Design UI elements that are accessible to players with disabilities, incorporating features like colorblind-friendly palettes, alternative control schemes, and text-to-speech options."
];

const resources = [
  { name: "How to Become a UX Designer", url: "https://www.tealhq.com/how-to-become/ux-designer" },
  { name: "UI Goodies", url: "https://uigoodies.com/" },
  { name: "The Most Extensive UI/UX Design Resources You’ll Ever Need", url: "https://uxplanet.org/the-most-extensive-design-resources-library-youll-ever-need-in-2021-4151c1df5e8e" },
  { name: "A Beginner Friendly Resource Hub For UI/UX Design", url: "https://www.uxresourcehub.com/" },
  { name: "The Best UX design resources for 2024 by UXTweak", url: "https://blog.uxtweak.com/best-ux-resources/" },
  { name: "Game UX Resources for getting into the industry", url: "https://bootcamp.uxdesign.cc/game-ux-resources-for-getting-into-the-industry-29350545017d" },
  { name: "UX/UI for Gaming Live Course by ELVTR", url: "https://elvtr.com/course/ux-ui-for-gaming" },
  { name: "UX/UI Challenges & Resources by UX/UI Open", url: "https://www.uxuiopen.com/design-resources/" },
  { name: "What Is Games ‘User Experience’ (UX) and How Does It Help?", url: "https://playerresearch.medium.com/what-is-games-user-experience-ux-and-how-does-it-help-ea35ceaa9f05" },
  { name: "What is Game UX? The Complete Guide for 2024", url: "https://careerfoundry.com/en/blog/ux-design/game-ux/" },
  { name: "Basic Guide to Game UX Design", url: "https://www.protopie.io/blog/game-ux-design" },
  { name: "How to become a UX Game Designer in Game Development?", url: "https://8bitplay.com/blog/how-to-become-a-ux-game-designer-in-game-development/" },
  { name: "Game UI Design: Everything You Need To Know", url: "https://careerfoundry.com/en/blog/ui-design/game-ui-design/" },
  { name: "UX Research Tools Map", url: "https://www.userinterviews.com/ux-research-tools-map-2022" },
  { name: "UX Research Resources, Crowdsourced by the Learners Community", url: "https://docs.google.com/document/d/1N1GFir0c73UIG7o9AW3JTqVnX_QFLAjOjpeMCTC3DYE/edit#heading=h.s6sto2t7gaex" },
  { name: "Table of Contents — UX Knowledge Base by Krisztina Szerovay", url: "https://uxknowledgebase.com/table-of-contents-4d24ed5114ac" },
  { name: "Game UI Database", url: "https://gameuidatabase.com/" }
];

const books = [
  { name: "The Gamer's Brain: How Neuroscience and UX Can Impact Video Game Design by Celia Hodent", url: "https://www.amazon.com/Gamers-Brain-Neuroscience-Impact-Design/dp/1498775500" },
  { name: "Game Design Workshop: A Playcentric Approach to Creating Innovative Games by Tracy Fullerton", url: "https://www.amazon.com/Game-Design-Workshop-Playcentric-Innovative/dp/1138098779" },
  { name: "Game Feel by Steve Swink", url: "https://www.amazon.com/Game-Feel-Designers-Sensation-Kaufmann/dp/0123743281/" },
  { name: "Game Usability by Noah Schaffer and Katherine Isbister", url: "https://www.amazon.com/gp/product/B0092J077G" },
  { name: "Don't Make Me Think, Revisited: A Common Sense Approach to Web Usability by Steve Krug", url: "https://www.amazon.co.uk/Dont-Make-Think-Revisited-Usability/dp/0321965515" },
  { name: "Hooked: How to Build Habit-Forming Products by Nir Eyal", url: "https://www.amazon.com/Hooked-How-Build-Habit-Forming-Products/dp/1591847788" },
  { name: "What UX is Really About: Introducing a Mindset for Great Experiences by Celia Hodent", url: "https://www.amazon.com/What-Really-About-Celia-Hodent/dp/1032104449" },
  { name: "The Design Studio Method: Creative Problem Solving with UX Sketching 1st Edition by Brian Sullivan", url: "https://www.amazon.com/Design-Studio-Method-Creative-Sketching/dp/113802256X/" },
  { name: "Bottlenecks: Aligning UX Design with User Psychology by David C. Evans", url: "https://www.amazon.com/Bottlenecks-Aligning-Design-User-Psychology/dp/1484225791" },
  { name: "The Secret Science of Games by John Hopson", url: "https://www.amazon.com/The-Secret-Science-of-Games/dp/B0C3T6PSBS/" },
  { name: "The Design Of Everyday Things by Don Norman", url: "https://www.amazon.com/Design-Everyday-Things-Revised-Expanded/dp/0465050654" }
];

const tools = [
  "Game Engines",
  "Substance Designer",
  "ZBrush",
  "Marmoset Toolbag",
  "After Effects",
  "Unreal MotionGraph",
  "Blender",
  "Maya",
  "Photoshop",
  "Illustrator",
  "Quixel Megascans",
  "Substance Painter",
  "Proto.io",
  "Figma",
  "UXPin"
];

const sidebarRoles = [
  { name: "3D Modeling Artist", slug: "3d-modeling-artist", current: false },
  { name: "Concept Artist", slug: "concept-artist", current: false },
  { name: "Character Artist", slug: "character-artist", current: false },
  { name: "Environment Artist", slug: "environment-artist", current: false },
  { name: "Graphics Programmer", slug: "graphics-programmer", current: false },
  { name: "Lighting Artist", slug: "lighting-artist", current: false },
  { name: "Storyboard Artist", slug: "storyboard-artist", current: false },
  { name: "Texture Artist", slug: "texture-artist", current: false },
  { name: "Technical Artist", slug: "technical-artist", current: false },
  { name: "VFX Artist", slug: "vfx-artist", current: false },
  { name: "UX/UI Artist", slug: "ux-ui-artist", current: true }
];
---

<BaseLayout title="UX/UI Artist" activeNav="career-guide">
  <WikiLayout title="UX/UI Artist" activeNav="career-guide" activeSidebar="roles">
    <div class="career-layout">
      <aside class="career-sidebar">
        <h3>Art Roles</h3>
        {sidebarRoles.map((r) => (
          r.current ? (
            <div class="card" style="padding: 0.75rem; margin-bottom: 0.5rem; border-left: 3px solid var(--color-pink);">
              <strong style="font-size: 0.9rem; color: var(--color-pink);">{r.name}</strong>
            </div>
          ) : (
            <a href={`${base}career-guide/roles/art/${r.slug}/`} class="card" style="padding: 0.75rem; margin-bottom: 0.5rem; text-decoration: none; display: block;">
              <strong style="font-size: 0.9rem;">{r.name}</strong>
            </a>
          )
        ))}
        <div style="margin-top: 1rem;">
          <a href={`${base}career-guide/roles/art/`} class="btn btn-gold" style="font-size: 0.8rem; padding: 0.4rem 0.8rem;">&larr; Art</a>
        </div>
      </aside>

      <div class="career-main">
        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>About this Role</h2>
          <p>UX/UI artists, the wizards behind the scenes of your favorite websites and apps, wield powerful magic: the magic of crafting seamless, intuitive, and visually captivating user experiences. They blend science and art, understanding user psychology and then crafting interfaces that feel both intuitive and delightful. They delve into the minds of users, understanding their needs, desires, and pain points, then translate those insights into interfaces that feel like a warm handshake, guiding you through your digital journey with effortless grace.</p>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Salary Resources</h2>
          <div style="display: flex; flex-wrap: wrap; gap: 0.75rem;">
            {salaries.map((s) => (
              <a href={s.url} target="_blank" rel="noopener noreferrer" class="btn btn-blue" style="font-size: 0.85rem;">
                {s.name} &rarr;
              </a>
            ))}
          </div>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Key Responsibilities</h2>
          <ul>
            {responsibilities.map((r) => (
              <li>{r}</li>
            ))}
          </ul>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Learning Resources</h2>
          <ul>
            {resources.map((r) => (
              <li><a href={r.url} target="_blank" rel="noopener noreferrer">{r.name}</a></li>
            ))}
          </ul>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Recommended Books</h2>
          <ul>
            {books.map((b) => (
              <li><a href={b.url} target="_blank" rel="noopener noreferrer">{b.name}</a></li>
            ))}
          </ul>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Tools to Learn</h2>
          <div class="callout callout-info">
            <p>You don&#39;t need to learn all of these — they are some of the more common tools for this role.</p>
          </div>
          <div style="display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.75rem;">
            {tools.map((t) => (
              <span style="background: var(--color-bg); border: 1px solid var(--color-dark); border-radius: 4px; padding: 0.3rem 0.6rem; font-size: 0.85rem;">{t}</span>
            ))}
          </div>
        </div>
      </div>

      <aside class="career-sidebar">
        <h3>Quick Links</h3>
        <div class="card" style="padding: 1rem; margin-bottom: 0.75rem;">
          <strong>📋 Job Boards</strong>
          <p style="font-size: 0.85rem; margin-top: 0.35rem;">
            <a href={`${base}career-guide/job-boards/`}>Browse job boards &rarr;</a>
          </p>
        </div>
        <div class="card" style="padding: 1rem; margin-bottom: 0.75rem;">
          <strong>📚 Resources</strong>
          <p style="font-size: 0.85rem; margin-top: 0.35rem;">
            <a href={`${base}career-guide/resources/`}>Career resources &rarr;</a>
          </p>
        </div>
        <div class="card" style="padding: 1rem;">
          <strong>🎯 All Roles</strong>
          <p style="font-size: 0.85rem; margin-top: 0.35rem;">
            <a href={`${base}career-guide/roles/`}>View all disciplines &rarr;</a>
          </p>
        </div>
      </aside>
    </div>
  </WikiLayout>
</BaseLayout>