---
import BaseLayout from "../../../../../layouts/BaseLayout.astro";
import WikiLayout from "../../../../../layouts/WikiLayout.astro";
const base = import.meta.env.BASE_URL;

const salaries = [
  { name: "InGameJob", url: "https://ingamejob.com/en/salaries" },
  { name: "Glassdoor", url: "https://www.glassdoor.com/Salaries/environment-artist-salary-SRCH_KO0,18.htm" },
  { name: "Salary.com", url: "https://www.salary.com/research/salary/posting/environment-artist-salary" },
  { name: "ZipRecruiter", url: "https://www.ziprecruiter.com/Salaries/Game-Environment-Artist-Salary" }
];

const responsibilities = [
  "Collaborate with the art director and level designers to understand the game's vision and concept.",
  "Design and create immersive and visually stunning game environments, including landscapes, buildings, and props.",
  "Use artistic skills to create textures, colors, lighting, and composition to enhance the visual appeal of the game world.",
  "Implement 3D modeling and texturing techniques to bring the environment designs to life.",
  "Optimize game environments for performance and technical limitations of the game platform.",
  "Work with game engines and software tools to implement and integrate environment assets into the game.",
  "Create and place vegetation, foliage, and other natural elements to enhance realism and immersion.",
  "Collaborate with other artists and team members to ensure a cohesive and consistent art style throughout the game."
];

const resources = [
  { name: "Transforming Virtual Environments: The Craft Of Environmental Design by SearchMyExpert", url: "https://www.searchmyexpert.com/resources/game-development/environmental-design-games" },
  { name: "Environment Artist Fundamentals by Experience Points", url: "https://www.exp-points.com/environment-artist-fundamentals" },
  { name: "Environment Art Articles by 80Level", url: "https://80.lv/articles/environment-art/" },
  { name: "Environment Art by Riot Games", url: "https://www.riotgames.com/en/artedu/environment-art" },
  { name: "A Complete Guide on Environment Concept Art by Argentics", url: "https://www.argentics.io/a-complete-guide-on-environment-concept-art" },
  { name: "Advanced Skill Sets for Environment Art by Epic Online Learning", url: "https://dev.epicgames.com/community/learning/courses/Qwa/unreal-engine-advanced-skill-sets-for-environment-art/ReZm/unreal-engine-advanced-skill-sets-for-environment-art-introduction" },
  { name: "Lessons in Environment Art Production by 80Level", url: "https://medium.com/@EightyLevel/lessons-in-environment-art-production-e6fe9432f780" },
  { name: "Environment Art Mastery by Gumroad", url: "https://thiagoklafke.gumroad.com/l/environmentartmastery" },
  { name: "What does an environment artist do? by CGSpectrum", url: "https://www.cgspectrum.com/career-pathways/environment-artist" },
  { name: "3D Environment Modeling Courses by Udemy", url: "https://www.udemy.com/topic/environment-modeling/" },
  { name: "Environment Art Course by Onyx Academy", url: "https://onyx-academy.com/courses/environment" },
  { name: "3D Environment Arts Track by CGMA", url: "https://www.gameart.cgmasteracademy.com/programs/5-3d-environment-arts-track" },
  { name: "Into Games’ Junior Environment Artist Database", url: "https://entrylevel.games/database/junior-environment-artist" },
  { name: "Mastered’s 3D Artist Bootcamp", url: "https://join.mastered.com/skillsbootcamp" }
];

const books = [
  { name: "Fantasy World-Building: A Guide to Developing Mythic Worlds and Legendary Creatures by Mark Nelson", url: "https://www.amazon.com/Creative-World-Building-Creature-Design/dp/0486828654/ref=sr_1_1" },
  { name: "How to Read the Landscape by Patrick Whitefield", url: "https://www.amazon.com/How-Read-Landscape-Patrick-Whitefield/dp/1856231852/ref=sr_1_1" },
  { name: "Language of Landscape by Anne Whiston Spirn", url: "https://www.amazon.com/Language-Landscape-Professor-Whiston-Spirn/dp/0300082940/ref=sr_1_2" },
  { name: "Light for Visual Artists: Understanding & Using Light in Art & Design by Richard Yot", url: "https://www.amazon.com/Light-Visual-Artists-Second-Understanding/dp/1786274515/ref=sr_1_1" },
  { name: "Color and Light: A Guide for the Realist Painter by James Gurney", url: "https://www.amazon.com/Color-Light-Realist-Painter-Gurney/dp/0740797719/ref=sr_1_1" },
  { name: "Atlas Of Middle-Earth by Karen Wynn Fonstad", url: "https://www.amazon.com/Atlas-Middle-Earth-Revised-Karen-Fonstad/dp/0618126996/ref=sr_1_5" },
  { name: "Drawing Basics and Video Game Art: Classic to Cutting-Edge Art Techniques for Winning Video Game Design by Chris Solarski", url: "https://www.amazon.in/Drawing-Basics-Video-Game-Art/dp/0823098478" }
];

const tools = [
  "Game Engines",
  "Adobe Photoshop",
  "ZBrush",
  "Maya",
  "Substance 3D Painter",
  "Substance 3D Designer",
  "Houdini",
  "SpeedTree",
  "World Machine",
  "Terragen",
  "Quixel Mixer",
  "Marmoset Toolbag",
  "xNormal",
  "PureRef",
  "PhotoScan",
  "Git",
  "Aseprite",
  "Procreate",
  "Clip Studio Paint"
];

const sidebarRoles = [
  { name: "3D Modeling Artist", slug: "3d-modeling-artist", current: false },
  { name: "Concept Artist", slug: "concept-artist", current: false },
  { name: "Character Artist", slug: "character-artist", current: false },
  { name: "Environment Artist", slug: "environment-artist", current: true },
  { name: "Graphics Programmer", slug: "graphics-programmer", current: false },
  { name: "Lighting Artist", slug: "lighting-artist", current: false },
  { name: "Storyboard Artist", slug: "storyboard-artist", current: false },
  { name: "Texture Artist", slug: "texture-artist", current: false },
  { name: "Technical Artist", slug: "technical-artist", current: false },
  { name: "VFX Artist", slug: "vfx-artist", current: false },
  { name: "UX/UI Artist", slug: "ux-ui-artist", current: false }
];
---

<BaseLayout title="Environment Artist" activeNav="career-guide">
  <WikiLayout title="Environment Artist" activeNav="career-guide" activeSidebar="roles">
    <div class="career-layout">
      <aside class="career-sidebar">
        <h3>Art Roles</h3>
        {sidebarRoles.map((r) => (
          r.current ? (
            <div class="card" style="padding: 0.75rem; margin-bottom: 0.5rem; border-left: 3px solid var(--clr-pink);">
              <strong style="font-size: 0.9rem; color: var(--clr-pink);">{r.name}</strong>
            </div>
          ) : (
            <a href={`${base}career-guide/roles/art/${r.slug}/`} class="card" style="padding: 0.75rem; margin-bottom: 0.5rem; text-decoration: none; display: block;">
              <strong style="font-size: 0.9rem;">{r.name}</strong>
            </a>
          )
        ))}
        <div style="margin-top: 1rem;">
          <a href={`${base}career-guide/roles/art/`} class="btn btn-gold" style="font-size: 0.8rem; padding: 0.4rem 0.8rem;">&larr; Art</a>
        </div>
      </aside>

      <div class="career-main">
        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>About this Role</h2>
          <p>An Environment Artist in the game industry is responsible for designing and creating the worlds that players explore. They collaborate with the art director and level designers to understand the game's vision and use their artistic skills to design landscapes, buildings, props, and more. They also implement their creations using 3D modeling and texturing tools, considering technical limitations and performance requirements to ensure a visually stunning and optimized game environment.</p>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Salary Resources</h2>
          <div style="display: flex; flex-wrap: wrap; gap: 0.75rem;">
            {salaries.map((s) => (
              <a href={s.url} target="_blank" rel="noopener noreferrer" class="btn btn-blue" style="font-size: 0.85rem;">
                {s.name} &rarr;
              </a>
            ))}
          </div>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Key Responsibilities</h2>
          <ul>
            {responsibilities.map((r) => (
              <li>{r}</li>
            ))}
          </ul>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Learning Resources</h2>
          <ul>
            {resources.map((r) => (
              <li><a href={r.url} target="_blank" rel="noopener noreferrer">{r.name}</a></li>
            ))}
          </ul>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Recommended Books</h2>
          <ul>
            {books.map((b) => (
              <li><a href={b.url} target="_blank" rel="noopener noreferrer">{b.name}</a></li>
            ))}
          </ul>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Tools to Learn</h2>
          <div class="callout callout-info">
            <p>You don&#39;t need to learn all of these — they are some of the more common tools for this role.</p>
          </div>
          <div style="display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.75rem;">
            {tools.map((t) => (
              <span style="background: var(--clr-bg); border: 1px solid var(--clr-dark); border-radius: 4px; padding: 0.3rem 0.6rem; font-size: 0.85rem;">{t}</span>
            ))}
          </div>
        </div>
      </div>

      <aside class="career-sidebar">
        <h3>Quick Links</h3>
        <div class="card" style="padding: 1rem; margin-bottom: 0.75rem;">
          <strong>📋 Job Boards</strong>
          <p style="font-size: 0.85rem; margin-top: 0.35rem;">
            <a href={`${base}career-guide/job-boards/`}>Browse job boards &rarr;</a>
          </p>
        </div>
        <div class="card" style="padding: 1rem; margin-bottom: 0.75rem;">
          <strong>📚 Resources</strong>
          <p style="font-size: 0.85rem; margin-top: 0.35rem;">
            <a href={`${base}career-guide/resources/`}>Career resources &rarr;</a>
          </p>
        </div>
        <div class="card" style="padding: 1rem;">
          <strong>🎯 All Roles</strong>
          <p style="font-size: 0.85rem; margin-top: 0.35rem;">
            <a href={`${base}career-guide/roles/`}>View all disciplines &rarr;</a>
          </p>
        </div>
      </aside>
    </div>
  </WikiLayout>
</BaseLayout>