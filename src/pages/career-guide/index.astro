---
import BaseLayout from "../../layouts/BaseLayout.astro";
import WikiLayout from "../../layouts/WikiLayout.astro";
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Career Guide" activeNav="career-guide">
  <WikiLayout title="Career Guide" activeNav="career-guide">
    <p>
      Your comprehensive guide to building a career in the game industry.
      Explore roles across every discipline, find job boards, and access
      curated resources to level up your professional journey.
    </p>

    <div class="card-grid">
      <a href={`${base}career-guide/roles/`} class="card" style="text-decoration:none;">
        <div class="card-icon">🎭</div>
        <h3>Roles</h3>
        <p>Discover game development roles across Animation, Art, Audio, Design, Production, Programming, QA, and more.</p>
      </a>

      <a href={`${base}career-guide/job-boards/`} class="card" style="text-decoration:none;">
        <div class="card-icon">📋</div>
        <h3>Job Boards</h3>
        <p>Curated list of job boards and career platforms specializing in game industry positions.</p>
      </a>

      <a href={`${base}career-guide/resources/`} class="card" style="text-decoration:none;">
        <div class="card-icon">📚</div>
        <h3>Resource List</h3>
        <p>Books, courses, communities, and tools to help you prepare for and advance your gamedev career.</p>
      </a>
    </div>
  </WikiLayout>
</BaseLayout>
