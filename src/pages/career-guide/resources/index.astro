  { name: "Example Portfolios by Vertical", url: "https://drive.google.com/file/d/1ja5Wv41Dre3fcStjAXbJ0jI5yIRHPFsz/view" },
  { name: "How to Make a Game Industry Portfolio", url: "https://www.youtube.com/watch?v=-MC7DUV4vRY&ab_channel=IndieGameAcademy" },
  { name: "Jean Leggett's Portfolio Advice", url: "https://docs.google.com/document/d/1ZTxfI83KUp3YCT7zB9xCfxnGpBEMxzS-amwhQYYpzHo/edit" },
