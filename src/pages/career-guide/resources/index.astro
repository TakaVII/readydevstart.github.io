  { name: "Alex Gombos", tags: "Hiring, Job Hunting", url: "https://www.linkedin.com/in/alexgombos/" },
  { name: "Amir Satvat", tags: "Community Support, Job Hunting", url: "https://www.linkedin.com/in/amirsatvat" },
  { name: "Arin Goldsmith", tags: "Career Advice, Community Support, Job Hunting", url: "https://www.linkedin.com/in/arin-goldsmith" },
  { name: "Aïda Figuerola", tags: "Career Advice, Community Support", url: "https://www.linkedin.com/in/afiguerola/" },
  { name: "Ben Kvalo", tags: "Business, Community Support, Hiring", url: "https://www.linkedin.com/in/benkvalo/" },
  { name: "Chris Tran", tags: "Career Advice, Community Support", url: "https://www.linkedin.com/in/chrisltran/" },
