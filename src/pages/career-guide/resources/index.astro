  { name: "Jen Donahoe", tags: "Business, Marketing", url: "https://www.linkedin.com/in/jenniferdonahoe" },
  { name: "Jon Wolheim", tags: "Career Advice, Community Support, Programming", url: "https://www.linkedin.com/in/jonwolheim/" },
  { name: "Jordan Mazer", tags: "Business, Career Advice, Community Support", url: "https://www.linkedin.com/in/jordanmazer/" },
  { name: "Marie Ablaza", tags: "Career Advice, Community Support, Hiring", url: "https://www.linkedin.com/in/mariebenigno/" },
  { name: "Matt Barney", tags: "Career Advice, Hiring, Job Hunting", url: "https://www.linkedin.com/in/the-matt-barney/" },
  { name: "Pauliina Tornqvist", tags: "Career Advice, Community Support, Production", url: "https://www.linkedin.com/in/pauliinatornqvist/" },
  { name: "Pebbles Klein", tags: "Community Support, Marketing", url: "https://www.linkedin.com/in/pebbleslozano" },
  { name: "Sara Machado", tags: "Career Advice, Hiring, Job Hunting", url: "https://www.linkedin.com/in/scmachadouk/" },
  { name: "Sarah Bond", tags: "Community Support", url: "https://www.linkedin.com/in/sarahrbond/" },
  { name: "Sergei Vasiuk", tags: "Business, Career Advice", url: "https://www.linkedin.com/in/sergeivasjuk/" },
  { name: "Tim Wood", tags: "Career Advice, Hiring, Job Hunting", url: "https://www.linkedin.com/in/timwood4134" },
  { name: "Willem Delventhal", tags: "Business, Career Advice, Game Design", url: "https://www.linkedin.com/in/ifyouwillem" },
];

const youtubeChannels = [
  { name: "Brackeys", tags: "Game Design, Programming, Tutorials, Unity", url: "https://www.youtube.com/@Brackeys" },
  { name: "Code Monkey", tags: "Programming, Tutorials, Unity", url: "https://www.youtube.com/@CodeMonkeyUnity" },
  { name: "Game Dev Guide", tags: "Animation, Programming, Tutorials, Unity", url: "https://www.youtube.com/@GameDevGuide" },
  { name: "Game Maker's Toolkit", tags: "Game Design, Narrative Design, Production", url: "https://www.youtube.com/@GMTK" },
  { name: "One Wheel Studio", tags: "Art, Game Design, Programming, Unity", url: "https://www.youtube.com/@OneWheelStudio" },
  { name: "quill18creates", tags: "Game Design, Godot, Programming, Unity", url: "https://www.youtube.com/@quill18creates" },
  { name: "Visual Novel Design", tags: "Narrative Design, Tutorials", url: "https://www.youtube.com/@vimi" },
];

const discordCommunities = [
  { name: "Indie Game Academy", tags: "Career Guidance, Courses, Community", url: "https://discord.gg/aZ49q7Hux7" },
  { name: "Game Dev Network", tags: "Career Guidance, Job Hunting, Community", url: "https://discord.gg/gdn" },
  { name: "Game Dev League", tags: "Career Guidance, Job Hunting, Projects", url: "https://discord.gg/gamedev" },
  { name: "Funsmith Club", tags: "Career Guidance, Community, Projects", url: "https://discord.gg/ZDVpZ38j5T" },
  { name: "GameDevDrinkUp", tags: "Community, IRL Meetings", url: "https://discord.com/invite/bR3UxD2S" },
  { name: "r/Gamedev", tags: "Career Guidance, Job Hunting, Community", url: "https://discord.gg/reddit-gamedev" },
];
---

<BaseLayout title="Resource List" activeNav="career-guide">
  <WikiLayout title="Career Resource List" activeNav="career-guide" activeSidebar="resources">
    <p>
      A compilation of free resources useful for every discipline within the
      game industry — from general advice to networking tips to portfolio best practices.
    </p>

    <div class="career-layout">
      <aside class="career-sidebar">
        <h3>Sections</h3>
        <div class="card" style="padding: 0.75rem; margin-bottom: 0.5rem;">
          <a href="#general" style="font-size: 0.85rem;">📚 General Resources</a>
        </div>
        <div class="card" style="padding: 0.75rem; margin-bottom: 0.5rem;">
          <a href="#networking" style="font-size: 0.85rem;">👥 Networking</a>
        </div>
        <div class="card" style="padding: 0.75rem; margin-bottom: 0.5rem;">
          <a href="#mentorships" style="font-size: 0.85rem;">🫂 Mentorships</a>
        </div>
        <div class="card" style="padding: 0.75rem; margin-bottom: 0.5rem;">
          <a href="#portfolio" style="font-size: 0.85rem;">📄 Portfolio</a>
        </div>
        <div class="card" style="padding: 0.75rem; margin-bottom: 0.5rem;">
          <a href="#career-advice" style="font-size: 0.85rem;">🎓 Career Advice</a>
        </div>
        <div class="card" style="padding: 0.75rem; margin-bottom: 0.5rem;">
          <a href="#job-hunting" style="font-size: 0.85rem;">📡 Job Hunting</a>
        </div>
        <div class="card" style="padding: 0.75rem; margin-bottom: 0.5rem;">
          <a href="#people" style="font-size: 0.85rem;">👤 Industry People</a>
        </div>
        <div class="card" style="padding: 0.75rem; margin-bottom: 0.5rem;">
          <a href="#youtube" style="font-size: 0.85rem;">🎬 YouTube Channels</a>
        </div>
        <div class="card" style="padding: 0.75rem; margin-bottom: 0.5rem;">
          <a href="#discord" style="font-size: 0.85rem;">💬 Discord Communities</a>
        </div>
        <div style="margin-top: 1rem;">
          <a href={`${base}career-guide/`} class="btn btn-gold" style="font-size: 0.8rem; padding: 0.4rem 0.8rem;">&larr; Career Guide</a>
        </div>
      </aside>

      <div class="career-main">
        <h2 id="general">📚 General Resources</h2>
        <div class="card" style="margin-bottom: 1.5rem;">
          <ul>
            {generalResources.map((r) => (
              <li><a href={r.url} target="_blank" rel="noopener noreferrer">{r.name}</a></li>
            ))}
          </ul>
        </div>

        <h2 id="networking">👥 Networking</h2>
        <div class="card" style="margin-bottom: 1.5rem;">
          <ul>
            {networkingResources.map((r) => (
              <li><a href={r.url} target="_blank" rel="noopener noreferrer">{r.name}</a></li>
            ))}
          </ul>
        </div>

        <h2 id="mentorships">🫂 Mentorships</h2>
        <div class="card" style="margin-bottom: 1.5rem;">
          <ul>
            {mentorshipResources.map((r) => (
              <li><a href={r.url} target="_blank" rel="noopener noreferrer">{r.name}</a></li>
            ))}
          </ul>
        </div>

        <h2 id="portfolio">📄 Portfolio Resources</h2>
        <div class="card" style="margin-bottom: 1.5rem;">
          <ul>
            {portfolioResources.map((r) => (
              <li><a href={r.url} target="_blank" rel="noopener noreferrer">{r.name}</a></li>
            ))}
          </ul>
        </div>

        <h2 id="career-advice">🎓 Career Advice</h2>
        <div class="card" style="margin-bottom: 1.5rem;">
          <ul>
            {careerAdviceResources.map((r) => (
              <li><a href={r.url} target="_blank" rel="noopener noreferrer">{r.name}</a></li>
            ))}
          </ul>
        </div>

        <h2 id="job-hunting">📡 Job Hunting</h2>
        <div class="card" style="margin-bottom: 1.5rem;">
          <ul>
            {jobHuntingResources.map((r) => (
              <li><a href={r.url} target="_blank" rel="noopener noreferrer">{r.name}</a></li>
            ))}
          </ul>
        </div>

        <h2 id="people">👤 Industry People to Follow</h2>
        <p style="margin-bottom: 1rem;">Industry professionals who share career advice, job leads, and community support on LinkedIn.</p>
        <div class="card-grid" style="grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));">
          {industryPeople.map((p) => (
            <a href={p.url} target="_blank" rel="noopener noreferrer" class="card" style="text-decoration:none; padding: 1rem;">
              <strong>{p.name}</strong>
              <p style="font-size: 0.8rem; margin-top: 0.35rem; color: var(--color-dark); opacity: 0.75;">{p.tags}</p>
            </a>
          ))}
        </div>

        <h2 id="youtube" style="margin-top: 2rem;">🎬 Gamedev YouTube Channels</h2>
        <p style="margin-bottom: 1rem;">Free video tutorials and design analysis channels perfect for self-learners.</p>
        <div class="card-grid" style="grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));">
          {youtubeChannels.map((c) => (
            <a href={c.url} target="_blank" rel="noopener noreferrer" class="card" style="text-decoration:none; padding: 1rem;">
              <strong>{c.name}</strong>
              <p style="font-size: 0.8rem; margin-top: 0.35rem; color: var(--color-dark); opacity: 0.75;">{c.tags}</p>
            </a>
          ))}
        </div>

        <h2 id="discord" style="margin-top: 2rem;">💬 Discord Communities</h2>
        <p style="margin-bottom: 1rem;">Active Discord servers for game developers to connect, collaborate, and find opportunities.</p>
        <div class="card-grid" style="grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));">
          {discordCommunities.map((c) => (
            <a href={c.url} target="_blank" rel="noopener noreferrer" class="card" style="text-decoration:none; padding: 1rem;">
              <strong>{c.name}</strong>
              <p style="font-size: 0.8rem; margin-top: 0.35rem; color: var(--color-dark); opacity: 0.75;">{c.tags}</p>
            </a>
          ))}
        </div>
      </div>

      <aside class="career-sidebar">
        <h3>Quick Links</h3>
        <div class="card" style="padding: 1rem; margin-bottom: 0.75rem;">
          <strong>🎭 Browse Roles</strong>
          <p style="font-size: 0.85rem; margin-top: 0.35rem;">
            <a href={`${base}career-guide/roles/`}>Explore all disciplines &rarr;</a>
          </p>
        </div>
        <div class="card" style="padding: 1rem; margin-bottom: 0.75rem;">
          <strong>💼 Ready to Apply?</strong>
          <p style="font-size: 0.85rem; margin-top: 0.35rem;">
            <a href={`${base}career-guide/job-boards/`}>Browse job boards &rarr;</a>
          </p>
        </div>
        <div class="card" style="padding: 1rem;">
          <strong>🎮 Pro Tip</strong>
          <p style="font-size: 0.85rem; margin-top: 0.35rem;">
            The best career resource is a finished project. Join a game jam to build your portfolio fast.
          </p>
        </div>
      </aside>
    </div>
  </WikiLayout>
</BaseLayout>
