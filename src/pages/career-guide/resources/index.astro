  { name: "Justin Williams' Job Search Tips", url: "https://www.linkedin.com/posts/justinalanwilliams_this-will-be-my-last-post-in-2023-as-i-start-activity-7143608575582494722-gnGo" },
  { name: "JD's Game Job List", url: "https://docs.google.com/document/d/1CU1H-8ZQWUPIBrT3VaUjjSMpOrarfpfhI86q8Bkpr_8/edit" },
  { name: "Hadidjah Chamberlin's Job Hunting Resources and Tips", url: "https://www.hadidjah.com/job-hunting" },
  { name: "Hadidjah Chamberlin's Interview Questions and Tips", url: "https://www.hadidjah.com/interview-questions-and-tips" },
  { name: "Jean Leggett's Salary and Negotiation Advice", url: "https://docs.google.com/document/d/1rqW5F5B5UDSGnx5U2JOXg4phfJNMEuONI91zOl0IoDM/edit" },
  { name: "ScreenSkills' How to Get a Good Interview", url: "https://www.screenskills.com/your-career/lesson-plans-and-classroom-resources/how-to-get-a-good-interview/" },
  { name: "Mock Interview Guide by Alex Gombos", url: "https://www.dropbox.com/scl/fi/0div2e841ixzjimdwrz6j/Interview-Prep-Pack-2024.pdf?rlkey=sbb88b48m0tu2e8e0gu90jbsl&dl=0" },
  { name: "Cover Letter Template", url: "https://docs.google.com/document/d/13Vd7Nb1Luf4Tr0ROKz8j65hDa2CLzfs5RFEVtYl0ddc/edit?usp=sharing" },
];

