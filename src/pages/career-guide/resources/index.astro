const careerAdviceResources = [
  { name: "Tips to Help You Break Into the Game Industry", url: "https://blog.indiegameacademy.com/educational-content/three-tips-to-help-you-break-into-the-game-industry/" },
  { name: "The Ultimate Guide to Kickstarting Your Career In Games by Pauliina Tornqvist", url: "https://www.linkedin.com/pulse/ultimate-guide-kickstarting-your-career-games-pauliina-tornqvist/" },
  { name: "ScreenSkills' Games Industry Career Map", url: "https://www.screenskills.com/media/4379/games-a2-current-inclusivity-web.pdf" },
  { name: "How to Get Into the Game Industry by Sam Willis", url: "https://insider.dbsinstitute.ac.uk/how-to-get-into-the-gaming-industry-our-ultimate-guide-with-advice-from-the-pros" },
  { name: "Expert Advice for Scoring a Career in Gaming", url: "https://joinhandshake.com/blog/students/how-to-work-in-gaming/" },
  { name: "Respawn: A Guide to Career Transitions", url: "https://www.linkedin.com/pulse/respawn-guide-career-transitions-sabrina-meditz-pcccc" },
