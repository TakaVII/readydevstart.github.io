import BaseLayout from "../../../layouts/BaseLayout.astro";
import WikiLayout from "../../../layouts/WikiLayout.astro";
---

<BaseLayout title="Your First Game" activeNav="quest-logs">
  <WikiLayout title="Your First Game" activeNav="quest-logs" activeSidebar="your-first-game">
    <div class="callout callout-info">
      <strong>⏱️ Estimated Time:</strong> 1–2 weekends. By the end you'll have a playable game you can share with friends.
    </div>

    <h2>The Golden Rule: Finish It</h2>
    <p>
      Your first game doesn't need to be good — it needs to be <strong>done</strong>. A finished
      Pong clone teaches you more than an unfinished MMORPG ever will.
    </p>

    <h2>Choosing Your Project</h2>
    <p>Pick one of these beginner-friendly scopes:</p>
    <ul>
      <li><strong>Pong / Breakout</strong> — Learn input handling, physics, scoring.</li>
      <li><strong>Platformer (1 level)</strong> — Learn tile maps, character controllers, level design.</li>
      <li><strong>Top-down Shooter</strong> — Learn projectiles, enemies, collision.</li>
      <li><strong>Visual Novel / Quiz</strong> — Learn UI systems, branching logic, text display.</li>
    </ul>

    <h2>Development Checklist</h2>
    <ol>
      <li><strong>Concept</strong> — One sentence describing your game.</li>
      <li><strong>Core Mechanic</strong> — Get the main action working (movement, shooting, etc.).</li>
      <li><strong>Minimum Loop</strong> — Add a win/lose condition.</li>
      <li><strong>Juice</strong> — Screen shake, particles, sound effects, animation polish.</li>
      <li><strong>Build &amp; Share</strong> — Export and upload to <a href="https://itch.io" target="_blank" rel="noopener noreferrer">itch.io</a>.</li>
    </ol>

    <h2>Common Pitfalls</h2>
    <table>
      <thead>
        <tr><th>Pitfall</th><th>Solution</th></tr>
      </thead>
      <tbody>
        <tr><td>Spending weeks on art before gameplay works</td><td>Use placeholder shapes first — "programmer art" is fine</td></tr>
        <tr><td>Never showing your game to anyone</td><td>Share early and often — feedback is fuel</td></tr>
        <tr><td>Rewriting the engine instead of making content</td><td>Use your engine's built-in features; fight the urge to over-engineer</td></tr>
      </tbody>
    </table>

    <div class="callout callout-tip">
      <strong>💡 Pro Tip:</strong> When you're "done," add one more thing: a main menu with a Play button and a Quit button. It makes your game feel 10× more polished.
    </div>
  </WikiLayout>
</BaseLayout>
