---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import WikiLayout from "../../../layouts/WikiLayout.astro";
const base = import.meta.env.BASE_URL;

const engines = [
  { name: "Unity", desc: "A popular, flexible engine used for 2D, 3D, and mobile games using C#.", url: "https://unity.com/download" },
  { name: "Unreal Engine", desc: "A high-end engine known for photorealistic 3D graphics and visual programming via Blueprints.", url: "https://www.unrealengine.com/download" },
  { name: "Godot Engine", desc: "A free, open-source engine that is lightweight and great for 2D and 3D games using GDScript or C#.", url: "https://godotengine.org/download/" },
  { name: "GameMaker", desc: "A beginner-friendly 2D engine that uses drag-and-drop blocks and its own programming language, GML.", url: "https://gamemaker.io/download" },
  { name: "Construct 3", desc: "A powerful browser-based 2D game engine designed to create games without traditional coding.", url: "https://www.construct.net/" },
  { name: "RPG Maker", desc: "A specialized, tile-based software suite built specifically for making classic top-down role-playing games.", url: "https://www.rpgmakerweb.com/" },
  { name: "Defold", desc: "A free, lightweight, Lua-based engine built for cross-platform 2D and 3D development [5].", url: "https://defold.com/download/" },
  { name: "CryEngine", desc: "A 3D engine designed for large environments, detailed lighting, and high-fidelity visual production.", url: "https://www.cryengine.com/" },
  { name: "Open 3D Engine (O3DE)", desc: "An open-source, modular 3D engine maintained by the Linux Foundation.", url: "https://o3de.org/download/" },
  { name: "Phaser", desc: "A fast, free JavaScript framework used to make HTML5 2D games for web browsers.", url: "https://phaser.io/download" },
  { name: "Cocos Creator", desc: "A cross-platform 2D and 3D game engine designed primarily for mobile titles and browser apps.", url: "https://www.cocos.com/creator-download" },
  { name: "Stencyl", desc: "A visual, block-based development environment optimized for making 2D grid and platform games without code.", url: "https://www.stencyl.com/download/" },
  { name: "GDevelop", desc: "An easy-to-learn, open-source 2D game engine that uses visual events to control game logic.", url: "https://gdevelop.io/download" },
  { name: "Ren'Py", desc: "A specialized open-source engine made for building visual novels and interactive digital stories.", url: "https://www.renpy.org/latest.html" },
  { name: "Flax Engine", desc: "A modern, lightweight 3D engine built for fast performance using C++ and C# scripts.", url: "https://flaxengine.com/download/" },
  { name: "Bevy", desc: "A modern, data-driven game engine built in the Rust programming language.", url: "https://bevyengine.org/" },
  { name: "Raylib", desc: "A simple programming framework designed to help beginners build code-only games in C.", url: "https://www.raylib.com/" },
  { name: "MonoGame", desc: "A code-focused C# framework that gives developers low-level control over their game loop and rendering.", url: "https://monogame.net/" },
  { name: "PICO-8", desc: "A fantasy retro console that limits screen resolution, colors, and audio channels to spark creative arcade builds.", url: "https://www.lexaloffle.com/pico-8.php" },
  { name: "Solar2D", desc: "A free, Lua-based cross-platform engine optimized for mobile and desktop 2D applications.", url: "https://solar2d.com/" },
  { name: "Babylon.js", desc: "A complete JavaScript framework built to render interactive 3D graphics directly inside web browsers.", url: "https://www.babylonjs.com/" },
];
---

<BaseLayout title="Getting Started: Understanding the Landscape" activeNav="quest-logs">
  <WikiLayout title="Getting Started: Understanding the Landscape" activeNav="quest-logs" activeSidebar="getting-started">
    <div class="callout callout-info">
      <strong>⏱️ Step 1 of 4:</strong> Before diving into game engines and code, it helps to see how the video game industry works, what roles exist, and what commercial reality looks like for indie developers.
    </div>

    <h2>Core Development Roles</h2>
    <p>Creating a game requires several distinct disciplines:</p>
    <ul>
      <li><strong>Programming:</strong> Writing the code that moves characters, calculates physics, handles button presses, and runs artificial intelligence. (Explore our <a href={`${base}career-guide/roles/programming/`}>Programming Guide</a>)</li>
      <li><strong>Game Design:</strong> Defining rules, challenge levels, control layouts, and core systems. (Explore our <a href={`${base}career-guide/roles/design/`}>Design Guide</a>)</li>
      <li><strong>Visual Art:</strong> Creating 2D character sprites, 3D models, user interfaces, lighting, and environmental props. (Explore our <a href={`${base}career-guide/roles/art/`}>Art Guide</a>)</li>
      <li><strong>Audio Engineering:</strong> Writing background music tracks, recording sound effects, and balancing spatial audio. (Explore our <a href={`${base}career-guide/roles/audio/`}>Audio Guide</a>)</li>
      <li><strong>Production:</strong> Managing schedules, setting project goals, keeping the team organized, and tracking tasks. (Explore our <a href={`${base}career-guide/roles/production/`}>Production Guide</a>)</li>
      <li><strong>Quality Assurance (QA):</strong> Testing game builds repeatedly to discover bugs, break mechanics, and report errors before launch. (Explore our <a href={`${base}career-guide/roles/qa/`}>QA Guide</a>)</li>
    </ul>

    <h2>Realistic Industry Success Metrics</h2>
    <p>
      Understanding industry data helps set real-world expectations. The global indie game market was valued at $4.85 billion in 2025, reaching $5.54 billion in 2026, and is projected to hit $10.83 billion by 2031
    <p>
      Indie games made up 99% of all Steam releases in 2024 and captured 48% of total platform sales revenue. However, revenue distribution is top-heavy, meaning a small group of smash hit games earns most of the total money, while thousands of smaller games earn much less.
    </p>

    <!-- Table 1: Market Metrics -->
    <div class="table-wrapper">
      <table>
        <thead>
          <tr>
            <th>Market Metric</th>
            <th>Value</th>
            <th>Industry Context</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><strong>Global Indie Market (2026)</strong></td>
            <td>$5.54 Billion</td>
            <td>Total projected value across PC, mobile, and console</td>
          </tr>
          <tr>
            <td><strong>Annual Steam Indie Releases (2025)</strong></td>
            <td>20,017 Games</td>
            <td>Roughly 55 new indie titles launched per day</td>
          </tr>
          <tr>
            <td><strong>Median Lifetime Gross Revenue</strong></td>
            <td>$5,000 – $15,000</td>
            <td>The middle earning point for catalog games on Steam</td>
          </tr>
          <tr>
            <td><strong>Developer Take-Home Pay</strong></td>
            <td>$3,500 – $10,500</td>
            <td>Earnings left after Steam's 30% platform cut</td>
          </tr>
