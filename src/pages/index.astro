---
import BaseLayout from "../layouts/BaseLayout.astro";
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Home" activeNav="home">
  <!-- ===== Hero Banner ===== -->
  <section class="hero">
    <h1>Ready. Dev. Start!</h1>
    <p>
      Your launchpad to game development mastery. Learn the fundamentals, grab
      studio-ready templates, and level up from aspiring creator to indie studio
      founder.
    </p>
    <div class="cta-group">
      <a href={`${base}quest-logs/getting-started/`} class="btn btn-pink">Start Your Quest</a>
      <a href={`${base}equipment/game-engines/`} class="btn btn-gold">Browse Equipment</a>
      <a href={`${base}blueprints/studio-template/`} class="btn btn-blue">Get Blueprints</a>
    </div>

    <!-- Quick Search Bar in Hero -->
    <div class="hero-search-wrapper" style="margin-top: 2rem; display: flex; justify-content: center;">
      <button onclick="document.getElementById('searchTrigger')?.click()" class="hero-search-btn" style="display: flex; align-items: center; gap: 0.75rem; background: #161622; border: 1px solid #363650; color: #a0a0b8; padding: 0.75rem 1.5rem; border-radius: 30px; font-size: 0.95rem; cursor: pointer; transition: all 0.2s ease; width: 100%; max-width: 520px; box-shadow: 0 4px 20px rgba(0,0,0,0.5);">
        <svg viewBox="0 0 24 24" width="20" height="20" stroke="#f3d73e" stroke-width="2" fill="none">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <span>Search 50+ guides, tools, blueprints & career roles...</span>
        <kbd style="background: #0c0c12; border: 1px solid #3d3d58; padding: 0.2rem 0.5rem; border-radius: 4px; font-size: 0.75rem; color: #f3d73e; margin-left: auto;">⌘K</kbd>
      </button>
    </div>
  </section>

  <!-- ===== Featured Sections ===== -->
  <div class="main-area" style="flex-direction: column; padding: 2rem;">
    <main class="content" style="max-width: 100%; padding: 0;">
      <h2>Choose Your Path</h2>
      <div class="card-grid">
        <a href={`${base}quest-logs/`} class="card" style="text-decoration:none;">
          <div class="card-icon">🗺️</div>
          <h3>Quest Logs</h3>
          <p>Step-by-step guides covering game development fundamentals — from your very first prototype to publishing on storefronts.</p>
        </a>

        <a href={`${base}equipment/`} class="card" style="text-decoration:none;">
          <div class="card-icon">⚔️</div>
          <h3>Equipment</h3>
          <p>Curated tools and software for every stage of development: engines, art suites, audio workstations, and project management.</p>
        </a>

        <a href={`${base}blueprints/`} class="card" style="text-decoration:none;">
          <div class="card-icon">📐</div>
          <h3>Blueprints</h3>
          <p>Production-ready templates for studio setup, game design documents, pitch decks, and more — just fill in and ship.</p>
        </a>

        <a href={`${base}career-guide/`} class="card" style="text-decoration:none;">
          <div class="card-icon">🎯</div>
          <h3>Career Guide</h3>
          <p>Explore gamedev career roles, browse industry job boards, and access resources to launch your professional journey.</p>
        </a>
      </div>

      <div class="callout callout-info" style="margin-top: 2rem;">
        <strong>🎯 New here?</strong> Start with the
        <a href={`${base}quest-logs/getting-started/`}>Getting Started</a> guide — it takes
        about 10 minutes and sets you up with everything you need.
      </div>
    </main>
  </div>
</BaseLayout>
