---
import BaseLayout from "../../layouts/BaseLayout.astro";
import WikiLayout from "../../layouts/WikiLayout.astro";
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Blueprints" activeNav="blueprints">
  <WikiLayout title="Blueprints" activeNav="blueprints">
    <p>
      Ready-made templates and frameworks to jumpstart your indie studio. Download,
      customize, and ship — no need to start from a blank page.
    </p>

    <div class="card-grid">
      <a href={`${base}blueprints/studio-template/`} class="card" style="text-decoration:none;">
        <div class="card-icon">🏗️</div>
        <h3>Studio Template</h3>
        <p>A complete indie studio setup guide covering legal, branding, team roles, and operational workflows.</p>
      </a>

      <a href={`${base}blueprints/game-design-doc/`} class="card" style="text-decoration:none;">
        <div class="card-icon">📝</div>
        <h3>Game Design Document</h3>
        <p>A structured GDD template that covers vision, mechanics, narrative, art direction, and technical specs.</p>
      </a>

      <a href={`${base}blueprints/one-pager/`} class="card" style="text-decoration:none;">
        <div class="card-icon">📄</div>
        <h3>One Pager Design Doc</h3>
        <p>A one-page summary of your game's vision — perfect for quick pitches to team members, investors, and publishers.</p>
      </a>

      <a href={`${base}blueprints/pitch-deck/`} class="card" style="text-decoration:none;">
        <div class="card-icon">📊</div>
        <h3>Pitch Deck</h3>
        <p>Present your game to publishers, investors, or your team with this proven slide framework.</p>
      </a>

      <a href={`${base}blueprints/press-kit/`} class="card" style="text-decoration:none;">
        <div class="card-icon">📰</div>
        <h3>Press Kit &amp; Press Release</h3>
        <p>Get media coverage with a professional press kit guide and a ready-to-use press release template.</p>
      </a>
    </div>
  </WikiLayout>
</BaseLayout>
