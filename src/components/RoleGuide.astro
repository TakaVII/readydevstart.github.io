---
import { roleGuides } from "../data/roleGuides";

export interface Props {
  /** Role slug, a key of `roleGuides`. */
  slug: string;
  /** "guide" renders how-to/skills/portfolio (place it near the top); "faq" renders the FAQ and its schema (place it last). */
  part: "guide" | "faq";
}

const { part } = Astro.props;
const guide = roleGuides[Astro.props.slug];
if (!guide) throw new Error(`No role guide for "${Astro.props.slug}"`);

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: guide.faqs.map((f) => ({
    "@type": "Question",
    name: f.question,
    acceptedAnswer: { "@type": "Answer", text: f.answer },
  })),
};
---

{part === "guide" && <>
<div class="card" style="margin-bottom: 1.5rem;">
  <h2 id="how-to-become">How to Become a {guide.name}</h2>
  <ol>
    {guide.steps.map((s) => (
      <li style="margin-bottom: 0.6rem;"><strong>{s.title}.</strong>{" "}{s.body}</li>
    ))}
  </ol>
</div>

<div class="card" style="margin-bottom: 1.5rem;">
  <h2 id="skills">Key Skills for a {guide.name}</h2>
  <ul>
    {guide.skills.map((s) => (
      <li><strong>{s.title}:</strong>{" "}{s.body}</li>
    ))}
  </ul>
</div>

<div class="card" style="margin-bottom: 1.5rem;">
  <h2 id="portfolio">{guide.portfolioTitle ?? `${guide.name} Portfolio Tips`}</h2>
  <div class="callout callout-tip">
    <p>{guide.portfolioIntro ?? "Studios hire on your portfolio first. Here's what reviewers look for."}</p>
  </div>
  <ul>
    {guide.portfolio.map((p) => (
      <li>{p}</li>
    ))}
  </ul>
</div>
</>}

{part === "faq" && <>
<div class="card" style="margin-bottom: 1.5rem;">
  <h2 id="faq">Frequently Asked Questions</h2>
  {guide.faqs.map((f) => (
    <div style="margin-bottom: 1rem;">
      <h3 style="font-size: 1.05rem; margin-bottom: 0.35rem;">{f.question}</h3>
      <p>{f.answer}</p>
    </div>
  ))}
</div>

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</>}
