---
import HeadScripts from "../components/HeadScripts.astro";
import BodyScripts from "../components/BodyScripts.astro";

export interface Props {
  title: string;
  description?: string;
  activeNav?: string;
}

const {
  title,
  description = "Ready Dev Start — Your launchpad to game development mastery.",
  activeNav = "",
} = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} | Ready Dev Start</title>
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <meta property="og:image" content={`${Astro.site}/assets/Logo_IGA.png`} />
    <meta property="og:site_name" content="Ready Dev Start" />
    <HeadScripts />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <BodyScripts />
    <div class="site-wrapper">
      <!-- ===== Header / Navigation ===== -->
      <header class="site-header">
        <a href={base} class="logo"><img src={`${base}assets/Logo_IGA.png`} alt="Ready Dev Start logo" class="logo-img" /></a>
        <nav id="mainNav">
          <a href={base} class:list={[{ active: activeNav === "home" }]}>Home</a>
          <a href={`${base}quest-logs/`} class:list={[{ active: activeNav === "quest-logs" }]}>Quest Logs</a>
          <a href={`${base}equipment/`} class:list={[{ active: activeNav === "equipment" }]}>Equipment</a>
          <a href={`${base}blueprints/`} class:list={[{ active: activeNav === "blueprints" }]}>Blueprints</a>
          <a href={`${base}career-guide/`} class:list={[{ active: activeNav === "career-guide" }]}>Career Guide</a>
          <a href={`${base}about/`} class:list={[{ active: activeNav === "about" }]}>About</a>
        </nav>
        <button class="menu-toggle" id="menuToggle" aria-label="Toggle navigation menu" aria-expanded="false" aria-controls="mainNav">☰</button>
      </header>

      <!-- ===== Page Content ===== -->
      <slot />

      <!-- ===== Footer ===== -->
      <footer class="site-footer">
        <p>
          &copy; {new Date().getFullYear()} <a href={base}>Ready Dev Start</a>.
          Built with ♥ for aspiring game creators.
        </p>
        <p class="footer-links">
          <a href="https://discord.gg/9FR7g72bxj" target="_blank" rel="noopener noreferrer">Discord</a>
          <a href="https://www.linkedin.com/company/indie-game-academy" target="_blank" rel="noopener noreferrer">LinkedIn</a>
          <a href="https://www.instagram.com/indiegameacademy" target="_blank" rel="noopener noreferrer">Instagram</a>
          <a href="https://bsky.app/profile/indiegameacademy.com" target="_blank" rel="noopener noreferrer">Bluesky</a>
          <a href="https://www.youtube.com/channel/UCbdYhWH4Sh71tqeAMNfzlVQ" target="_blank" rel="noopener noreferrer">YouTube</a>
          <a href="https://tr.ee/LwqloRs-lA" target="_blank" rel="noopener noreferrer">Podcast</a>
        </p>
      </footer>
    </div>

    <script>
      const toggle = document.getElementById("menuToggle");
      const nav = document.getElementById("mainNav");
      const sidebar = document.querySelector(".sidebar");

      // Mobile hamburger → header nav toggle
      if (toggle && nav) {
        toggle.addEventListener("click", () => {
          const isNavOpen = nav.classList.toggle("open");
          // Also toggle sidebar if present
          if (sidebar) {
            sidebar.classList.toggle("open", isNavOpen);
          }
          toggle.setAttribute("aria-expanded", String(isNavOpen));
        });
      }

      if (sidebar) {
        document.body.classList.add("has-sidebar");
      }
    </script>
  </body>
</html>

<style is:global>
  @import "../styles/global.css";
</style>
