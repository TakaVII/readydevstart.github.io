---
export interface Props {
  title: string;
  description?: string;
  activeNav?: string;
  activeSidebar?: string;
}

const {
  title,
  description,
  activeNav = "",
  activeSidebar = "",
} = Astro.props;
const base = import.meta.env.BASE_URL;
---

<style>
  /* WikiLayout-specific styles scoped here */
</style>

<div>
  <slot name="hero" />

  <div class="main-area">
    <!-- ===== Sidebar ===== -->
    <aside class="sidebar" id="sidebar">
      <h3>🗺️ Quest Logs</h3>
      <ul>
        <li><a href={`${base}quest-logs/getting-started/`} class:list={[{ active: activeSidebar === "getting-started" }]}>Getting Started</a></li>
        <li><a href={`${base}quest-logs/game-design-101/`} class:list={[{ active: activeSidebar === "game-design-101" }]}>Game Design 101</a></li>
        <li><a href={`${base}quest-logs/your-first-game/`} class:list={[{ active: activeSidebar === "your-first-game" }]}>Your First Game</a></li>
        <li><a href={`${base}quest-logs/publishing-guide/`} class:list={[{ active: activeSidebar === "publishing-guide" }]}>Publishing Guide</a></li>
      </ul>

      <h3>⚔️ Equipment</h3>
      <ul>
        <li><a href={`${base}equipment/game-engines/`} class:list={[{ active: activeSidebar === "game-engines" }]}>Game Engines</a></li>
        <li><a href={`${base}equipment/art-tools/`} class:list={[{ active: activeSidebar === "art-tools" }]}>Art &amp; Design Tools</a></li>
        <li><a href={`${base}equipment/audio-tools/`} class:list={[{ active: activeSidebar === "audio-tools" }]}>Audio Tools</a></li>
        <li><a href={`${base}equipment/project-management/`} class:list={[{ active: activeSidebar === "project-management" }]}>Project Management</a></li>
      </ul>

      <h3>📐 Blueprints</h3>
      <ul>
        <li><a href={`${base}blueprints/studio-template/`} class:list={[{ active: activeSidebar === "studio-template" }]}>Studio Template</a></li>
        <li><a href={`${base}blueprints/game-design-doc/`} class:list={[{ active: activeSidebar === "game-design-doc" }]}>Game Design Doc</a></li>
        <li><a href={`${base}blueprints/one-pager/`} class:list={[{ active: activeSidebar === "one-pager" }]}>One Pager</a></li>
        <li><a href={`${base}blueprints/pitch-deck/`} class:list={[{ active: activeSidebar === "pitch-deck" }]}>Pitch Deck</a></li>
        <li><a href={`${base}blueprints/press-kit/`} class:list={[{ active: activeSidebar === "press-kit" }]}>Press Kit</a></li>
      </ul>

      <h3>🎯 Career Guide</h3>
      <ul>
        <li><a href={`${base}career-guide/roles/`} class:list={[{ active: activeSidebar === "roles" }]}>Roles</a></li>
        <li><a href={`${base}career-guide/job-boards/`} class:list={[{ active: activeSidebar === "job-boards" }]}>Job Boards</a></li>
        <li><a href={`${base}career-guide/resources/`} class:list={[{ active: activeSidebar === "resources" }]}>Resource List</a></li>
      </ul>
    </aside>

    <!-- ===== Main Content ===== -->
    <main class="content">
      <h1>{title}</h1>
      <slot />
    </main>
  </div>
</div>
